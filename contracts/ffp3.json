{
  "id": "ffp3",
  "label": "Aquaponie (FFP3)",
  "firmwareId": "ffp5cs",
  "sensor": "ffp3",
  "auth": "hmac",
  "endpoints": {
    "postData": "/post-data",
    "heartbeat": "/heartbeat",
    "outputsState": "/api/outputs/state",
    "otaReport": "/ota-report"
  },
  "pages": {
    "suivi": "/aquaponie",
    "controle": "/aquaponie-control",
    "description": "/aquaponie-description"
  },
  "tables": {
    "data": "ffp3Data",
    "outputs": "ffp3Outputs",
    "heartbeat": "ffp3Heartbeat"
  },
  "fields": [
    {"name": "sensor", "type": "string", "direction": "tx"},
    {"name": "version", "type": "string", "direction": "tx"},
    {"name": "TempAir", "type": "float", "direction": "tx"},
    {"name": "Humidite", "type": "float", "direction": "tx"},
    {"name": "TempEau", "type": "float", "direction": "tx"},
    {"name": "EauPotager", "type": "float", "direction": "tx"},
    {"name": "EauAquarium", "type": "float", "direction": "tx"},
    {"name": "EauReserve", "type": "float", "direction": "tx"},
    {"name": "diffMaree", "type": "float", "direction": "tx"},
    {"name": "Luminosite", "type": "float", "direction": "tx"},
    {"name": "etatPompeAqua", "type": "int", "direction": "both"},
    {"name": "etatPompeTank", "type": "int", "direction": "both"},
    {"name": "etatHeat", "type": "int", "direction": "both"},
    {"name": "etatUV", "type": "int", "direction": "both"},
    {"name": "bouffeMatin", "type": "int", "direction": "both"},
    {"name": "bouffeMidi", "type": "int", "direction": "both"},
    {"name": "bouffePetits", "type": "int", "direction": "both"},
    {"name": "bouffeGros", "type": "int", "direction": "both"},
    {"name": "aqThreshold", "type": "int", "direction": "both"},
    {"name": "tankThreshold", "type": "int", "direction": "both"},
    {"name": "chauffageThreshold", "type": "float", "direction": "both"},
    {"name": "mail", "type": "string", "direction": "both"},
    {"name": "mailNotif", "type": "string", "direction": "both"},
    {"name": "resetMode", "type": "int", "direction": "both"},
    {"name": "bouffeSoir", "type": "int", "direction": "both"},
    {"name": "tempsGros", "type": "int", "direction": "both"},
    {"name": "tempsPetits", "type": "int", "direction": "both"},
    {"name": "tempsRemplissageSec", "type": "int", "direction": "both"},
    {"name": "limFlood", "type": "int", "direction": "both"},
    {"name": "WakeUp", "type": "int", "direction": "both"},
    {"name": "FreqWakeUp", "type": "int", "direction": "both"},
    {"name": "configSynced", "type": "int", "direction": "tx"},
    {"name": "Pression", "type": "float", "direction": "tx"},
    {"name": "post_id", "type": "string", "direction": "tx"},
    {"name": "tideEvent", "type": "string", "direction": "tx"},
    {"name": "tideTrend", "type": "int", "direction": "tx"},
    {"name": "tideNoiseMm", "type": "int", "direction": "tx"},
    {"name": "tideWindowMs", "type": "int", "direction": "tx"},
    {"name": "tideExtremeMm", "type": "int", "direction": "tx"},
    {"name": "wlAquaDiag", "type": "string", "direction": "tx"},
    {"name": "wlPotaDiag", "type": "string", "direction": "tx"}
  ],
  "gpio": {
    "2": "etatHeat",
    "15": "etatUV",
    "16": "etatPompeAqua",
    "18": "etatPompeTank",
    "100": "mail",
    "101": "mailNotif",
    "102": "aqThreshold",
    "103": "tankThreshold",
    "104": "chauffageThreshold",
    "105": "bouffeMatin",
    "106": "bouffeMidi",
    "107": "bouffeSoir",
    "108": "bouffePetits",
    "109": "bouffeGros",
    "110": "resetMode",
    "111": "tempsGros",
    "112": "tempsPetits",
    "113": "tempsRemplissageSec",
    "114": "limFlood",
    "115": "WakeUp",
    "116": "FreqWakeUp",
    "118": "angleReposGros",
    "119": "angleDistribGros",
    "120": "angleInterGros",
    "121": "angleReposPetits",
    "122": "angleDistribPetits",
    "123": "angleInterPetits"
  },
  "serverSource": {
    "postDataController": "src/Controller/Ffp3/PostDataController.php",
    "gpioMapClass": "App\\Config\\Ffp3GpioMap",
    "gpioMapMethod": "gpioToProperty"
  },
  "heartbeatFields": [
    {"name": "uptime", "type": "int", "direction": "tx", "required": true},
    {"name": "free", "type": "int", "direction": "tx", "required": true},
    {"name": "min", "type": "int", "direction": "tx", "required": true},
    {"name": "reboots", "type": "int", "direction": "tx", "required": true},
    {"name": "crc", "type": "string", "direction": "tx", "required": true, "note": "CRC32B de uptime=&free=&min=&reboots="},
    {"name": "ip", "type": "string", "direction": "tx", "required": false},
    {"name": "rssi", "type": "int", "direction": "tx", "required": false, "since": "ffp5cs 15.34", "column": "rssi"},
    {"name": "version", "type": "string", "direction": "tx", "required": false, "since": "ffp5cs 15.34", "column": "version"},
    {"name": "rst", "type": "string", "direction": "tx", "required": false, "since": "15.34 / 4.76 / 2.79", "column": "resetReason", "note": "POWERON|SW|PANIC|INT_WDT|TASK_WDT|WDT|DEEPSLEEP|BROWNOUT|SDIO|OTHER"},
    {"name": "part", "type": "string", "direction": "tx", "required": false, "since": "15.34 / 4.76 / 2.79", "column": "partition"},
    {"name": "ota", "type": "string", "direction": "tx", "required": false, "since": "15.34 / 4.76 / 2.79", "column": "otaState", "note": "valid|pending|new|invalid|aborted|undefined"},
    {"name": "fails", "type": "int", "direction": "tx", "required": false, "since": "15.34 / 4.76 / 2.79", "column": "failedBoots"},
    {"name": "safe", "type": "int", "direction": "tx", "required": false, "since": "15.34 / 4.76 / 2.79", "column": "safeMode"},
    {"name": "clk", "type": "int", "direction": "tx", "required": false, "since": "15.34 / 4.76 / 2.79", "column": "clockOffsetS", "note": "horloge firmware − serveur (s), mesuré sur X-Server-Ts"},
    {"name": "wifi_ms", "type": "int", "direction": "tx", "required": false, "since": "15.34 / 4.76 / 2.79", "column": "wifiConnectMs"},
    {"name": "wifi_tries", "type": "int", "direction": "tx", "required": false, "since": "15.34 / 4.76 / 2.79", "column": "wifiAttempts"},
    {"name": "board", "type": "string", "direction": "tx", "required": false, "since": "15.34 / 4.76 / 2.79", "note": "identifiant de carte = en-tête X-Ota-Board"},
    {"name": "boot", "type": "int", "direction": "tx", "required": false, "since": "15.34 / 4.76 / 2.79", "note": "1 sur le premier heartbeat après boot → device_events(boot)"},
    {"name": "log", "type": "string", "direction": "tx", "required": false, "since": "15.34 / 4.76 / 2.79", "note": "JSON compact [{q,t,u,e,d}] : journal de bord → device_events(heartbeat_log)"}
  ],
  "otaReport": {
    "auth": "hmac_required",
    "note": "Signature obligatoire (X-Sig-* ou timestamp+signature), aucun repli api_key. Réponse JSON {status, acked[], stored, server_ts} + en-têtes Date / X-Server-Ts.",
    "fields": [
      {"name": "board", "type": "string", "direction": "tx", "required": false},
      {"name": "version", "type": "string", "direction": "tx", "required": false},
      {"name": "uptime", "type": "int", "direction": "tx", "required": false},
      {"name": "src", "type": "string", "direction": "tx", "required": false, "note": "ota_report|heartbeat_log|boot"},
      {"name": "events", "type": "string", "direction": "tx", "required": true, "note": "JSON compact [{q:seq,t:epoch|0,u:uptime,e:check|start|progress|done|fail|rollback|marked_valid|...,d:detail}] ≤ 32"}
    ]
  },
  "serverTime": {
    "headers": [
      "Date",
      "X-Server-Ts"
    ],
    "note": "présents sur toute réponse de postData / heartbeat / otaReport, acceptée ou rejetée (recalage horloge firmware avant signature)"
  }
}

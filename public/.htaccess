<IfModule mod_rewrite.c>
    RewriteEngine On

    # Set the base path if your project is in a subdirectory
    # Example: if URL is http://example.com/myapp/, RewriteBase should be /myapp/
    RewriteBase /

    # Liens externes (GET) : redirection 301 /ffp3/* -> /* (nouveaux chemins)
    RewriteCond %{REQUEST_METHOD} GET
    RewriteRule ^ffp3/(.*)$ /$1 [R=301,L]
    # Firmware (POST) : reecriture interne sans redirection (conserver le corps de la requete)
    RewriteRule ^ffp3/(.*)$ $1 [L]

    # Forcer la route racine (/) à passer par index.php pour éviter l'affichage de l'arborescence
    RewriteRule ^$ index.php [L]

    # Redirect all requests to index.php if they are not an existing file or directory
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [L]
</IfModule>

# Désactiver l'affichage de l'arborescence des répertoires
# (placé après mod_rewrite pour éviter les conflits)
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ====================================================================
# Compression des reponses texte (HTML, CSS, JS, JSON, SVG).
# Reduit fortement la taille transferee (~70-80 % sur CSS/JS).
# Les fonts woff2 et images sont deja compressees -> exclues.
# ====================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml application/rss+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf
</IfModule>
# Brotli si disponible (meilleure compression que gzip), sinon ignore silencieusement.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript application/x-javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json application/manifest+json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/xml application/rss+xml
</IfModule>

# ====================================================================
# Cache navigateur des assets statiques (JS/CSS/images/fonts).
# Ces fichiers sont servis directement par Apache (RewriteCond !-f).
# Cache long + revalidation : invalidation au déploiement via le n° de version
# présent dans les URLs/templates. ETag/Last-Modified gérés nativement par Apache.
# ====================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    # N'appliquer le cache long qu'aux fichiers d'assets (pas au HTML applicatif).
    <FilesMatch "\.(js|css|png|jpe?g|webp|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# Bloquer l'execution de PHP / scripts dans les sous-dossiers assets et uploads.
# Toute requete *.php sous public/assets/ ou public/uploads/ retourne 403.
<IfModule mod_alias.c>
    RedirectMatch 403 ^/assets/.*\.(php|phtml|phar|py|sh|bat|ps1|pl)$
    RedirectMatch 403 ^/uploads/.*\.(php|phtml|phar|py|sh|bat|ps1|pl)$
</IfModule>

# Bloquer les fichiers sensibles (env, git, composer, etc.) meme si DocumentRoot pointe ailleurs.
<FilesMatch "^(\.env|\.env\..*|\.gitignore|\.gitmodules|composer\.json|composer\.lock|README\.md|CHANGELOG\.md|VERSION)$">
    Require all denied
</FilesMatch>

RewriteEngine On
Options -Indexes

# ====================================================================
# Bloquer l'acces aux repertoires et fichiers sensibles
# (AVANT les regles de routage pour ne pas servir les fichiers existants)
# ====================================================================
RewriteRule ^vendor/ - [F,L]
RewriteRule ^config/ - [F,L]
RewriteRule ^src/ - [F,L]
RewriteRule ^var/ - [F,L]
RewriteRule ^templates/ - [F,L]
RewriteRule ^composer\.(json|lock)$ - [F,L]
RewriteRule ^\.env - [F,L]
RewriteRule ^\.git - [F,L]

# Repertoires hors-web : scripts de maintenance, tests, schema, outillage.
# Le routeur en bas de fichier ne prend la main que sur les URL qui ne
# correspondent a AUCUN fichier existant (RewriteCond !-f) : sans ces regles,
# un GET /tools/xxx.php etait execute directement par Apache, hors de Slim et
# sans authentification (audit 2026-07, S11). Les scripts portent en plus une
# garde applicative (App\Util\CliGuard) — cf. tests/Security/CliOnlyScriptsTest.
RewriteRule ^tools/ - [F,L]
RewriteRule ^bin/ - [F,L]
RewriteRule ^tests/ - [F,L]
RewriteRule ^migrations/ - [F,L]
RewriteRule ^docker/ - [F,L]
RewriteRule ^docs/ - [F,L]
RewriteRule ^\.github/ - [F,L]
RewriteRule ^\.claude/ - [F,L]
RewriteRule ^\.cursor - [F,L]
RewriteRule ^run-cron\.php$ - [F,L]

# Fichiers de configuration / documentation a la racine (pas de contenu servi).
RewriteRule ^(phpunit\.xml(\.dist)?|phpstan.*\.neon|\.php-cs-fixer\.php)$ - [F,L]
RewriteRule ^docker-compose.*\.yml$ - [F,L]
RewriteRule ^(env\.test\.example|\.keep-env|\.gitattributes|\.gitmodules)$ - [F,L]
RewriteRule ^(README|CHANGELOG|CLAUDE)\.md$ - [F,L]
RewriteRule ^VERSION$ - [F,L]

# ====================================================================
# Headers de securite HTTP
# ====================================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ====================================================================
# Compression des reponses texte (HTML, CSS, JS, JSON, SVG).
# Reduit fortement la taille transferee (~70-80 % sur CSS/JS).
# Les fonts woff2 et images sont deja compressees -> exclues.
# ====================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml application/rss+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf
</IfModule>
# Brotli si disponible (meilleure compression que gzip), sinon ignore silencieusement.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript application/x-javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json application/manifest+json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/xml application/rss+xml
</IfModule>

# ====================================================================
# Cache navigateur des assets statiques (si DocumentRoot pointe sur la racine)
# ====================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|png|jpe?g|webp|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# ====================================================================
# Retrocompatibilite : anciennes URLs /ffp3/* -> routes racine
# GET : redirection 301 (navigateurs, liens)
# POST : rewrite interne (firmwares ESP32, corps de requete preserve)
# Exception GET : API device uploadphotoserver (JSON + X-Api-Key), pas de 301
# ====================================================================
# GET device API (firmware ESP32-CAM outputs_state) : rewrite interne comme POST
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{REQUEST_URI} uploadphotoserver-outputs-action\.php [NC]
RewriteRule ^ffp3/(.*)$ /$1 [L,DPI]
# /ffp3 et /ffp3/ -> / (explicite pour éviter 403)
RewriteCond %{REQUEST_METHOD} GET
RewriteRule ^ffp3/?$ / [R=301,L]
# /ffp3/xxx -> /xxx
RewriteCond %{REQUEST_METHOD} GET
RewriteRule ^ffp3/(.+)$ /$1 [R=301,L]
# POST : rewrite interne (firmwares ESP32)
RewriteCond %{REQUEST_METHOD} !GET
RewriteRule ^ffp3/(.*)$ /$1 [L,DPI]

# ====================================================================
# Redirections legacy FFP3 (anciennes URLs .php)
# ====================================================================
RewriteRule ^ffp3datas/(.*)$ $1 [R=301,L]
RewriteRule ^export-data\.php$ export-data [R=308,L]
RewriteRule ^ffp3-data\.php$ aquaponie [R=308,L]

# ====================================================================
# DirectoryIndex
# ====================================================================
DirectoryIndex index.php

# ====================================================================
# Router principal : toute requete non fichier/dossier -> public/index.php
# ====================================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ public/index.php [L]

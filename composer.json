{
    "name": "olution/n3-iot-server",
    "description": "Serveur IoT unifié n³ — salle aérée n³ (Slim 4)",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^2.9",
        "slim/slim": "^4.11",
        "slim/psr7": "^1.6",
        "twig/twig": "^3.0",
        "php-di/php-di": "^7.0",
        "minishlink/web-push": "^8.0",
        "bacon/bacon-qr-code": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.50",
        "roave/security-advisories": "dev-latest"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "license": "MIT",
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "scripts": {
        "test": "php tools/run-phpunit.php",
        "test:unit": "php tools/run-phpunit.php --testsuite Unit",
        "test:integration": "php tools/run-phpunit.php --testsuite Integration",
        "test:integration-http": "php tools/run-phpunit.php --testsuite Integration --filter OutputControlHttpIntegrationTest",
        "test:coverage": "php tools/run-phpunit.php --testsuite Unit --coverage-text --coverage-clover build/coverage.xml",
        "analyse": "phpstan analyse --memory-limit=512M",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "audit": "composer audit",
        "changelog:check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/changelog-maintenance.ps1 -CheckOnly",
        "changelog:rotate": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/changelog-maintenance.ps1 -Rotate"
    }
}

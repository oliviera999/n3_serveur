# Configuration PHPStan 2.x — serveur n3 IoT (Slim 4 / PHP 8.1+)
# Niveau 5 : compromis raisonnable pour un codebase existant.
# Augmenter progressivement (6 -> 8) au fil du nettoyage.
# Baseline (phpstan-baseline.neon) : 100 erreurs existantes, en majorité des faux
# positifs de scoping ($app/$applyAuth dans config/routes_*.php inclus depuis
# public/index.php). À résorber progressivement.

includes:
    - phpstan-baseline.neon

parameters:
    # Tolère les patterns d'ignore non déclenchés (évite l'échec selon la version de PHPStan).
    reportUnmatchedIgnoredErrors: false
    level: 6
    paths:
        - src
        - public/index.php
        - config
    excludePaths:
        - vendor/*
        - archives/*
        - analyse-ffp3/*
        - ameliorations-visuelles-iot-serveur/*
        - var/*
        - tests/Fixtures/*
        - tools/icons/*
    bootstrapFiles:
        - vendor/autoload.php
    # Ignorer les erreurs liées à l'API Monolog 2.x vs 3.x (passerelle helpers).
    ignoreErrors:
        - identifier: missingType.iterableValue
        - '#PHPDoc tag @param has invalid value#'
        # Constants opcache: extension non chargée en CLI
        - '#Function opcache_(get_status|get_configuration|reset) not found#'
    treatPhpDocTypesAsCertain: false

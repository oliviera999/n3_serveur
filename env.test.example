# Configuration minimale pour tests FFP3 en environnement TEST
#
# ⚠️ Fichier historique — la référence complète est `.env.example` à la racine du serveur.
# Usage : copier vers `.env` et ajuster (jamais versionner le `.env` réel).
#
# Tables TEST : ffp3Data2, ffp3Outputs2 (cf. TableConfig)

ENV=test
APP_TIMEZONE=Europe/Paris

# Auth firmware (aligner avec secrets firmware de test)
API_KEY=your_api_key_here
API_SIG_SECRET=your_hmac_secret_here
SIG_VALID_WINDOW=300
HMAC_STRICT_MODE=false
HMAC_NONCE_REQUIRED=false

# Base de données
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# Logs
LOG_FILE_PATH=cronlog.txt
LOG_LEVEL=INFO

# Notifications (smoke tests / intégration)
NOTIF_EMAIL_RECIPIENT=your_notification_email@example.com
MAIL_FROM="Test <noreply@example.local>"
NOTIF_MODE=important

# Auth admin pages (tests intégration HTTP)
AUTH_METHOD=both
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2y$12$generate_with_tools/generate_password_hash.php
ADMIN_TOKEN=generate_a_strong_random_token

# Notes
# 1. Voir `.env.example` pour la liste exhaustive des variables supportées
# 2. CACHE_ENABLED n'est plus lu par le runtime (réservé aux tests PHPUnit / CI)
# 3. Rotation API_KEY si exposée : docs/SECURITE_ROTATION_API_KEY.md

# Configuration FFP3 - Environnement TEST
# Date: 2025-10-15
# Usage: Copier vers .env et ajuster les valeurs

# ==========================================
# ENVIRONNEMENT
# ==========================================
# prod: utilise ffp3Data, ffp3Outputs
# test: utilise ffp3Data2, ffp3Outputs2
ENV=test

# ==========================================
# SÉCURITÉ
# ==========================================
# Clé API pour authentification ESP32 (placeholder — generer une vraie cle aleatoire)
API_KEY=your_api_key_here
# HMAC FFP5CS (optionnel : actif si timestamp+signature presents dans la requete)
API_SIG_SECRET=your_hmac_secret_here
SIG_VALID_WINDOW=300

# ==========================================
# BASE DE DONNÉES
# ==========================================
# Configuration MySQL/MariaDB
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# ==========================================
# LOGGING
# ==========================================
# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==========================================
# CACHE
# ==========================================
# Désactiver le cache en développement
CACHE_ENABLED=false

# ==========================================
# NOTES
# ==========================================
# 1. Copier ce fichier vers .env (jamais versionne) et remplacer les placeholders
# 2. Verifier que les tables TEST existent (ffp3Data2, ffp3Outputs2)
# 3. Pour PROD, changer ENV=prod
# 4. Ce .example ne doit JAMAIS contenir de secrets reels (cf. securite-et-secrets.mdc)
# 5. La cle API doit etre tournee si elle a ete exposee (cf. docs/SECURITE_ROTATION_API_KEY.md)

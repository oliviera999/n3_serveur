DB_HOST=localhost
DB_NAME=oliviera_iot
DB_USER=oliviera_iot
DB_PASS="Iot#Olution1"
API_KEY=fdGTMoptd5CD2ert3
ALERT_EMAIL=arnould.svt@gmail.com
NOTIF_EMAIL_RECIPIENT=oliv.arn.lau@gmail.com
MAIL_FROM="Aquaponie <arnould.svt@gmail.com>"
LOG_FILE_PATH=cronlog.txt
APP_TIMEZONE=Europe/Paris

# Environment: prod or test
# prod: utilise ffp3Data, ffp3Outputs
# test: utilise ffp3Data2, ffp3Outputs2
ENV=prod

# Seuils d'alerte
AQUA_LOW_LEVEL_THRESHOLD=7
TIDE_STDDEV_THRESHOLD=1

# Numéros GPIO (Raspberry Pi)
GPIO_POMPE_AQUA=16
GPIO_POMPE_TANK=18
GPIO_RESET_MODE=110

# Seuils de nettoyage (valeurs aberrantes)
CLEAN_MIN_TEMP_EAU=3
CLEAN_MAX_TEMP_EAU=50
CLEAN_MIN_TEMP_AIR=3
CLEAN_MIN_HUMIDITE=3
CLEAN_MIN_EAU_AQUARIUM=4
CLEAN_MAX_EAU_AQUARIUM=70
CLEAN_MIN_EAU_RESERVE=10
CLEAN_MAX_EAU_RESERVE=90

API_SIG_SECRET=changeMePlease
SIG_VALID_WINDOW=300

# ====================================================================
# Authentification - Pages d'administration
# ====================================================================
# Méthode d'authentification : 'session' (formulaire), 'token' (token simple), ou 'both' (les deux)
AUTH_METHOD=session

# Nom d'utilisateur pour l'authentification par session
ADMIN_USERNAME=admin

# Hash du mot de passe (généré avec password_hash PHP)
# Pour générer un hash, utiliser : php -r "echo password_hash('votre_mot_de_passe', PASSWORD_DEFAULT);"
# Exemple : ADMIN_PASSWORD_HASH=$2y$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi
ADMIN_PASSWORD_HASH=

# Token d'accès pour l'authentification par token (optionnel si AUTH_METHOD=token ou both)
# Générer un token aléatoire avec : php -r "echo bin2hex(random_bytes(32));"
ADMIN_TOKEN=
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Set the base path if your project is in a subdirectory
    # Example: if URL is http://example.com/myapp/, RewriteBase should be /myapp/
    RewriteBase /

    # Forcer la route racine (/) à passer par index.php pour éviter l'affichage de l'arborescence
    RewriteRule ^$ index.php [L]

    # Redirect all requests to index.php if they are not an existing file or directory
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [L]
</IfModule>

# Désactiver l'affichage de l'arborescence des répertoires
# (placé après mod_rewrite pour éviter les conflits)
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Autoriser l'accès en lecture aux fichiers de log pour le diagnostic sans SSH (comme cronlog.txt)
<Files "error_log">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule mod_headers.c>
        Header set Content-Type "text/plain; charset=utf-8"
    </IfModule>
</Files>
<Files "cronlog.txt">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule mod_headers.c>
        Header set Content-Type "text/plain; charset=utf-8"
    </IfModule>
</Files> 
ENV=prod
APP_TIMEZONE=Europe/Paris

# Base de donnees Docker locale
DB_HOST=db
DB_NAME=iot_n3_local
DB_USER=iot_n3_user
DB_PASS="iot_n3_pass"

# Auth API firmware / camera
API_KEY=local_api_key_change_me
API_SIG_SECRET=local_hmac_secret_change_me
SIG_VALID_WINDOW=300

# Auth pages admin
# Modes: session | token | both | none
AUTH_METHOD=token
ADMIN_USERNAME=admin
# AUTH_METHOD=token: hash non necessaire
ADMIN_TOKEN=local_admin_token_change_me

# Notifications / logs
ALERT_EMAIL=dev@example.local
NOTIF_EMAIL_RECIPIENT=dev@example.local
MAIL_FROM="n3 iot local <dev@example.local>"
LOG_FILE_PATH=cronlog.txt

# Seuils metier (EauAquarium = distance mm ; eau basse si > seuil)
AQUA_LOW_LEVEL_THRESHOLD=180
TIDE_STDDEV_THRESHOLD=1
GPIO_POMPE_AQUA=16
GPIO_POMPE_TANK=18
GPIO_RESET_MODE=110
# Niveaux d'eau en mm (comme en BDD)
CLEAN_MIN_TEMP_EAU=3
CLEAN_MAX_TEMP_EAU=50
CLEAN_MIN_TEMP_AIR=3
CLEAN_MIN_HUMIDITE=3
CLEAN_MIN_EAU_AQUARIUM=40
CLEAN_MAX_EAU_AQUARIUM=700
CLEAN_MIN_EAU_RESERVE=15
CLEAN_MAX_EAU_RESERVE=1000

# Token admin cache
ADMIN_CACHE_TOKEN=local_cache_token_change_me

# Galeries
GALLERY_MSP1_DIR=uploads/msp1
GALLERY_N3PP_DIR=uploads/n3pp
GALLERY_FFP3_DIR=uploads/ffp3

{#
    Page de suivi aquaponie FFP3 — shell générique monitoring_page + CSS aquaponie.
    Pilotée par Ffp3Catalog / presets (voir docs/DISPLAY_PRESETS.md).
#}
{% extends 'monitoring_page.twig' %}

{% block meta_description %}Niveaux d'eau, températures, marées et bilan hydrique d'une ferme aquaponique pédagogique, mesurés en temps réel.{% endblock %}

{% block page_css %}
    <link rel="stylesheet" href="{{ base_path }}/assets/css/aquaponie.css" />
{% endblock %}

{% block scripts %}
    {{ parent() }}
    {% if measure_count > 0 and chart_payload.tideChartId is defined %}
    <script src="{{ base_path }}/assets/js/aquaponie-tide-markers.js"></script>
    <script>
    (function () {
        // Marqueurs pleine mer / basse mer : ajoutés APRÈS la création (différée) des graphiques,
        // en fin de liste pour ne pas décaler les index de séries utilisés par le live.
        if (!window.n3LayoutCharts || !window.n3TideMarkers || !window.n3TideMarkers.buildSeries) return;
        var chartId = {{ chart_payload.tideChartId|json_encode(15)|raw }};
        var peaks = {{ chart_payload.tidePeaks|default([])|json_encode(15)|raw }};
        var troughs = {{ chart_payload.tideTroughs|default([])|json_encode(15)|raw }};
        window.n3LayoutCharts.onReady(function (charts) {
            var chart = charts[chartId];
            if (!chart) return;
            var series = window.n3TideMarkers.buildSeries(peaks, troughs);
            if (!series.length) return;
            series.forEach(function (s) { chart.addSeries(s, false); });
            chart.redraw();
        });
    })();
    </script>
    {% endif %}
{% endblock %}

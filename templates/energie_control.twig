{# Page de contrôle ENERGIE : éditeur de presets d'affichage (famille mesure seule, sans GPIO). #}
{% extends 'layout.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block head_css %}
    <link rel="stylesheet" href="{{ base_path }}/assets/css/control-styles.css" />
    <link rel="stylesheet" href="{{ base_path }}/assets/css/display-presets.css" />
{% endblock %}

{% block content %}
    <article class="post featured">
        <header class="control-main-header" style="margin-bottom:1.5rem">
            <div class="header-left">
                <h1><i class="fas fa-bolt"></i> Affichage — Banc énergie</h1>
                <p>Configurez les presets proposés sur la page de suivi (Simple, Étendu…). Aucune sortie GPIO pour cette famille.</p>
            </div>
        </header>
        {% include 'partials/_display_presets_editor.twig' %}
        <section class="quick-actions panel" style="margin-top:1.5rem">
            <h3><i class="fas fa-bolt"></i> Actions rapides</h3>
            <div class="quick-actions-grid">
                <a href="{{ base_path|default('') }}{{ display_presets.monitoring_url }}" class="quick-action-card"><i class="fas fa-chart-line"></i> Page de suivi</a>
                <a href="{{ base_path|default('') }}/" class="quick-action-card"><i class="fas fa-home"></i> Accueil</a>
            </div>
        </section>
    </article>
{% endblock %}

{% block footer %}
{% include 'partials/_footer.twig' %}
{% endblock %}

{% block scripts %}
    <script src="{{ base_path }}/assets/js/toast-notifications.js"></script>
    <script src="{{ base_path }}/assets/js/display-presets-editor.js" defer></script>
{% endblock %}

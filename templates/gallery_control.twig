{% extends 'partials/_control_base.twig' %}

{% block outputs_section %}
    <div id="params-gallery-container" data-aos="fade-up">
    <section class="controls-section">
        <div class="controls-group">
            <header>
                <h2><i class="fas fa-envelope"></i> Notifications</h2>
            </header>
            <div class="parameters-panel">
                {% include 'partials/_notification_policy.twig' with { mail_gpio: 102 } %}
            </div>
        </div>

        <div class="controls-group">
            <header>
                <h2><i class="fas fa-bed"></i> Réveil et sommeil</h2>
            </header>
            <div class="parameters-panel">
                <div class="parameters-grid">
                    <div class="parameter-item parameter-item-switch" title="Forcer une prise photo au prochain réveil, même hors créneau">
                        <span>Force wakeup (one-shot)</span>
                        <label class="modern-switch" title="Forcer le réveil">
                            <input type="checkbox" id="forceWakeUp" data-parameter-gpio="104" {{ params.forceWakeUp|default('0') == '1' ? 'checked' : '' }} role="switch" aria-label="Force wakeup" onchange="saveParamSwitch('forceWakeUp', this.checked, '1', '0')">
                            <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                        </label>
                        <span class="parameter-item-hint" id="forceWakeUp-hint">{{ params.forceWakeUp|default('0') == '1' ? 'Activé' : 'Désactivé' }}</span>
                    </div>

                    <label class="parameter-item" data-parameter-wrapper title="Durée du deep sleep (secondes)">
                        <span>Temps de sommeil (s)</span>
                        <input type="number" data-parameter="sleepTime" data-parameter-gpio="105" id="sleepTime" min="10" value="{{ params.sleepTime|default('600') }}">
                        <small class="save-indicator" data-save-indicator data-parameter="sleepTime" data-state="idle"></small>
                    </label>
                </div>
            </div>
        </div>

        <div class="controls-group">
            <header>
                <h2><i class="fas fa-power-off"></i> Maintenance</h2>
            </header>
            <div class="parameters-panel">
                <div class="parameters-grid">
                    <div class="parameter-item parameter-item-switch" title="Déclenche un redémarrage firmware au prochain cycle">
                        <span>Reset mode</span>
                        <label class="modern-switch" title="Reset mode">
                            <input type="checkbox" id="resetMode" data-parameter-gpio="106" {{ params.resetMode|default('0') == '1' ? 'checked' : '' }} role="switch" aria-label="Reset mode" onchange="saveParamSwitch('resetMode', this.checked, '1', '0')">
                            <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                        </label>
                        <span class="parameter-item-hint" id="resetMode-hint">{{ params.resetMode|default('0') == '1' ? 'Activé' : 'Désactivé' }}</span>
                    </div>
                </div>
            </div>
        </div>

        {% set s = sync_status|default({}) %}
        <div class="controls-group" id="sync-panel"
             data-sync-status-url="{{ base_path|default('') }}{{ sync_api_base|default('/gallery/' ~ gallery_slug ~ '/api/sync') }}/status">
            <header>
                <h2><i class="fas fa-cloud-arrow-up"></i> Transfert hors-ligne</h2>
            </header>
            <div class="parameters-panel">
                <p class="context-description">
                    Les photos sont stockées sur la carte SD de la caméra et envoyées au serveur dès le retour du WiFi.
                    Cet indicateur reflète la dernière session de synchronisation.
                </p>
                <div class="sync-indicator-row">
                    <span class="sync-conn-dot" data-sync-conn="{{ s.connection|default('offline') }}" id="sync-conn-dot"></span>
                    <span class="sync-conn-label" id="sync-conn-label">
                        {% set c = s.connection|default('offline') %}
                        {{ c == 'transferring' ? 'Transfert en cours…' : (c == 'online' ? 'Connectée' : 'Hors ligne') }}
                    </span>
                    <span class="sync-conn-meta" id="sync-conn-meta">{{ s.updated_at|default('') }}</span>
                </div>

                <div class="sync-gauge" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                     aria-valuenow="{{ s.percent|default(0) }}">
                    <div class="sync-gauge-track">
                        <div class="sync-gauge-fill" id="sync-gauge-fill" style="width: {{ s.percent|default(0) }}%;"></div>
                    </div>
                    <div class="sync-gauge-legend">
                        <span id="sync-gauge-count">{{ s.received|default(0) }} / {{ s.total|default(0) }}</span>
                        <span id="sync-gauge-percent">{{ s.percent|default(0) }} %</span>
                    </div>
                </div>

                <div class="sync-failed" id="sync-failed" {% if (s.failed|default(0)) == 0 %}hidden{% endif %}>
                    <i class="fas fa-triangle-exclamation"></i>
                    <span id="sync-failed-count">{{ s.failed|default(0) }}</span> échec(s) au dernier transfert
                </div>
            </div>
        </div>
    </section>
    </div>

    <style>
        .sync-indicator-row { display: flex; align-items: center; gap: .5rem; margin-bottom: .9rem; flex-wrap: wrap; }
        .sync-conn-dot { width: 12px; height: 12px; border-radius: 50%; background: #9aa3ab; box-shadow: 0 0 0 0 rgba(0,0,0,0); }
        .sync-conn-dot[data-sync-conn="online"] { background: #2ecc71; }
        .sync-conn-dot[data-sync-conn="transferring"] { background: #3498db; animation: sync-pulse 1.2s ease-in-out infinite; }
        .sync-conn-dot[data-sync-conn="offline"] { background: #b0b6bc; }
        @keyframes sync-pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(52,152,219,.6); } 50% { box-shadow: 0 0 0 6px rgba(52,152,219,0); } }
        .sync-conn-label { font-weight: 600; }
        .sync-conn-meta { color: #8a9199; font-size: .85em; }
        .sync-gauge-track { width: 100%; height: 14px; background: rgba(127,127,127,.18); border-radius: 8px; overflow: hidden; }
        .sync-gauge-fill { height: 100%; width: 0; background: linear-gradient(90deg, #3498db, #2ecc71); border-radius: 8px; transition: width .6s ease; }
        .sync-gauge-legend { display: flex; justify-content: space-between; margin-top: .35rem; font-size: .9em; color: #6b7280; }
        .sync-failed { margin-top: .7rem; color: #e67e22; font-size: .9em; }
    </style>
{% endblock %}

{% block quick_actions_links %}
    <a href="{{ base_path|default('') }}/gallery/{{ gallery_slug }}" class="quick-action-card"><i class="fas fa-images"></i> Voir la galerie</a>
    <a href="{{ base_path|default('') }}/gallery" class="quick-action-card"><i class="fas fa-camera"></i> Toutes les galeries</a>
    <a href="{{ base_path|default('') }}/" class="quick-action-card"><i class="fas fa-home"></i> Accueil</a>
{% endblock %}

{% block control_footer %}{% endblock %}

{% block footer %}
    {% include 'partials/_footer.twig' with {
        environment: environment|default('prod'),
        version: version|default(''),
        firmware_version: firmware_version|default(''),
        firmware_label: 'Firmware caméra',
        footer_text: 'Contrôle caméra ' ~ (gallery_label|default('uploadphotosserver')),
        base_path: base_path|default('')
    } %}
{% endblock %}

{% block control_scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    var controlApiBase = window.CONTROL_API_BASE;
    var valuesUpdater = new ControlValuesUpdater();
    valuesUpdater.init();

    function asOnOff(value) {
        return value === 1 || value === '1' || value === true || value === 'checked';
    }

    function updateHints(states) {
        var mailHint = document.getElementById('mailNotif-hint');
        if (mailHint && states['103'] !== undefined) {
            mailHint.textContent = asOnOff(states['103']) ? 'Activé' : 'Désactivé';
        }
        var forceHint = document.getElementById('forceWakeUp-hint');
        if (forceHint && states['104'] !== undefined) {
            forceHint.textContent = asOnOff(states['104']) ? 'Activé' : 'Désactivé';
        }
        var resetHint = document.getElementById('resetMode-hint');
        if (resetHint && states['106'] !== undefined) {
            resetHint.textContent = asOnOff(states['106']) ? 'Activé' : 'Désactivé';
        }
    }

    function syncSwitchByGpio(gpio, elementId, states) {
        var el = document.getElementById(elementId);
        if (!el || states[gpio] === undefined) return;
        el.checked = asOnOff(states[gpio]);
    }

    var controlSync = new ControlSync({
        apiBase: controlApiBase,
        pollInterval: 10,
        useFresh: true,
        onStatesReceived: function(states) {
            if (window.controlValuesUpdater && typeof window.controlValuesUpdater.updateParameters === 'function') {
                window.controlValuesUpdater.updateParameters(states);
            }
            syncSwitchByGpio('103', 'mailNotif', states);
            syncSwitchByGpio('104', 'forceWakeUp', states);
            syncSwitchByGpio('106', 'resetMode', states);
            updateHints(states);
        }
    });
    controlSync.initializeFromDOM();
    controlSync.start();

    window.controlSync = controlSync;
    window.controlValuesUpdater = valuesUpdater;

    window.saveParamSwitch = function(paramName, checked, valOn, valOff) {
        var value = checked ? valOn : valOff;
        var hintEl = document.getElementById(paramName + '-hint');
        if (hintEl) hintEl.textContent = checked ? 'Activé' : 'Désactivé';

        fetch(controlApiBase + '/parameters', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ param: paramName, value: value }),
            credentials: 'include'
        })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    if (typeof toastManager !== 'undefined') toastManager.showSuccess('Paramètre enregistré', 2500);
                    if (window.controlSync) window.controlSync.forceSync();
                } else {
                    if (typeof toastManager !== 'undefined') toastManager.showError(data.error || 'Erreur', 4000);
                }
            })
            .catch(function() {
                if (typeof toastManager !== 'undefined') toastManager.showError('Erreur réseau', 4000);
            });
    };

    initRealtimeUpdater({
        apiBasePath: '/gallery/{{ gallery_slug }}/api/outputs',
        pollInterval: 15000,
        enabled: false
    });

    // --- Jauge de transfert hors-ligne : poll de l'etat de session de sync ---
    (function initSyncGauge() {
        var panel = document.getElementById('sync-panel');
        if (!panel) return;
        var url = panel.getAttribute('data-sync-status-url');
        if (!url) return;

        var dot = document.getElementById('sync-conn-dot');
        var label = document.getElementById('sync-conn-label');
        var meta = document.getElementById('sync-conn-meta');
        var fill = document.getElementById('sync-gauge-fill');
        var count = document.getElementById('sync-gauge-count');
        var percent = document.getElementById('sync-gauge-percent');
        var failedBox = document.getElementById('sync-failed');
        var failedCount = document.getElementById('sync-failed-count');

        var LABELS = { transferring: 'Transfert en cours…', online: 'Connectée', offline: 'Hors ligne' };

        function render(s) {
            if (!s || typeof s !== 'object') return;
            var conn = s.connection || 'offline';
            if (dot) dot.setAttribute('data-sync-conn', conn);
            if (label) label.textContent = LABELS[conn] || 'Hors ligne';
            if (meta) meta.textContent = s.updated_at || '';
            var pct = Math.max(0, Math.min(100, parseInt(s.percent, 10) || 0));
            if (fill) fill.style.width = pct + '%';
            if (percent) percent.textContent = pct + ' %';
            if (count) count.textContent = (s.received || 0) + ' / ' + (s.total || 0);
            var failed = parseInt(s.failed, 10) || 0;
            if (failedBox) failedBox.hidden = failed === 0;
            if (failedCount) failedCount.textContent = failed;
        }

        function poll() {
            fetch(url, { credentials: 'include', headers: { 'Accept': 'application/json' } })
                .then(function(r) { return r.ok ? r.json() : null; })
                .then(function(data) { if (data) render(data); })
                .catch(function() { /* silencieux : reseau momentane */ });
        }

        // Cadence : plus rapide pendant un transfert actif, plus lente au repos.
        function tick() {
            poll();
            var active = dot && dot.getAttribute('data-sync-conn') === 'transferring';
            setTimeout(tick, active ? 5000 : 20000);
        }
        setTimeout(tick, 4000);
    })();
});
</script>
{% endblock %}


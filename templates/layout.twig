<!DOCTYPE HTML>
<html lang="fr">
<head>
    <title>{% block title %}n³ iot datas{% endblock %}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
    <meta name="theme-color" content="#008B74" />
    {% block meta_pwa %}
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    {% endblock %}
    <script src="{{ base_path|default('') }}/assets/js/theme-toggle.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cabin:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Raleway:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="{{ base_path|default('') }}/assets/css/theme-variables.css" />
    <link rel="stylesheet" href="{{ base_path|default('') }}/assets/css/main.css" />
    <noscript><link rel="stylesheet" href="{{ base_path|default('') }}/assets/css/noscript.css" /></noscript>
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="{{ base_path|default('') }}/assets/css/realtime-styles.css" />
    <link rel="shortcut icon" type="image/png" href="{{ base_path|default('') }}/assets/logo.png"/>
    <link rel="manifest" href="{{ base_path|default('') }}/manifest.json" />
    <link rel="apple-touch-icon" href="{{ base_path|default('') }}/assets/icons/icon-192.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" integrity="sha512-1cK78a1o+ht2JcaW6g8OXYwqI4ko/XG63A4vvnkVo8amI7h0Fn36oG8/g6k2oTf2yf9Y0+voHdOJxrJ9J8PQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    {% block head_css %}{% endblock %}
    {% block head_scripts %}{% endblock %}
    <script src="{{ base_path|default('') }}/assets/js/highcharts-theme.js"></script>
    {% block styles %}{% endblock %}
</head>
{% block body_tag %}<body class="is-preload">{% endblock %}
    <div id="page-bg" aria-hidden="true"></div>
    {% block before_wrapper %}{% endblock %}
    <div id="wrapper" class="fade-in{% block wrapper_class %}{% endblock %}">
        <header id="header">
            <a href="{{ base_path|default('') }}/" class="logo"><img src="{{ base_path|default('') }}/assets/logo.png" alt="n³ iot datas" /><span class="logo-text">IOT</span></a>
        </header>
        {% include 'partials/_nav.twig' with { nav_active: nav_active|default('home'), environment: environment|default('prod'), base_path: base_path|default('') } %}
        <div id="main">
            {% block content %}{% endblock %}
        </div>
        {% block footer %}
        <footer id="footer" class="{% block footer_class %}app-footer{% endblock %}">
            {% block footer_content %}
            <p>{% if version is defined and version %}{{ version }} | {% endif %}n³ IoT Datas Platform | &copy; 2025 olution</p>
            {% endblock %}
        </footer>
        {% endblock %}
    </div>

    {% block scripts_vendor %}
    <script src="{{ base_path|default('') }}/assets/js/jquery.min.js"></script>
    <script src="{{ base_path|default('') }}/assets/js/jquery.scrollex.min.js"></script>
    <script src="{{ base_path|default('') }}/assets/js/jquery.scrolly.min.js"></script>
    <script src="{{ base_path|default('') }}/assets/js/browser.min.js"></script>
    <script src="{{ base_path|default('') }}/assets/js/breakpoints.min.js"></script>
    <script src="{{ base_path|default('') }}/assets/js/util.js"></script>
    <script src="{{ base_path|default('') }}/assets/js/main.js"></script>
    {% endblock %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js" integrity="sha512-A7AYk1fGKX92SACKIcXrCkM9146OdBovex/f86eScyxR5L7Sqj/e8r8Uj/nzJpP/73GAuwOyJyO+a/zeFfz7Lg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
    (function() {
      window.addEventListener('load', function() {
        setTimeout(function() {
          if (typeof AOS !== 'undefined') {
            AOS.init({ duration: 600, offset: 80, once: true });
          }
        }, 150);
      });
    })();
    </script>
    {% block scripts %}{% endblock %}
</body>
</html>

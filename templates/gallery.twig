{#
    n3 iot datas - Galerie photo (MSP1 / N3PP / FFP3)
    Style identique au site actuel, pagination, lightbox.
#}
{% extends 'layout.twig' %}

{% block title %}{{ page_title|default('Galerie') }}{% endblock %}

{% block head_css %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/featherlight@1.7.14/release/featherlight.min.css" />
{% endblock %}

{% block styles %}
    <style>
        .section-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin: 40px 0 20px 0;
            padding-bottom: 10px;
            border-bottom: 3px solid #008B74;
        }
        .section-header h2 { margin: 0; color: #008B74; font-size: 2em; }
        .section-header i { font-size: 2em; color: #008B74; }
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 20px;
            margin: 24px 0;
        }
        .gallery-item {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 2px 12px rgba(0,139,116,0.12);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .gallery-item:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,139,116,0.2);
        }
        .gallery-item a {
            display: block;
            text-decoration: none;
            color: inherit;
        }
        .gallery-item img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            display: block;
        }
        .gallery-item .caption {
            padding: 10px 12px;
            font-size: 0.85em;
            color: #555;
        }
        .gallery-pagination {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin: 28px 0;
            padding: 16px 0;
            border-top: 1px solid rgba(0,139,116,0.2);
        }
        .gallery-pagination .info { color: #7f8c8d; font-size: 0.9em; }
        .gallery-pagination .nav-links { display: flex; gap: 12px; }
        .gallery-pagination a, .gallery-pagination span {
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
        }
        .gallery-pagination a {
            background: linear-gradient(135deg, #008B74 0%, #00B794 100%);
            color: white;
            transition: opacity 0.2s;
        }
        .gallery-pagination a:hover { opacity: 0.9; color: white; }
        .gallery-pagination span.disabled {
            background: #e9ecef;
            color: #adb5bd;
            cursor: not-allowed;
        }
        .gallery-empty {
            text-align: center;
            padding: 60px 20px;
            background: #f8f9fa;
            border-radius: 16px;
            color: #7f8c8d;
        }
        .gallery-empty i { font-size: 4em; margin-bottom: 16px; color: #dee2e6; }
    </style>
{% endblock %}

{% block content %}
    <article class="post featured">
        <header class="major">
            <h1><i class="fas fa-images"></i> {{ gallery_title }}</h1>
            <p>{{ gallery_description }}</p>
            <hr />
        </header>

        <div class="section-header">
            <i class="fas fa-camera"></i>
            <h2>Les photos</h2>
        </div>

        {% if images is empty %}
            <div class="gallery-empty">
                <i class="fas fa-image"></i>
                <p>Aucune photo pour le moment.</p>
                <p>Les images envoyées par la caméra ESP32-CAM apparaîtront ici.</p>
            </div>
        {% else %}
            <div class="gallery-grid">
                {% for filename in images %}
                    <div class="gallery-item">
                        <a href="{{ base_path }}/gallery/{{ gallery_slug }}/files/{{ filename }}" data-featherlight="{{ base_path }}/gallery/{{ gallery_slug }}/files/{{ filename }}">
                            <img src="{{ base_path }}/gallery/{{ gallery_slug }}/files/{{ filename }}" alt="{{ filename }}" loading="lazy" />
                            <span class="caption">{{ filename }}</span>
                        </a>
                    </div>
                {% endfor %}
            </div>

            <div class="gallery-pagination">
                <span class="info">{{ total_images }} photo(s) — page {{ current_page }} / {{ max_page }}</span>
                <div class="nav-links">
                    {% if current_page > 1 %}
                        <a href="{{ base_path }}/gallery/{{ gallery_slug }}?page={{ current_page - 1 }}"><i class="fas fa-arrow-left"></i> Précédent</a>
                    {% else %}
                        <span class="disabled"><i class="fas fa-arrow-left"></i> Précédent</span>
                    {% endif %}
                    {% if current_page < max_page %}
                        <a href="{{ base_path }}/gallery/{{ gallery_slug }}?page={{ current_page + 1 }}">Suivant <i class="fas fa-arrow-right"></i></a>
                    {% else %}
                        <span class="disabled">Suivant <i class="fas fa-arrow-right"></i></span>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <hr />
        <p><a href="{{ base_path }}{{ back_url }}" class="button primary"><i class="fas fa-arrow-left"></i> Retour aux données</a></p>
    </article>
{% endblock %}

{% block footer %}
    <footer id="footer" style="text-align: center; padding: 20px 0; color: #999; font-size: 0.9em;">
        <p>N3 IoT Datas – Galerie photo | © 2025 olution</p>
        <p style="margin-top: 10px;"><a href="/" style="color: #999; text-decoration: none;"><i class="fas fa-home"></i> Retour à l'accueil</a></p>
    </footer>
{% endblock %}

{% block scripts_vendor %}
    <script src="{{ base_path }}/assets/js/jquery.min.js"></script>
    <script src="{{ base_path }}/assets/js/jquery.scrollex.min.js"></script>
    <script src="{{ base_path }}/assets/js/jquery.scrolly.min.js"></script>
    <script src="{{ base_path }}/assets/js/browser.min.js"></script>
    <script src="{{ base_path }}/assets/js/breakpoints.min.js"></script>
    <script src="{{ base_path }}/assets/js/util.js"></script>
    <script src="{{ base_path }}/assets/js/main.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/featherlight@1.7.14/release/featherlight.min.js"></script>
{% endblock %}

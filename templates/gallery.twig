{% extends 'layout.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block wrapper_class %} gallery-page-wrapper{% endblock %}

{% block head_css %}
<link rel="stylesheet" href="{{ base_path|default('') }}/assets/css/gallery-styles.css" />
{% endblock %}

{% block content %}
<div class="gallery-page">
    <div class="gallery-links" data-aos="fade-up">
        <a href="{{ base_path|default('') }}{{ back_url }}" class="gallery-back"><i class="fas fa-arrow-left"></i> Retour aux données</a>
        <a href="{{ base_path|default('') }}/gallery/{{ gallery_slug }}" class="gallery-back"><i class="fas fa-film"></i> Timelapse</a>
    </div>

    <div class="gallery-others" style="margin-bottom:20px;padding:12px;background:#f8f9fa;border-radius:8px;">
        <strong>Autres galeries (admin) :</strong>
        <a href="{{ base_path|default('') }}/admin/gallery/ffp3" style="margin:0 8px;">Aquaponie (FFP3)</a>
        <a href="{{ base_path|default('') }}/admin/gallery/msp1" style="margin:0 8px;">Potager (MSP1)</a>
        <a href="{{ base_path|default('') }}/admin/gallery/n3pp" style="margin:0 8px;">Élevage (N3PP)</a>
    </div>

    <div class="gallery-hero" data-aos="fade-up">
        <h1><i class="fas fa-images"></i> {{ gallery_title }}</h1>
        <p>{{ gallery_description }}</p>
    </div>

    {% if images|length > 0 %}
        <div class="gallery-grid" data-aos="fade-up">
            {% for filename in images %}
                <div class="gallery-item">
                    <a href="{{ base_path|default('') }}/gallery/{{ gallery_slug }}/files/{{ filename }}" target="_blank" rel="noopener">
                        <img src="{{ base_path|default('') }}/gallery/{{ gallery_slug }}/files/{{ filename }}" alt="Photo {{ loop.index }}" loading="lazy" />
                    </a>
                </div>
            {% endfor %}
        </div>

        {% if max_page > 1 %}
            <nav class="gallery-pagination" aria-label="Pagination">
                {% if current_page > 1 %}
                    <a href="?page={{ current_page - 1 }}">&laquo; Précédent</a>
                {% endif %}
                {% for p in 1..max_page %}
                    {% if p == current_page %}
                        <span class="current">{{ p }}</span>
                    {% else %}
                        <a href="?page={{ p }}">{{ p }}</a>
                    {% endif %}
                {% endfor %}
                {% if current_page < max_page %}
                    <a href="?page={{ current_page + 1 }}">Suivant &raquo;</a>
                {% endif %}
            </nav>
        {% endif %}
        <p class="gallery-photo-count">{{ total_images }} photo(s)</p>
    {% else %}
        <div class="gallery-empty">
            <i class="fas fa-images"></i>
            <p>Aucune photo pour le moment.</p>
            <p>Les photos sont prises automatiquement par la caméra ESP32-CAM.</p>
        </div>
    {% endif %}
</div>
{% endblock %}

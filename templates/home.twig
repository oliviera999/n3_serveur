{% block scripts_vendor %}
<script src="{{ base_path }}/assets/js/jquery.min.js"></script>
<script src="{{ base_path }}/assets/js/jquery.scrollex.min.js"></script>
<script src="{{ base_path }}/assets/js/jquery.scrolly.min.js"></script>
<script src="{{ base_path }}/assets/js/browser.min.js"></script>
<script src="{{ base_path }}/assets/js/breakpoints.min.js"></script>
<script src="{{ base_path }}/assets/js/util.js"></script>

{# Page d'accueil - Vue d'ensemble du projet N3 IoT Datas #}
{% extends 'layout.twig' %}

{% block title %}n3 iot datas - olution{% endblock %}

{% block styles %}
<style>
    #header .logo img { height: 2rem; width: auto; display: block; vertical-align: middle; }
    /* Cartes de projets modernes */
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        margin: 40px 0;
    }
    
    .project-card {
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 4px 16px rgba(0,139,116,0.15);
        text-align: center;
        transition: transform 0.3s, box-shadow 0.3s;
        border-top: 5px solid #008B74;
        position: relative;
        overflow: hidden;
    }
    
    .project-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient(90deg, #008B74, #00c9a7);
        transition: height 0.3s;
    }
    
    .project-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 28px rgba(0,139,116,0.25);
    }
    
    .project-card:hover::before {
        height: 8px;
    }
    
    .project-icon {
        font-size: 4em;
        margin-bottom: 20px;
        display: block;
        color: #008B74;
    }
    
    .project-title {
        font-size: 1.5em;
        font-weight: bold;
        color: #2c3e50;
        margin: 15px 0;
    }
    
    .project-description {
        font-size: 0.95em;
        color: #7f8c8d;
        line-height: 1.6;
        margin: 15px 0;
    }
    
    .project-link {
        display: inline-block;
        margin-top: 20px;
        padding: 12px 30px;
        background: linear-gradient(135deg, #008B74 0%, #00B794 100%);
        color: white;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 4px 12px rgba(0,139,116,0.3);
    }
    
    .project-link:hover {
        transform: scale(1.05);
        box-shadow: 0 6px 20px rgba(0,139,116,0.4);
        color: white;
    }

    .project-link-desc {
        background: transparent !important;
        color: #008B74 !important;
        box-shadow: none !important;
        border: 2px solid #008B74;
    }

    .project-link-desc:hover {
        background: rgba(0,139,116,0.1) !important;
        color: #008B74 !important;
    }

    /* Section headers */
    .section-header {
        display: flex !important;
        align-items: center !important;
        gap: 15px !important;
        margin: 40px 0 20px 0 !important;
        padding-bottom: 10px !important;
        border-bottom: 3px solid #008B74 !important;
    }
    
    .section-header h2 {
        margin: 0 !important;
        color: #008B74 !important;
        font-size: 2em !important;
    }
    
    .section-header i {
        font-size: 2em !important;
        color: #008B74 !important;
        display: inline-block !important;
    }
    
    /* Stats grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin: 30px 0;
    }
    
    .stat-item {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 12px;
        text-align: center;
        border-left: 4px solid #008B74;
    }
    
    .stat-value {
        font-size: 2em;
        font-weight: bold;
        color: #008B74;
        display: block;
    }
    
    .stat-label {
        font-size: 0.9em;
        color: #7f8c8d;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 10px;
    }
    
    /* Point live dans les cartes (compact et élégant) */
    .project-live-status {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-bottom: 10px;
        font-size: 0.78em;
    }
    .project-live-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 5px;
        font-size: 0.68em;
        font-weight: 600;
    }
    .project-live-badge.loading {
        background: #e2e3e5;
        color: #383d41;
    }
    .project-live-badge.online {
        background: #d4edda;
        color: #155724;
    }
    .project-live-badge.online i.fa-circle {
        animation: home-live-point-fade 1.8s ease-in-out infinite;
    }
    .project-live-badge.offline {
        background: #f8d7da;
        color: #721c24;
    }
    .project-live-badge.error {
        background: #fff3cd;
        color: #856404;
    }
    .project-live-datetime {
        color: #6c757d;
        font-size: 0.75em;
    }
    @keyframes home-live-point-fade {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.45; }
    }

    /* Badges compacts reflétant la réalité des modules */
    .project-badges {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 5px;
        margin: 12px 0 16px 0;
        min-height: 24px;
    }
    .project-badge {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 2px 7px;
        border-radius: 5px;
        font-size: 0.65em;
        font-weight: 500;
        color: #5a6c7d;
        background: rgba(0,139,116,0.06);
        border: 1px solid rgba(0,139,116,0.12);
        white-space: nowrap;
    }
    .project-badge i {
        font-size: 0.8em;
        color: #008B74;
        opacity: 0.85;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .projects-grid {
            grid-template-columns: 1fr;
        }
        
        .project-icon {
            font-size: 3em;
        }
        
        .project-badges {
            gap: 4px;
            margin: 10px 0 14px 0;
        }
        .project-badge {
            font-size: 0.62em;
            padding: 2px 6px;
        }
    }
</style>
{% endblock %}

{% block content %}

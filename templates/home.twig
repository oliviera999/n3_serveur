{% block scripts %}
<script>
(function() {
    var BASE = '{{ base_path }}' || '';
    var LIVE_MODULES = [
        { id: 'ffp3-wroom-prod', url: BASE + '/api/realtime/system/health' },
        { id: 'msp1-prod', url: BASE + '/msp1/api/realtime/system/health' },
        { id: 'n3pp-prod', url: BASE + '/n3pp/api/realtime/system/health' },
        { id: 'pgl-prod', url: BASE + '/pgl/api/system/health' }
    ];
    var POLL_INTERVAL_MS = 15000;

    function formatDatetime(str) {
        if (!str) return '—';
        var d = new Date(str.replace(' ', 'T'));
        if (isNaN(d.getTime())) return str;
        var pad = function(n) { return (n < 10 ? '0' : '') + n; };
        return pad(d.getDate()) + '/' + pad(d.getMonth() + 1) + '/' + d.getFullYear() + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
    }

    function updateCard(moduleId, health) {
        var card = document.querySelector('.project-card[data-module="' + moduleId + '"]');
        if (!card) return;
        var statusEl = card.querySelector('.project-live-status');
        var badge = card.querySelector('.project-live-badge');
        var datetimeEl = card.querySelector('.project-live-datetime');
        if (!statusEl || !badge || !datetimeEl) return;

        if (health === null) {
            badge.className = 'project-live-badge error';
            badge.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Erreur';
            datetimeEl.textContent = '—';
            return;
        }

        var online = health.online === true;
        badge.className = 'project-live-badge ' + (online ? 'online' : 'offline');
        badge.innerHTML = '<i class="fas fa-circle"></i> ' + (online ? 'LIVE' : 'HORS LIGNE');
        datetimeEl.textContent = formatDatetime(health.last_reading || null) || '—';
    }

    function setLoading(moduleId) {
        var card = document.querySelector('.project-card[data-module="' + moduleId + '"]');
        if (!card) return;
        var badge = card.querySelector('.project-live-badge');
        var datetimeEl = card.querySelector('.project-live-datetime');
        if (!badge || !datetimeEl) return;
        badge.className = 'project-live-badge loading';
        badge.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Chargement...';
        datetimeEl.textContent = '—';
    }

    function fetchOne(mod) {
        return fetch(mod.url).then(function(r) {
            if (r.ok) return r.json();
            return null;
        }).catch(function() { return null; });
    }

    function pollAll(isFirst) {
        if (isFirst) {
            LIVE_MODULES.forEach(function(mod) { setLoading(mod.id); });
        }
        LIVE_MODULES.forEach(function(mod) {
            fetchOne(mod).then(function(h) { updateCard(mod.id, h); });
        });
    }

    var pollTimer = null;

    function startPolling() {
        if (pollTimer !== null) return;
        pollTimer = setInterval(function() { pollAll(false); }, POLL_INTERVAL_MS);
    }

    function stopPolling() {
        if (pollTimer === null) return;
        clearInterval(pollTimer);
        pollTimer = null;
    }

    pollAll(true);
    startPolling();

    document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
            stopPolling();
            return;
        }
        pollAll(false);
        startPolling();
    });
})();
</script>
{% endblock %}

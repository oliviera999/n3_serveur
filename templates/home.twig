                <span class="project-badge"><i class="fas fa-cloud-rain"></i> pluie</span>
                <span class="project-badge"><i class="fas fa-water"></i> temp. eau</span>
                <span class="project-badge"><i class="fas fa-thermometer-half"></i> temp. air</span>
                <span class="project-badge"><i class="fas fa-tint"></i> humid. air</span>

{% extends 'layout.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block head_css %}
    <link rel="stylesheet" href="{{ base_path|default('') }}/assets/css/module-description-styles.css" />
{% endblock %}

{% block styles %}
    <style id="page-bg-override">
        body { background: transparent !important; }
        #page-bg {
            position: fixed !important; top: 0; left: 0; right: 0; bottom: 0;
            z-index: -1 !important;
            background-color: {{ hero_bg_color|default('#e8f4f2') }};
            opacity: 0;
            animation: pageBgFadeIn 1.2s ease-out forwards !important;
            pointer-events: none;
        }
        @keyframes pageBgFadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        #wrapper.fade-in::before { background: transparent !important; background-color: transparent !important; }
    </style>
    <style id="module-description-theme-vars">
        #wrapper {
            --module-hero-color-1: {{ hero_color_1|default('#008B74') }};
            --module-hero-color-2: {{ hero_color_2|default('#007A61') }};
            --module-hero-color-3: {{ hero_color_3|default('#00B794') }};
        }
    </style>
{% endblock %}

{% block content %}
    <div class="modern-header">
        <div class="header-content">
            <h1 class="header-title">
                <i class="fas {{ hero_icon|default('fa-info-circle') }}" aria-hidden="true"></i>
                {{ hero_title }}
            </h1>
            <p class="header-subtitle">{{ hero_subtitle }}</p>
            <p class="header-more"><a href="{{ data_url }}">Voir les données en direct</a></p>
        </div>
    </div>

    <article class="post featured">
        {% block desc_sections %}{% endblock %}
    </article>
{% endblock %}

{% block footer %}
{% include 'partials/_footer.twig' %}
{% endblock %}

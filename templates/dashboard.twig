{% extends 'layout.twig' %}

{% block title %}Dashboard Capteurs - n³ iot datas{% endblock %}

{% block head_css %}
<link rel="stylesheet" href="{{ base_path }}/assets/css/common-data.css" />
{% endblock %}

{% block styles %}{% endblock %}

{% block content %}
{# Ordre des sections : header, info-banner, context-badges, quick-links-grid, system-health-panel, Dernière lecture, Statistiques par capteur, Vue détaillée #}
<article class="post featured">
    <header class="major" data-aos="fade-up">
        <h1>
            <i class="icon solid fa-chart-line"></i>
            Dashboard des capteurs
            <i class="icon solid fa-chart-line"></i>
        </h1>
        <p>Vue d'ensemble des données collectées par les capteurs ESP32</p>
        <hr />
    </header>

    <!-- Bannière période -->
    <div class="info-banner" data-aos="fade-up">
        <div class="info-banner-title">📊 Période analysée</div>
        <div class="info-banner-value">
            Du {{ startDate|date('d/m/Y H:i:s') }} au {{ endDate|date('d/m/Y H:i:s') }}
        </div>
        <div class="info-banner-details">
            Durée : <strong>{{ duration }}</strong> • Mesures : <strong>{{ readingsCount }}</strong>
        </div>
    </div>

    <div class="context-badges context-badges-dashboard" data-aos="fade-up">
        <span class="context-badge {{ environment == 'test' or environment == 'test3' ? 'context-badge-test' : 'context-badge-prod' }}">
            <i class="fas fa-globe" aria-hidden="true"></i>
            <span>{{ environment == 'test' ? 'Environnement : TEST' : (environment == 'test3' ? 'Environnement : TEST3' : (environment == 's3' ? 'Environnement : S3' : 'Environnement : PROD')) }}</span>
        </span>
        <span class="context-badge">
            <i class="fas fa-database" aria-hidden="true"></i>
            <span>Source : Table {{ data_table }}</span>
        </span>
        <span class="context-badge">
            <i class="fas fa-microchip" aria-hidden="true"></i>
            <span>Firmware ESP32 v{{ firmware_version }}</span>
        </span>
        <span class="context-badge">
            <i class="fas fa-code-branch" aria-hidden="true"></i>
            <span>{{ version }}</span>
        </span>
    </div>

    <div class="quick-links-grid" data-aos="fade-up">
        <a class="quick-link-card" href="/{{ environment == 'test' ? 'aquaponie-test' : (environment == 'test3' ? 'aquamobile-test' : (environment == 's3' ? 'aquamobile' : 'aquaponie')) }}" data-aos="fade-up" data-aos-delay="0">
            <i class="fas fa-water" aria-hidden="true"></i>
            <span class="quick-link-title">Vue Aquaponie</span>
            <span class="quick-link-description">Graphiques en direct, filtres de période et indicateurs hydriques.</span>
        </a>
        <a class="quick-link-card" href="/{{ environment == 'test' ? 'aquaponie-control-test' : (environment == 'test3' ? 'aquamobile-control-test' : (environment == 's3' ? 'aquamobile-control' : 'aquaponie-control')) }}">
            <i class="fas fa-sliders-h" aria-hidden="true"></i>
            <span class="quick-link-title">Contrôle des actionneurs</span>
            <span class="quick-link-description">Pilotez les pompes et vérifiez la synchronisation ESP32.</span>
        </a>
        <a class="quick-link-card" href="/post-data{{ environment == 'test' ? '-test' : (environment == 'test3' ? '3-test' : (environment == 's3' ? '3' : '')) }}">
            <i class="fas fa-satellite-dish" aria-hidden="true"></i>
            <span class="quick-link-title">Diagnostics API</span>
            <span class="quick-link-description">Surveillez les signatures HMAC, la latence et la santé des endpoints.</span>
        </a>
    </div>

    <!-- Panneau d'état du système (temps réel) -->
    <div class="system-health-panel">
        <h3>
            <i class="fas fa-heartbeat" aria-hidden="true"></i>
            État du système
            <span class="refresh-spinner" id="health-spinner">
                <i class="fas fa-sync-alt" aria-hidden="true"></i>
            </span>
        </h3>
        
        <div class="health-grid">
            <div class="health-item">
                <div class="health-item-label">Statut</div>
                <div id="system-status-indicator" class="status-indicator status-paused">
                    <span class="status-pill" data-status-badge>
                        <i class="fas fa-circle-notch fa-spin" aria-hidden="true"></i>
                        <strong>Vérification…</strong>
                    </span>
                    <span class="status-text" data-status-label>
                        <i class="fas fa-circle-notch fa-spin" aria-hidden="true"></i>
                        <span>Vérification…</span>
                    </span>
                </div>
            </div>
            
            <div class="health-item">
                <div class="health-item-label">Dernière réception</div>
                <div class="health-item-value" id="last-reading-time" data-default="pending">
                    <span class="reading-ago" data-reading-ago>
                        <i class="fas fa-spinner fa-spin"></i>
                    </span>
                    <span class="reading-timestamp" data-reading-timestamp style="display: none;"></span>
                </div>
            </div>
            
            <div class="health-item">
                <div class="health-item-label">Uptime (30j)</div>
                <div class="health-item-value" id="system-uptime">
                    <i class="fas fa-spinner fa-spin"></i>
                </div>
            </div>
            
            <div class="health-item">
                <div class="health-item-label">Lectures aujourd'hui</div>
                <div class="health-item-value" id="readings-today" data-default="pending">
                    <span class="reading-count" data-reading-count>
                        <i class="fas fa-spinner fa-spin"></i>
                    </span>
                    <span class="reading-hint" data-reading-hint>/ jour</span>
                </div>
            </div>
        </div>
        
        <div class="next-update-countdown" id="next-update-info">
            Prochaine mise à jour dans <strong id="countdown-seconds">15</strong> secondes
        </div>
    </div>

    <!-- Section Dernière lecture -->
    <div class="section-header">
        <i class="fas fa-clock" aria-hidden="true"></i>
        <h3>Dernière lecture</h3>
    </div>

{% if lastReading %}
    <div class="modern-table">
        <table>
            <caption class="sr-only">Dernière lecture des capteurs</caption>
            <thead>
                <tr>
                    {% for k in lastReading|keys %}<th scope="col">{{ k }}</th>{% endfor %}
                </tr>
            </thead>
            <tbody>
                <tr>
                    {% for v in lastReading %}<td><strong>{{ v }}</strong></td>{% endfor %}
                </tr>
            </tbody>
        </table>
    </div>
{% else %}
    <p class="dashboard-no-data">Aucune donnée disponible.</p>
{% endif %}

    <!-- Section Statistiques avec cartes modernes -->
    <div class="section-header">
        <i class="fas fa-chart-bar" aria-hidden="true"></i>
        <h3>Statistiques par capteur</h3>
    </div>

    <div class="stats-grid">
{% for sensor, s in stats %}
    {% set iconClass = 'fa-circle' %}
    {% set cardClass = '' %}
    
    {% if sensor == 'TempAir' or sensor == 'TempEau' %}
        {% set iconClass = 'fa-temperature-half' %}
        {% set cardClass = 'temp' %}
    {% elseif sensor == 'Humidite' %}
        {% set iconClass = 'fa-droplet' %}
        {% set cardClass = 'humidity' %}
    {% elseif sensor == 'Luminosite' %}
        {% set iconClass = 'fa-lightbulb' %}
        {% set cardClass = 'light' %}
    {% elseif sensor matches '/Eau/' %}
        {% set iconClass = 'fa-water' %}
        {% set cardClass = 'water' %}
    {% endif %}
    
    <div class="stat-card {{ cardClass }}">
        <i class="fas {{ iconClass }} stat-card-icon" aria-hidden="true"></i>
        <div class="stat-card-label">{{ sensor }}</div>
        <div class="stat-card-value">
            {{ s.avg|number_format(1, ',', ' ') }}
            <span class="stat-card-unit">
                {% if sensor matches '/Temp/' %}°C
                {% elseif sensor == 'Humidite' %}%
                {% elseif sensor == 'Luminosite' %}UA
                {% elseif sensor matches '/Eau/' %}cm
                {% endif %}
            </span>
        </div>
        <div class="stat-card-details">
            <div>Min: {{ s.min }} | Max: {{ s.max }}</div>
            <div>Écart-type: {{ s.stddev|number_format(2, ',', ' ') }}</div>
        </div>
    </div>
{% endfor %}
    </div>

    <!-- Tableau détaillé (version moderne) -->
    <div class="section-header">
        <i class="fas fa-table" aria-hidden="true"></i>
        <h3>Vue détaillée</h3>
    </div>

    <div class="modern-table">
        <table>
            <caption class="sr-only">Statistiques détaillées par capteur</caption>
            <thead>
                <tr>
                    <th scope="col">Capteur</th><th scope="col">Minimum</th><th scope="col">Maximum</th><th scope="col">Moyenne</th><th scope="col">Écart-type</th>
                </tr>
            </thead>
            <tbody>
                {% for sensor, s in stats %}
                <tr>
                    <td><strong>{{ sensor }}</strong></td>
                    <td>{{ s.min }}</td>
                    <td>{{ s.max }}</td>
                    <td>{{ s.avg }}</td>
                    <td>{{ s.stddev }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</article>
{% endblock %}

{% block footer %}
{% include 'partials/_footer.twig' with {'footer_text': "Système d'aquaponie FFP3"} %}
{% endblock %}

{% block scripts_vendor %}
<script src="{{ base_path }}/assets/js/jquery.min.js"></script>
<script src="{{ base_path }}/assets/js/jquery.scrollex.min.js"></script>
<script src="{{ base_path }}/assets/js/jquery.scrolly.min.js"></script>
<script src="{{ base_path }}/assets/js/browser.min.js"></script>
<script src="{{ base_path }}/assets/js/breakpoints.min.js"></script>
<script src="{{ base_path }}/assets/js/util.js"></script>
<script src="{{ base_path }}/assets/js/main.js"></script>
{% endblock %}

{% block scripts %}
    {% include 'partials/_live_badge.twig' %}
<script src="{{ base_path }}/assets/js/toast-notifications.js"></script>
<script src="{{ base_path }}/assets/js/stats-updater.js"></script>
<script src="{{ base_path }}/assets/js/realtime-updater.js"></script>
<script src="{{ base_path }}/assets/js/pwa-init.js"></script>

<script>
    // Variables globales
    let statsUpdater = null;
    // realtimeUpdater est déjà déclaré globalement dans realtime-updater.js
    
    // Initialiser le système temps réel
    document.addEventListener('DOMContentLoaded', function() {
        // Initialiser StatsUpdater pour le dashboard
        statsUpdater = new StatsUpdater({
            sensors: ['EauAquarium', 'EauReserve', 'EauPotager', 'TempEau', 'TempAir', 'Humidite', 'Luminosite']
        });
        
        setTimeout(() => {
            const initialized = statsUpdater.init();
            if (initialized) {
                console.log('[Dashboard] StatsUpdater initialized successfully');
            } else {
                console.warn('[Dashboard] StatsUpdater initialization failed');
            }
        }, 500);
        
        // Exposer globalement
        window.statsUpdater = statsUpdater;
        
        // Utiliser le bon path API selon l'environnement
        const apiBasePath = '{{ realtime_api_base|default("/api/realtime") }}';
        
        // Démarrer le polling automatique (15 secondes) - la variable est globale via realtime-updater.js
        initRealtimeUpdater({
            apiBasePath: apiBasePath,
            pollInterval: 15000,
            enabled: true,
            onNewData: function(readings) {
                console.log('[Dashboard] New sensor data received:', readings);
                // Optionnel: recharger la page pour afficher les nouvelles données
                // window.location.reload();
            },
            onHealthUpdate: function(health) {
                console.log('[Dashboard] System health updated:', health);
            }
        });
        
        console.log('[Dashboard] Live update system initialized');
    });
</script>
{% endblock %}

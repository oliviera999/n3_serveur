{% extends 'layout.twig' %}
{# Landing galeries : 3 blocs avec dernière photo, texte et lien vers chaque galerie #}

{% block title %}{{ page_title|default('Galeries photos') }} - n³ iot datas{% endblock %}

{% block wrapper_class %} gallery-landing-wrapper{% endblock %}

{% block head_css %}
<link rel="stylesheet" href="{{ base_path|default('') }}/assets/css/gallery-styles.css" />
{% endblock %}

{% block content %}
<div class="gallery-landing">
    <div class="gallery-landing-header" data-aos="fade-up">
        <h1><i class="fas fa-images"></i> Galeries photos</h1>
        <p>Photos capturées automatiquement par les caméras ESP32-CAM des projets IoT : aquaponie, potager et élevage d'insectes.</p>
    </div>

    <div class="gallery-landing-grid" data-aos="fade-up">
        {% for g in galleries|default([]) %}
        <a href="{{ g.url }}" class="gallery-landing-card" data-aos="fade-up" data-aos-delay="{{ loop.index0 * 50 }}">
            <div class="gallery-landing-card-image">
                {% if g.last_photo_url %}
                <img src="{{ g.last_photo_url }}" alt="Dernière photo {{ g.title }}" loading="lazy" />
                {% else %}
                <div class="gallery-landing-placeholder">
                    <i class="fas fa-camera"></i>
                    <span>Aucune photo</span>
                </div>
                {% endif %}
            </div>
            <div class="gallery-landing-card-body">
                <h2>{{ g.title }}</h2>
                <p>{{ g.description }}</p>
                <span class="gallery-landing-cta">Voir la galerie <i class="fas fa-arrow-right"></i></span>
            </div>
        </a>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% extends 'layout.twig' %}
{# Galerie : animations conservees, pas de graphiques (cf. layout.twig) #}
{% set page_family = 'gallery' %}

{% block title %}{{ page_title|default('Timelapses des projets | n³ IoT') }}{% endblock %}
{% block meta_description %}Photos et vidéos accélérées capturées par les caméras des écosystèmes n³.{% endblock %}

{% block wrapper_class %} gallery-landing-wrapper{% endblock %}

{% block head_css %}
<link rel="stylesheet" href="{{ base_path|default('') }}/assets/css/gallery-styles.css" />
{% endblock %}

{% block content %}
<div class="gallery-landing-page">
  <div class="gallery-landing-header">
    <h1><i class="fas fa-images"></i> Galeries</h1>
    <p>Des caméras photographient chaque écosystème à intervalles réguliers. Mises bout à bout, ces images racontent le temps qui passe : une plante qui pousse, une journée de lumière, la vie de la serre.</p>
  </div>
  
  <div class="gallery-cards">
    {% for gallery in galleries %}
    <div class="gallery-card">
      <div class="gallery-card-header">
        <i class="fas {{ gallery.icon }} gallery-card-icon"></i>
        <h2 class="gallery-card-title">{{ gallery.title }}</h2>
      </div>
      
      {% if gallery.last_photo_url %}
      <div class="gallery-card-image">
        <img src="{{ gallery.last_photo_url }}" alt="Dernière photo {{ gallery.title }}" loading="lazy" />
      </div>
      {% else %}
      <div class="gallery-card-image">
        <div class="gallery-card-no-photo">
          <i class="fas fa-image"></i>
          <span>Pas encore d'images. La caméra reprendra ses prises de vue prochainement — revenez bientôt.</span>
        </div>
      </div>
      {% endif %}
      
      <p class="gallery-card-description">{{ gallery.description }}</p>
      
      <a href="{{ gallery.url }}" class="gallery-card-link">
        <i class="fas fa-arrow-right"></i>
        Voir la galerie
      </a>
    </div>
    {% else %}
    <div class="gallery-empty">
      <i class="fas fa-images"></i>
      <p>Aucune galerie configurée pour le moment.</p>
    </div>
    {% endfor %}
  </div>
</div>
{% endblock %}

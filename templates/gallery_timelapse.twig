{% extends 'layout.twig' %}

{% block title %}{{ page_title|default('Timelapse - n3 iot datas') }}{% endblock %}

{% block styles %}
<style>
  /* Timelapse — palette unifiée site n3 (#008B74, #00B794) */
  .timelapse-page {
    --accent: #008B74;
    --accent-light: #00B794;
    --accent-bg: rgba(0,139,116,0.12);
    --accent-border: rgba(0,139,116,0.3);
    --surface: #252d36;
    --surface2: #2d3640;
    --border: #3d4a56;
    --text: #e8eaed;
    --text-dim: #8a96a4;
    --amber: #f59e0b;
    --red: #ef4444;
  }

  .timelapse-page { font-family: 'Raleway', 'Cabin', sans-serif; }

  .timelapse-hero {
    background: linear-gradient(135deg, #008B74 0%, #00B794 100%);
    color: white;
    padding: 1rem 1.5rem;
    border-radius: 12px;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .timelapse-hero h1 { margin: 0; font-size: 1.25em; font-weight: 600; }
  .timelapse-hero-actions {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .timelapse-hero-actions a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: rgba(255,255,255,0.2);
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 8px;
    color: white;
    font-size: 0.9em;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }
  .timelapse-hero-actions a:hover {
    background: rgba(255,255,255,0.3);
    border-color: rgba(255,255,255,0.6);
  }
  .timelapse-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8em;
    opacity: 0.9;
  }
  .timelapse-status-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: rgba(255,255,255,0.9);
    animation: timelapse-pulse 2s ease-in-out infinite;
  }
  @keyframes timelapse-pulse { 0%,100% { opacity:1; } 50% { opacity:0.4; } }

  .timelapse-grid {
    display: grid;
    grid-template-columns: 1fr 260px;
    grid-template-rows: 1fr auto;
    gap: 0;
    min-height: 480px;
    background: var(--surface);
    border-radius: 12px;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .timelapse-viewer {
    position: relative;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    min-height: 320px;
  }
  .timelapse-viewer #canvas {
    max-width: 100%;
    max-height: 100%;
    display: block;
  }
  .timelapse-timestamp {
    position: absolute;
    bottom: 12px;
    left: 12px;
    font-size: 0.75rem;
    color: var(--accent-light);
    text-shadow: 0 0 12px rgba(0,183,148,0.6);
    pointer-events: none;
  }
  .timelapse-frame-count {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 0.7rem;
    color: var(--text-dim);
  }
  .timelapse-no-image {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .timelapse-no-image svg { opacity: 0.3; }
  .timelapse-loading {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.7);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 0.85rem;
    color: var(--text-dim);
    display: none;
  }
  .timelapse-loading.visible { display: flex; }
  .timelapse-spinner {
    width: 32px; height: 32px;
    border: 2px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: timelapse-spin 0.8s linear infinite;
  }
  @keyframes timelapse-spin { to { transform: rotate(360deg); } }

  .timelapse-sidebar {
    background: var(--surface2);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    grid-row: 1 / 3;
  }
  .timelapse-section {
    border-bottom: 1px solid var(--border);
    padding: 14px;
  }
  .timelapse-section-label {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .timelapse-range-btns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-bottom: 10px;
  }
  .timelapse-range-btn, .timelapse-speed-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-dim);
    padding: 6px 8px;
    font-size: 0.75rem;
    cursor: pointer;
    border-radius: 6px;
    transition: all 0.15s;
  }
  .timelapse-range-btn:hover, .timelapse-speed-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .timelapse-range-btn.active, .timelapse-speed-btn.active {
    background: var(--accent-bg);
    border-color: var(--accent);
    color: var(--accent);
  }
  .timelapse-date-row { margin-bottom: 8px; }
  .timelapse-date-row label {
    display: block;
    font-size: 0.65rem;
    color: var(--text-dim);
    margin-bottom: 4px;
  }
  .timelapse-date-row input {
    width: 100%;
    padding: 6px 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 0.75rem;
    border-radius: 6px;
    outline: none;
  }
  .timelapse-date-row input:focus { border-color: var(--accent); }
  .timelapse-speed-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 4px;
  }
  .timelapse-stat-row {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
    font-size: 0.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .timelapse-stat-row:last-child { border-bottom: none; }
  .timelapse-stat-key { color: var(--text-dim); }
  .timelapse-stat-val { color: var(--accent-light); }
  .timelapse-btn {
    width: 100%;
    padding: 10px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 8px;
    border: 1px solid;
    transition: all 0.2s;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .timelapse-btn-primary {
    background: var(--accent-bg);
    border-color: var(--accent);
    color: var(--accent);
  }
  .timelapse-btn-primary:hover { background: rgba(0,139,116,0.22); }
  .timelapse-btn-amber {
    background: rgba(245,158,11,0.1);
    border-color: var(--amber);
    color: var(--amber);
  }
  .timelapse-btn-amber:hover { background: rgba(245,158,11,0.2); }
  .timelapse-btn-amber:disabled { opacity: 0.4; cursor: not-allowed; }
  .timelapse-progress { margin-top: 8px; display: none; }
  .timelapse-progress.visible { display: block; }
  .timelapse-progress-bar {
    height: 4px;
    background: var(--surface);
    border-radius: 2px;
    overflow: hidden;
  }
  .timelapse-progress-fill {
    height: 100%;
    background: var(--amber);
    width: 0%;
    transition: width 0.1s;
  }
  .timelapse-progress-text { font-size: 0.7rem; color: var(--text-dim); margin-top: 4px; }

  .timelapse-controls {
    background: var(--surface2);
    border-top: 1px solid var(--border);
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .timelapse-scrubber-wrap {
    position: relative;
    height: 24px;
    display: flex;
    align-items: center;
    cursor: pointer;
  }
  .timelapse-scrubber-track {
    width: 100%;
    height: 4px;
    background: var(--surface);
    border-radius: 2px;
    position: relative;
  }
  .timelapse-scrubber-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
    transition: width 0.05s linear;
  }
  .timelapse-scrubber-fill::after {
    content: '';
    position: absolute;
    right: -6px;
    top: 50%;
    transform: translateY(-50%);
    width: 12px;
    height: 12px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--accent);
  }
  .timelapse-scrubber-wrap input[type="range"] {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    margin: 0;
  }
  .timelapse-time-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--text-dim);
    margin-top: 4px;
  }
  .timelapse-playback-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .timelapse-ctrl-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 6px;
    font-size: 0.9rem;
    transition: all 0.15s;
  }
  .timelapse-ctrl-btn:hover { border-color: var(--accent); color: var(--accent); }
  .timelapse-ctrl-btn.play-pause {
    width: 40px;
    height: 40px;
    background: var(--accent-bg);
    border-color: var(--accent);
    color: var(--accent);
    font-size: 1rem;
  }
  .timelapse-live-btn {
    margin-left: auto;
    background: transparent;
    border: 1px solid var(--text-dim);
    color: var(--text-dim);
    padding: 6px 12px;
    font-size: 0.7rem;
    cursor: pointer;
    border-radius: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s;
  }
  .timelapse-live-btn.active {
    border-color: var(--red);
    color: var(--red);
    background: rgba(239,68,68,0.1);
  }
  .timelapse-live-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }
  .timelapse-toast {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%) translateY(60px);
    background: var(--surface2);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 10px 20px;
    font-size: 0.8rem;
    border-radius: 8px;
    transition: transform 0.3s;
    z-index: 2000;
  }
  .timelapse-toast.show { transform: translateX(-50%) translateY(0); }
  .timelapse-toast.success { border-color: var(--accent); color: var(--accent); }
  .timelapse-toast.error { border-color: var(--red); color: var(--red); }
  .timelapse-config-input {
    font-size: 0.65rem;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 6px;
    color: var(--text-dim);
    width: 100%;
    border-radius: 4px;
  }
  @media (max-width: 768px) {
    .timelapse-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto;
    }
    .timelapse-sidebar { max-height: 40vh; }
    .timelapse-hero { flex-direction: column; align-items: flex-start; }
  }
</style>
{% endblock %}

{% block content %}
<div class="timelapse-page">
  <div class="timelapse-hero">
    <h1><i class="fas fa-film"></i> {{ gallery_title }}</h1>
    <div class="timelapse-hero-actions">
      <a href="{{ gallery_url }}"><i class="fas fa-images"></i> Galerie</a>
      <a href="{{ back_url }}"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
    <div class="timelapse-status">
      <span class="timelapse-status-dot"></span>
      <span id="systemStatus">EN LIGNE</span>
      <span style="opacity:0.5">|</span>
      <span id="clock">--:--:--</span>
    </div>
  </div>

  <div class="timelapse-grid">
    <div class="timelapse-viewer" id="viewer">
      <canvas id="canvas" width="800" height="600"></canvas>
      <div class="timelapse-timestamp" id="tsOverlay">--</div>
      <div class="timelapse-frame-count" id="frameCounter">0 / 0</div>
      <div class="timelapse-no-image" id="noImage">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
          <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
          <path d="M21 15l-5-5L5 21"/>
        </svg>
        <span>Aucune image chargée</span>
        <span style="font-size:0.8rem">{{ gallery_title }} — chargez une plage</span>
      </div>
      <div class="timelapse-loading" id="loadingOverlay">
        <div class="timelapse-spinner"></div>
        <span id="loadingText">Chargement...</span>
      </div>
    </div>

    <div class="timelapse-sidebar">
      <div class="timelapse-section">
        <div class="timelapse-section-label">Configuration</div>
        <input class="timelapse-config-input" id="apiUrl" type="text" value="{{ api_photos_url }}" readonly>
        <div class="timelapse-date-row" style="margin-top:8px;">
          <label style="display:inline;cursor:pointer">
            <input type="checkbox" id="demoMode" style="accent-color:var(--accent)">
            Mode démo (données simulées si aucune photo)
          </label>
        </div>
      </div>
      <div class="timelapse-section">
        <div class="timelapse-section-label">Plage temporelle</div>
        <div class="timelapse-range-btns">
          <button class="timelapse-range-btn" data-hours="6">6 h</button>
          <button class="timelapse-range-btn active" data-hours="24">24 h</button>
          <button class="timelapse-range-btn" data-hours="48">48 h</button>
          <button class="timelapse-range-btn" data-hours="168">7 j</button>
        </div>
        <div class="timelapse-date-row">
          <label>Début</label>
          <input type="datetime-local" id="dateFrom">
        </div>
        <div class="timelapse-date-row">
          <label>Fin</label>
          <input type="datetime-local" id="dateTo">
        </div>
        <button class="timelapse-btn timelapse-btn-primary" id="btnLoad">Charger la plage</button>
      </div>
      <div class="timelapse-section">
        <div class="timelapse-section-label">Vitesse</div>
        <div class="timelapse-speed-grid" style="display:grid;grid-template-columns:repeat(5,1fr);gap:4px;">
          <button class="timelapse-speed-btn" data-fps="2">½×</button>
          <button class="timelapse-speed-btn active" data-fps="12">1×</button>
          <button class="timelapse-speed-btn" data-fps="24">2×</button>
          <button class="timelapse-speed-btn" data-fps="60">4×</button>
          <button class="timelapse-speed-btn" data-fps="120">8×</button>
        </div>
        <div style="font-size:0.7rem;color:var(--text-dim);margin-top:6px;text-align:center" id="fpsLabel">12 fps</div>
      </div>
      <div class="timelapse-section">
        <div class="timelapse-section-label">Informations</div>
        <div class="timelapse-stat-row"><span class="timelapse-stat-key">Images</span><span class="timelapse-stat-val" id="statCount">0</span></div>
        <div class="timelapse-stat-row"><span class="timelapse-stat-key">Durée réelle</span><span class="timelapse-stat-val" id="statDuration">--</span></div>
        <div class="timelapse-stat-row"><span class="timelapse-stat-key">Durée vidéo</span><span class="timelapse-stat-val" id="statVideoDur">--</span></div>
        <div class="timelapse-stat-row"><span class="timelapse-stat-key">Image actuelle</span><span class="timelapse-stat-val" id="statCurrent">--</span></div>
        <div class="timelapse-stat-row"><span class="timelapse-stat-key">Intervalle moy.</span><span class="timelapse-stat-val" id="statInterval">--</span></div>
      </div>
      <div class="timelapse-section">
        <div class="timelapse-section-label">Export vidéo</div>
        <div class="timelapse-date-row"><label>Début export</label><input type="datetime-local" id="exportFrom"></div>
        <div class="timelapse-date-row" style="margin-bottom:10px"><label>Fin export</label><input type="datetime-local" id="exportTo"></div>
        <button class="timelapse-btn timelapse-btn-amber" id="btnExport" disabled>Générer vidéo WebM</button>
        <div class="timelapse-progress" id="exportProgress">
          <div class="timelapse-progress-bar"><div class="timelapse-progress-fill" id="exportFill"></div></div>
          <div class="timelapse-progress-text" id="exportText">Encodage...</div>
        </div>
      </div>
    </div>

    <div class="timelapse-controls">
      <div>
        <div class="timelapse-scrubber-wrap" id="scrubberWrap">
          <div class="timelapse-scrubber-track">
            <div class="timelapse-scrubber-fill" id="scrubberFill" style="width:0%"></div>
          </div>
          <input type="range" id="scrubber" min="0" max="100" value="0" step="1">
        </div>
        <div class="timelapse-time-labels">
          <span id="timeStart">--</span>
          <span id="timeCurrent" style="color:var(--accent)">--</span>
          <span id="timeEnd">--</span>
        </div>
      </div>
      <div class="timelapse-playback-row">
        <button class="timelapse-ctrl-btn" id="btnFirst" title="Première image">⏮</button>
        <button class="timelapse-ctrl-btn" id="btnPrev" title="Image précédente">◀</button>
        <button class="timelapse-ctrl-btn play-pause" id="btnPlay" title="Lecture/Pause">▶</button>
        <button class="timelapse-ctrl-btn" id="btnNext" title="Image suivante">▶</button>
        <button class="timelapse-ctrl-btn" id="btnLast" title="Dernière image">⏭</button>
        <button class="timelapse-live-btn" id="btnLive"><span class="timelapse-live-dot"></span>Dernière image</button>
      </div>
    </div>
  </div>
</div>
<div class="timelapse-toast" id="toast"></div>
{% endblock %}

{% block scripts %}
<script>
const CONFIG = { defaultFps: 12, bufferSize: 40, preloadAhead: 20 };
let state = { frames: [], currentIndex: 0, fps: CONFIG.defaultFps, isPlaying: false, playInterval: null, isLive: false, liveTimer: null, totalLoaded: 0, recording: false, mediaRecorder: null, recordedChunks: [] };
const BASE = '{{ base_path|default('') }}';
function ensureAbsoluteUrl(url) {
  if (!url || url.startsWith('http') || url.startsWith('//')) return url;
  const base = (BASE && !BASE.startsWith('/') ? '/' : '') + (BASE ? BASE.replace(/\/$/, '') + '/' : '');
  return (base || '/') + url.replace(/^\//, '');
}
function generateDemoFrames(fromDate, toDate) {
  const frames = [];
  let t = fromDate.getTime();
  let i = 0;
  const interval = 5 * 60 * 1000;
  while (t <= toDate.getTime()) {
    frames.push({ url: null, timestamp: new Date(t), demoIndex: i++ });
    t += interval + Math.random() * 30000;
  }
  return frames;
}
function drawDemoFrame(frame, c) {
  const ctx = c.getContext('2d');
  const W = c.width, H = c.height;
  const t = frame.timestamp;
  const dayProgress = (t.getHours() * 60 + t.getMinutes()) / (24 * 60);
  const lum = Math.sin(dayProgress * Math.PI);
  const r = Math.round(20 + lum * 40), g = Math.round(30 + lum * 60), b = Math.round(20 + lum * 30);
  ctx.fillStyle = `rgb(${r},${g},${b})`;
  ctx.fillRect(0, 0, W, H);
  ctx.strokeStyle = `rgba(${60+lum*80},${80+lum*100},${40+lum*60},0.4)`;
  ctx.lineWidth = 1;
  for (let y = 0; y < H; y += 30) { ctx.beginPath(); ctx.moveTo(0, y + Math.sin(y*0.1)*5); ctx.lineTo(W, y + Math.cos(y*0.07)*8); ctx.stroke(); }
  const seed = frame.demoIndex % 7;
  for (let p = 0; p < 8; p++) {
    const px = ((p * 137 + seed * 91) % W);
    const py = H - 20 - ((p * 73 + seed * 53) % (H/2));
    ctx.strokeStyle = `rgba(${50+lum*100},${120+lum*100},${40+lum*60},0.7)`;
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(px, H-10); ctx.lineTo(px, py); ctx.stroke();
    ctx.beginPath(); ctx.ellipse(px, py, 8, 4, -0.3, 0, Math.PI*2);
    ctx.fillStyle = `rgba(${40+lum*80},${100+lum*120},${30+lum*50},0.6)`;
    ctx.fill();
  }
  ctx.fillStyle = 'rgba(0,0,0,0.35)';
  ctx.fillRect(0, H-40, W, 40);
  ctx.font = '13px Raleway';
  ctx.fillStyle = '#00B794';
  ctx.fillText(`n³ · FRAME ${String(frame.demoIndex).padStart(4,'0')} · DEMO`, 12, H-14);
}
async function fetchFrames(from, to) {
  if (document.getElementById('demoMode').checked) return generateDemoFrames(from, to);
  const apiUrl = document.getElementById('apiUrl').value;
  const url = apiUrl + '?from=' + encodeURIComponent(from.toISOString()) + '&to=' + encodeURIComponent(to.toISOString());
  const resp = await fetch(url);
  if (!resp.ok) throw new Error('HTTP ' + resp.status);
  const data = await resp.json();
  return data.map(d => ({ url: ensureAbsoluteUrl(d.url), timestamp: new Date(d.timestamp) }));
}
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
function renderFrame(frame) {
  if (!frame) return;
  const demoMode = document.getElementById('demoMode').checked;
  if (demoMode || !frame.img) { drawDemoFrame(frame, canvas); } else { try { ctx.drawImage(frame.img, 0, 0, canvas.width, canvas.height); } catch(e) {} }
  document.getElementById('noImage').style.display = 'none';
  document.getElementById('tsOverlay').textContent = frame.timestamp.toLocaleDateString('fr-FR') + ' · ' + frame.timestamp.toLocaleTimeString('fr-FR');
  document.getElementById('frameCounter').textContent = (state.currentIndex + 1) + ' / ' + state.frames.length;
  updateScrubber();
  updateStats();
}
async function preloadImage(frame) {
  if (frame.img || !frame.url) return;
  return new Promise(resolve => {
    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = () => { frame.img = img; resolve(); };
    img.onerror = () => resolve();
    img.src = frame.url;
  });
}
async function preloadAround(idx) {
  const start = Math.max(0, idx - 5);
  const end = Math.min(state.frames.length - 1, idx + CONFIG.preloadAhead);
  for (let i = start; i <= end; i++) await preloadImage(state.frames[i]);
}
function startPlay() {
  if (state.frames.length === 0) return;
  state.isPlaying = true;
  document.getElementById('btnPlay').textContent = '⏸';
  state.playInterval = setInterval(() => {
    state.currentIndex = state.currentIndex >= state.frames.length - 1 ? 0 : state.currentIndex + 1;
    renderFrame(state.frames[state.currentIndex]);
    preloadAround(state.currentIndex);
  }, 1000 / state.fps);
}
function stopPlay() { state.isPlaying = false; document.getElementById('btnPlay').textContent = '▶'; clearInterval(state.playInterval); }
function goTo(idx) {
  state.currentIndex = Math.max(0, Math.min(state.frames.length - 1, idx));
  renderFrame(state.frames[state.currentIndex]);
  preloadAround(state.currentIndex);
}
async function loadRange() {
  const from = new Date(document.getElementById('dateFrom').value);
  const to = new Date(document.getElementById('dateTo').value);
  if (isNaN(from) || isNaN(to) || from >= to) { showToast('Plage invalide', 'error'); return; }
  stopPlay();
  showLoading('Récupération des métadonnées...');
  try {
    const rawFrames = await fetchFrames(from, to);
    if (rawFrames.length === 0) { showToast('Aucune image dans cette plage', 'error'); hideLoading(); return; }
    state.frames = rawFrames;
    state.currentIndex = 0;
    document.getElementById('btnExport').disabled = false;
    document.getElementById('exportFrom').value = document.getElementById('dateFrom').value;
    document.getElementById('exportTo').value = document.getElementById('dateTo').value;
    updateTimeLabels();
    updateStats();
    showLoading('Préchargement...');
    await preloadAround(0);
    hideLoading();
    renderFrame(state.frames[0]);
    showToast(rawFrames.length + ' images chargées', 'success');
    if (document.getElementById('demoMode').checked) startPlay();
  } catch(e) { hideLoading(); showToast('Erreur: ' + e.message, 'error'); }
}
function setDateRange(hours) {
  const to = new Date();
  const from = new Date(to.getTime() - hours * 3600000);
  const toLocal = d => { const off = d.getTimezoneOffset(); const local = new Date(d.getTime() - off * 60000); return local.toISOString().slice(0, 16); };
  document.getElementById('dateFrom').value = toLocal(from);
  document.getElementById('dateTo').value = toLocal(to);
}
function updateScrubber() {
  const pct = state.frames.length > 1 ? (state.currentIndex / (state.frames.length - 1)) * 100 : 0;
  document.getElementById('scrubberFill').style.width = pct + '%';
  document.getElementById('scrubber').value = pct;
  const f = state.frames[state.currentIndex];
  if (f) document.getElementById('timeCurrent').textContent = f.timestamp.toLocaleTimeString('fr-FR');
}
function updateTimeLabels() {
  if (state.frames.length === 0) return;
  const first = state.frames[0].timestamp, last = state.frames[state.frames.length-1].timestamp;
  document.getElementById('timeStart').textContent = first.toLocaleDateString('fr-FR', {day:'2-digit',month:'2-digit'}) + ' ' + first.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});
  document.getElementById('timeEnd').textContent = last.toLocaleDateString('fr-FR', {day:'2-digit',month:'2-digit'}) + ' ' + last.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});
}
function updateStats() {
  const n = state.frames.length;
  document.getElementById('statCount').textContent = n;
  if (n < 2) return;
  const first = state.frames[0].timestamp, last = state.frames[n-1].timestamp;
  const durMs = last - first;
  document.getElementById('statDuration').textContent = (Math.floor(durMs/3600000) > 0 ? Math.floor(durMs/3600000) + 'h ' : '') + Math.floor((durMs%3600000)/60000) + ' min';
  const videoDurS = n / state.fps;
  document.getElementById('statVideoDur').textContent = videoDurS > 60 ? Math.floor(videoDurS/60) + 'm ' + Math.round(videoDurS%60) + 's' : videoDurS.toFixed(1) + 's';
  const avgMs = durMs / (n - 1);
  document.getElementById('statInterval').textContent = (Math.floor(avgMs/60000) > 0 ? Math.floor(avgMs/60000) + 'm ' : '') + Math.round((avgMs%60000)/1000) + 's';
  const f = state.frames[state.currentIndex];
  if (f) document.getElementById('statCurrent').textContent = f.timestamp.toLocaleTimeString('fr-FR');
}
function toggleLive() {
  state.isLive = !state.isLive;
  document.getElementById('btnLive').classList.toggle('active', state.isLive);
  if (state.isLive) {
    if (state.frames.length > 0) { stopPlay(); goTo(state.frames.length - 1); }
    state.liveTimer = setInterval(async () => {
      try {
        const lastTs = state.frames.length > 0 ? state.frames[state.frames.length-1].timestamp : new Date(Date.now() - 3600000);
        const newFrames = await fetchFrames(lastTs, new Date());
        if (newFrames.length > 1) { state.frames.push(...newFrames.slice(1)); updateTimeLabels(); updateStats(); }
        goTo(state.frames.length - 1);
      } catch(e) {}
    }, 60000);
  } else clearInterval(state.liveTimer);
}
async function exportVideo() {
  if (state.frames.length === 0) return;
  const exportFrom = new Date(document.getElementById('exportFrom').value);
  const exportTo = new Date(document.getElementById('exportTo').value);
  let exportFrames = state.frames.filter(f => f.timestamp >= exportFrom && f.timestamp <= exportTo);
  if (exportFrames.length === 0) { showToast('Aucune image dans la plage export', 'error'); return; }
  const demoMode = document.getElementById('demoMode').checked;
  if (!demoMode) { showExportProgress(0, 'Préchargement...'); for (let i = 0; i < exportFrames.length; i++) { await preloadImage(exportFrames[i]); if (i % 10 === 0) showExportProgress((i/exportFrames.length)*40, 'Chargement...'); } }
  const exportCanvas = document.createElement('canvas');
  exportCanvas.width = canvas.width;
  exportCanvas.height = canvas.height;
  const exportCtx = exportCanvas.getContext('2d');
  let stream;
  try { stream = exportCanvas.captureStream(state.fps); } catch(e) { showToast('MediaRecorder non supporté', 'error'); return; }
  const mimeType = ['video/webm;codecs=vp9','video/webm;codecs=vp8','video/webm'].find(m => MediaRecorder.isTypeSupported(m)) || 'video/webm';
  state.recordedChunks = [];
  state.mediaRecorder = new MediaRecorder(stream, { mimeType, videoBitsPerSecond: 4000000 });
  state.mediaRecorder.ondataavailable = e => { if (e.data.size > 0) state.recordedChunks.push(e.data); };
  state.mediaRecorder.onstop = () => { const blob = new Blob(state.recordedChunks, { type: mimeType }); const url = URL.createObjectURL(blob); const a = document.createElement('a'); a.href = url; a.download = 'n3-timelapse-' + new Date().toISOString().slice(0,10) + '.webm'; a.click(); URL.revokeObjectURL(url); state.recording = false; document.getElementById('btnExport').disabled = false; hideExportProgress(); showToast('Vidéo générée (' + (blob.size/1024/1024).toFixed(1) + ' Mo)', 'success'); };
  state.mediaRecorder.start();
  document.getElementById('btnExport').disabled = true;
  state.recording = true;
  const frameInterval = 1000 / state.fps;
  for (let i = 0; i < exportFrames.length; i++) {
    const frame = exportFrames[i];
    if (demoMode) drawDemoFrame(frame, exportCanvas);
    else if (frame.img) exportCtx.drawImage(frame.img, 0, 0, exportCanvas.width, exportCanvas.height);
    else { exportCtx.fillStyle = '#1e252d'; exportCtx.fillRect(0, 0, exportCanvas.width, exportCanvas.height); }
    exportCtx.fillStyle = 'rgba(0,0,0,0.5)';
    exportCtx.fillRect(0, exportCanvas.height - 30, exportCanvas.width, 30);
    exportCtx.font = '12px Raleway';
    exportCtx.fillStyle = '#00B794';
    exportCtx.fillText('n³ · ' + frame.timestamp.toLocaleDateString('fr-FR') + ' ' + frame.timestamp.toLocaleTimeString('fr-FR'), 10, exportCanvas.height - 10);
    showExportProgress(40 + (i / exportFrames.length) * 55, 'Encodage ' + (i+1) + '/' + exportFrames.length);
    await new Promise(r => setTimeout(r, frameInterval));
  }
  state.mediaRecorder.stop();
  showExportProgress(100, 'Finalisation...');
}
function showExportProgress(pct, text) { document.getElementById('exportProgress').classList.add('visible'); document.getElementById('exportFill').style.width = pct + '%'; document.getElementById('exportText').textContent = text; }
function hideExportProgress() { setTimeout(() => document.getElementById('exportProgress').classList.remove('visible'), 2000); }
function showLoading(text) { document.getElementById('loadingText').textContent = text; document.getElementById('loadingOverlay').classList.add('visible'); }
function hideLoading() { document.getElementById('loadingOverlay').classList.remove('visible'); }
function showToast(msg, type) { const t = document.getElementById('toast'); t.textContent = msg; t.className = 'timelapse-toast ' + type + ' show'; setTimeout(() => t.classList.remove('show'), 3500); }
function updateClock() { document.getElementById('clock').textContent = new Date().toLocaleTimeString('fr-FR'); }
setInterval(updateClock, 1000); updateClock();
document.addEventListener('DOMContentLoaded', () => {
  setDateRange(24);
  document.querySelectorAll('.timelapse-range-btn').forEach(btn => { btn.addEventListener('click', () => { document.querySelectorAll('.timelapse-range-btn').forEach(b => b.classList.remove('active')); btn.classList.add('active'); setDateRange(parseInt(btn.dataset.hours)); }); });
  document.querySelectorAll('.timelapse-speed-btn').forEach(btn => { btn.addEventListener('click', () => { document.querySelectorAll('.timelapse-speed-btn').forEach(b => b.classList.remove('active')); btn.classList.add('active'); state.fps = parseInt(btn.dataset.fps); document.getElementById('fpsLabel').textContent = state.fps + ' fps'; if (state.isPlaying) { stopPlay(); startPlay(); } updateStats(); }); });
  document.getElementById('btnLoad').addEventListener('click', loadRange);
  document.getElementById('btnPlay').addEventListener('click', () => { if (state.isPlaying) stopPlay(); else startPlay(); });
  document.getElementById('btnFirst').addEventListener('click', () => { stopPlay(); goTo(0); });
  document.getElementById('btnLast').addEventListener('click', () => { stopPlay(); goTo(state.frames.length - 1); });
  document.getElementById('btnPrev').addEventListener('click', () => { stopPlay(); goTo(state.currentIndex - 1); });
  document.getElementById('btnNext').addEventListener('click', () => { stopPlay(); goTo(state.currentIndex + 1); });
  document.getElementById('scrubber').addEventListener('input', e => { stopPlay(); const pct = parseFloat(e.target.value) / 100; goTo(Math.round(pct * (state.frames.length - 1))); });
  document.getElementById('btnLive').addEventListener('click', toggleLive);
  document.getElementById('btnExport').addEventListener('click', exportVideo);
  document.addEventListener('keydown', e => {
    if (e.target.tagName === 'INPUT') return;
    if (e.code === 'Space') { e.preventDefault(); if (state.isPlaying) stopPlay(); else startPlay(); }
    if (e.code === 'ArrowLeft') { stopPlay(); goTo(state.currentIndex - 1); }
    if (e.code === 'ArrowRight') { stopPlay(); goTo(state.currentIndex + 1); }
    if (e.code === 'Home') { stopPlay(); goTo(0); }
    if (e.code === 'End') { stopPlay(); goTo(state.frames.length - 1); }
  });
  function resizeCanvas() {
    const viewer = document.getElementById('viewer');
    const ratio = 4/3;
    const vw = viewer.clientWidth, vh = viewer.clientHeight;
    let w = vw, h = vw / ratio;
    if (h > vh) { h = vh; w = h * ratio; }
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
  }
  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();
});
</script>
{% endblock %}

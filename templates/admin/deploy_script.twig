{% extends 'layout_base.twig' %}

{% block page_title %}n3 IoT — Script de déploiement{% endblock %}

{% block content %}
<style>
    .deploy-container {
        background: var(--card-bg, #fff);
        padding: 24px;
        border-radius: 12px;
        box-shadow: var(--card-shadow, 0 2px 10px rgba(0,0,0,.08));
        max-width: 960px;
        margin: 24px auto;
    }
    .deploy-container h1 {
        color: var(--accent-color, #008B74);
        border-bottom: 3px solid var(--accent-color, #008B74);
        padding-bottom: 10px;
        margin-top: 0;
    }
    .deploy-hint { color: #6c757d; margin: 12px 0; font-size: .95em; }
    .deploy-pre {
        background: #1e1e1e;
        color: #d4d4d4;
        padding: 16px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 13px;
        line-height: 1.4;
        white-space: pre;
    }
    .deploy-btn {
        display: inline-block;
        padding: 10px 20px;
        background: var(--accent-color, #008B74);
        color: #fff;
        border-radius: 8px;
        text-decoration: none;
        margin-top: 16px;
        font-weight: 600;
    }
</style>

<div class="deploy-container">
    <h1>Script de déploiement (DEPLOY_NOW.sh)</h1>

    {% if missing %}
        <p class="deploy-hint">Fichier <code>DEPLOY_NOW.sh</code> introuvable à l'emplacement attendu (<code>{{ expected_path }}</code>).</p>
    {% else %}
        <p class="deploy-hint">
            À exécuter sur le serveur via SSH (ex.&nbsp;:
            <code>cd /home4/oliviera/iot.olution.info/ffp3 &amp;&amp; bash DEPLOY_NOW.sh</code>).
            Ne pas exécuter depuis le navigateur.
        </p>
        <pre class="deploy-pre">{{ script_content }}</pre>
    {% endif %}

    <a href="/supervision" class="deploy-btn">Retour à la supervision</a>
</div>
{% endblock %}

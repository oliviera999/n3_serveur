<!DOCTYPE HTML>
<html lang="fr">
<head>
    <title>{{ page_title }}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
    <meta name="theme-color" content="#008B74" />
    <link rel="stylesheet" href="{{ base_path }}/assets/css/main.css" />
    <link rel="stylesheet" href="{{ base_path }}/assets/css/realtime-styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" />
    <link rel="shortcut icon" type="image/png" href="{{ base_path }}/assets/logo.png"/>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://code.highcharts.com/stock/highstock.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script src="https://code.highcharts.com/modules/export-data.js"></script>
    <script src="https://code.highcharts.com/modules/accessibility.js"></script>
    <style>
        .modern-header { background: linear-gradient(145deg, #008B74 0%, #007A61 25%, #00B794 50%, #008B74 100%); color: white; padding: 48px 0; margin: -20px -20px 20px -20px; position: relative; overflow: hidden; border-radius: 0 0 16px 16px; }
        .modern-header::before { content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="g" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="0.5"/></pattern></defs><rect width="100" height="100" fill="url(%23g)"/></svg>'); opacity: 0.2; }
        .header-content { position: relative; z-index: 2; text-align: center; max-width: 1200px; margin: 0 auto; padding: 0 20px; }
        .header-title { font-size: 2.2em; font-weight: bold; margin: 0 0 12px 0; text-shadow: 0 1px 2px rgba(0,0,0,0.2); display: flex; align-items: center; justify-content: center; gap: 15px; }
        .header-subtitle { font-size: 1.1em; margin: 0; opacity: 0.9; font-weight: 300; }
        .header-synthesis { display: inline-block; font-size: 0.92em; margin: 12px 0 0 0; padding: 8px 16px; background: rgba(255,255,255,0.18); border-radius: 10px; border: 1px solid rgba(255,255,255,0.25); color: white; }
        .section-header { display: flex; align-items: center; gap: 16px; margin: 35px 0 18px 0; padding-bottom: 10px; border-bottom: 3px solid #008B74; position: relative; }
        .section-header::after { content: ''; position: absolute; bottom: -3px; left: 0; width: 60px; height: 3px; background: #00B794; border-radius: 2px; }
        .section-header h3 { margin: 0; color: #008B74; font-size: 1.4em; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
        .section-header i { font-size: 1.6em; color: #008B74; padding: 8px; background: rgba(0,139,116,0.1); border-radius: 10px; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(155px, 1fr)); gap: 16px; margin: 16px 0; }
        .stat-card { background: white; border-radius: 14px; padding: 18px; box-shadow: 0 3px 16px rgba(0,139,116,0.1); text-align: center; transition: all 0.3s ease; border: 1px solid rgba(0,139,116,0.08); position: relative; overflow: hidden; }
        .stat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #008B74, #00B794); transform: scaleX(0); transition: transform 0.3s ease; }
        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,139,116,0.18); }
        .stat-card:hover::before { transform: scaleX(1); }
        .stat-card-icon { font-size: 2.2em; margin-bottom: 8px; display: block; }
        .stat-card-value { font-size: 1.8em; font-weight: bold; color: #2c3e50; margin: 8px 0; line-height: 1; }
        .stat-card-label { font-size: 0.85em; color: #7f8c8d; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; }
        .stat-card-unit { font-size: 0.65em; color: #95a5a6; font-weight: 400; }
        .stat-card-secondary { font-size: 0.75em; color: #6c757d; margin-top: 6px; line-height: 1.3; }
        .stat-card.temp { border-left: 5px solid #e74c3c; background: linear-gradient(180deg, #fff 0%, #fef5f1 100%); }
        .stat-card.temp .stat-card-icon { color: #e74c3c; }
        .stat-card.humidity { border-left: 5px solid #3498db; background: linear-gradient(180deg, #fff 0%, #f4f8fb 100%); }
        .stat-card.humidity .stat-card-icon { color: #3498db; }
        .stat-card.light { border-left: 5px solid #f39c12; background: linear-gradient(180deg, #fff 0%, #fef9f3 100%); }
        .stat-card.light .stat-card-icon { color: #f39c12; }
        .stat-card.water { border-left: 5px solid #008B74; background: linear-gradient(180deg, #fff 0%, #f0faf8 100%); }
        .stat-card.water .stat-card-icon { color: #008B74; }
        .stat-card.rain { border-left: 5px solid #9b59b6; background: linear-gradient(180deg, #fff 0%, #f8f4fb 100%); }
        .stat-card.rain .stat-card-icon { color: #9b59b6; }
        .stat-card.system { border-left: 5px solid #95a5a6; background: linear-gradient(180deg, #fff 0%, #f8f9fa 100%); }
        .stat-card.system .stat-card-icon { color: #95a5a6; }
        .filter-section { background: white; border-radius: 16px; padding: 20px; margin: 20px 0; box-shadow: 0 3px 16px rgba(0,139,116,0.08); border-top: 5px solid #008B74; }
        .filter-section h3 { margin: 0 0 14px 0; color: #008B74; font-size: 1.1em; }
        .filter-section form { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
        .filter-section label { font-size: 0.85em; color: #555; display: block; margin-bottom: 4px; }
        .filter-section input[type="datetime-local"] { padding: 8px 12px; border: 1px solid #ddd; border-radius: 8px; font-size: 0.9em; }
        .filter-section .btn { padding: 8px 18px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 0.9em; }
        .filter-section .btn-primary { background: #008B74; color: white; }
        .filter-section .btn-primary:hover { background: #007A61; }
        .filter-section .btn-secondary { background: #6c757d; color: white; }
        .filter-section .btn-secondary:hover { background: #5a6268; }
        .quick-filters { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
        .quick-filter-btn { padding: 5px 12px; background: rgba(0,139,116,0.1); border: 1px solid rgba(0,139,116,0.2); border-radius: 20px; cursor: pointer; font-size: 0.82em; font-weight: 600; color: #008B74; transition: all 0.2s; }
        .quick-filter-btn:hover { background: #008B74; color: white; }
        .period-info { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 12px; font-size: 0.88em; color: #555; }
        .period-info span { background: rgba(0,139,116,0.08); padding: 4px 10px; border-radius: 8px; }
        .chart-container { background: white; border-radius: 16px; padding: 14px; margin: 20px 0; box-shadow: 0 3px 16px rgba(0,139,116,0.08); min-height: 350px; }
        .chart-container-title { font-size: 1.1em; font-weight: bold; color: #2c3e50; margin: 0 0 10px 0; padding-left: 8px; border-left: 4px solid #008B74; }
        .system-health-panel { background: white; border-radius: 16px; padding: 18px; box-shadow: 0 3px 16px rgba(0,139,116,0.08); border-top: 5px solid #008B74; margin: 20px 0; }
        .system-health-panel h3 { margin: 0 0 12px 0; color: #008B74; }
        .health-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
        .health-item { background: #f8f9fa; padding: 10px; border-radius: 10px; text-align: center; }
        .health-item-label { font-size: 0.8em; color: #7f8c8d; text-transform: uppercase; margin-bottom: 4px; }
        .health-item-value { font-size: 1.15em; font-weight: bold; color: #2c3e50; }
        .data-table-wrap { background: white; border-radius: 16px; overflow: hidden; box-shadow: 0 3px 16px rgba(0,139,116,0.08); margin: 20px 0; }
        .data-table-wrap table { width: 100%; border-collapse: collapse; font-size: 0.88em; }
        .data-table-wrap th, .data-table-wrap td { padding: 10px 12px; text-align: left; border-bottom: 1px solid #eee; }
        .data-table-wrap th { background: #008B74; color: white; font-size: 0.82em; position: sticky; top: 0; }
        .data-table-wrap tr:hover { background: #f8f9fa; }
        .data-table-wrap { max-height: 500px; overflow-y: auto; }
        .no-data { text-align: center; padding: 50px 20px; color: #7f8c8d; background: white; border-radius: 16px; }
        .iframes-section { margin: 20px 0; }
        .iframes-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
        .iframe-card { background: white; border-radius: 16px; overflow: hidden; box-shadow: 0 3px 16px rgba(0,139,116,0.08); }
        .iframe-card iframe { width: 100%; height: 350px; border: none; }
        #footer { text-align: center; padding: 1.5rem 2rem; margin-top: 2rem; color: #6c757d; font-size: 0.9em; border-top: 1px solid rgba(0,139,116,0.15); background: rgba(255,255,255,0.92); }
        .context-badges { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-bottom: 1rem; }
        .context-badge { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px; font-size: 0.82em; font-weight: 600; background: rgba(0,0,0,0.05); color: #666; border: 1px solid rgba(0,0,0,0.1); }
        @media (max-width: 768px) {
            .header-title { font-size: 1.6em; flex-direction: column; gap: 8px; }
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .health-grid { grid-template-columns: 1fr 1fr; }
            .filter-section form { flex-direction: column; }
        }
    </style>
</head>
<body class="is-preload">
    <div id="page-bg" aria-hidden="true"></div>
    <div id="wrapper" class="fade-in">
        <header id="header">
            <a href="/" class="logo"><img src="{{ base_path }}/assets/logo.png" alt="n3 iot datas" /><span class="logo-text">IOT</span></a>
        </header>
        {% include 'partials/_nav.twig' with { nav_active: 'potager', environment: environment|default('prod') } %}

        <div id="main">
            {# ===== HERO ===== #}
            <div class="modern-header">
                <div class="header-content">
                    <div class="header-title">
                        <i class="fas fa-sun" aria-hidden="true"></i>
                        Le potager – Station météo
                    </div>
                    <p class="header-subtitle">Supervision des capteurs de la station météo (température, humidité, luminosité, eau, pluie).</p>
                    <p class="header-synthesis">📊 Synthèse du {{ start_date|date('d/m/Y H:i') }} au {{ end_date|date('d/m/Y H:i') }} — {{ measure_count }} mesures — {{ duration_str }}</p>
                </div>
            </div>

            <article class="post featured">

                {% if latest %}
                    {# ===== DERNIÈRE MESURE ===== #}
                    <div class="section-header">
                        <i class="fas fa-chart-line"></i>
                        <h3>Dernière mesure</h3>
                    </div>
                    <div class="stats-grid">
                        {% if latest.TempAirInt is defined and latest.TempAirInt is not null %}
                        <div class="stat-card temp">
                            <i class="fas fa-thermometer-half stat-card-icon"></i>
                            <div class="stat-card-label">Temp. air int.</div>
                            <div class="stat-card-value">{{ latest.TempAirInt|number_format(1) }} <span class="stat-card-unit">°C</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_tempAirInt is defined and avg_tempAirInt ? avg_tempAirInt|number_format(1) : '-' }} | Min: {{ min_tempAirInt is defined and min_tempAirInt ? min_tempAirInt|number_format(1) : '-' }} | Max: {{ max_tempAirInt is defined and max_tempAirInt ? max_tempAirInt|number_format(1) : '-' }}</div>
                        </div>
                        {% endif %}
                        {% if latest.TempAirExt is defined and latest.TempAirExt is not null %}
                        <div class="stat-card temp">
                            <i class="fas fa-temperature-low stat-card-icon"></i>
                            <div class="stat-card-label">Temp. air ext.</div>
                            <div class="stat-card-value">{{ latest.TempAirExt|number_format(1) }} <span class="stat-card-unit">°C</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_tempAirExt is defined and avg_tempAirExt ? avg_tempAirExt|number_format(1) : '-' }} | Min: {{ min_tempAirExt is defined and min_tempAirExt ? min_tempAirExt|number_format(1) : '-' }} | Max: {{ max_tempAirExt is defined and max_tempAirExt ? max_tempAirExt|number_format(1) : '-' }}</div>
                        </div>
                        {% endif %}
                        {% if latest.HumidAirInt is defined and latest.HumidAirInt is not null %}
                        <div class="stat-card humidity">
                            <i class="fas fa-tint stat-card-icon"></i>
                            <div class="stat-card-label">Humid. air int.</div>
                            <div class="stat-card-value">{{ latest.HumidAirInt|number_format(0) }} <span class="stat-card-unit">%</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_humidAirInt is defined and avg_humidAirInt ? avg_humidAirInt|number_format(0) : '-' }}% | Min: {{ min_humidAirInt is defined and min_humidAirInt ? min_humidAirInt|number_format(0) : '-' }}% | Max: {{ max_humidAirInt is defined and max_humidAirInt ? max_humidAirInt|number_format(0) : '-' }}%</div>
                        </div>
                        {% endif %}
                        {% if latest.HumidAirExt is defined and latest.HumidAirExt is not null %}
                        <div class="stat-card humidity">
                            <i class="fas fa-cloud stat-card-icon"></i>
                            <div class="stat-card-label">Humid. air ext.</div>
                            <div class="stat-card-value">{{ latest.HumidAirExt|number_format(0) }} <span class="stat-card-unit">%</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_humidAirExt is defined and avg_humidAirExt ? avg_humidAirExt|number_format(0) : '-' }}% | Min: {{ min_humidAirExt is defined and min_humidAirExt ? min_humidAirExt|number_format(0) : '-' }}% | Max: {{ max_humidAirExt is defined and max_humidAirExt ? max_humidAirExt|number_format(0) : '-' }}%</div>
                        </div>
                        {% endif %}
                        {% if latest.LuminositeMoy is defined and latest.LuminositeMoy is not null %}
                        <div class="stat-card light">
                            <i class="fas fa-sun stat-card-icon"></i>
                            <div class="stat-card-label">Luminosité moy.</div>
                            <div class="stat-card-value">{{ latest.LuminositeMoy|number_format(0) }}</div>
                            <div class="stat-card-secondary">Moy: {{ avg_luminositeMoy is defined and avg_luminositeMoy ? avg_luminositeMoy|number_format(0) : '-' }} | Min: {{ min_luminositeMoy is defined and min_luminositeMoy ? min_luminositeMoy|number_format(0) : '-' }} | Max: {{ max_luminositeMoy is defined and max_luminositeMoy ? max_luminositeMoy|number_format(0) : '-' }}</div>
                        </div>
                        {% endif %}
                        {% if latest.TempEau is defined and latest.TempEau is not null %}
                        <div class="stat-card water">
                            <i class="fas fa-water stat-card-icon"></i>
                            <div class="stat-card-label">Temp. eau</div>
                            <div class="stat-card-value">{{ latest.TempEau|number_format(1) }} <span class="stat-card-unit">°C</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_tempEau is defined and avg_tempEau ? avg_tempEau|number_format(1) : '-' }} | Min: {{ min_tempEau is defined and min_tempEau ? min_tempEau|number_format(1) : '-' }} | Max: {{ max_tempEau is defined and max_tempEau ? max_tempEau|number_format(1) : '-' }}</div>
                        </div>
                        {% endif %}
                        {% if latest.HumidSol is defined and latest.HumidSol is not null %}
                        <div class="stat-card humidity">
                            <i class="fas fa-seedling stat-card-icon"></i>
                            <div class="stat-card-label">Humid. sol</div>
                            <div class="stat-card-value">{{ latest.HumidSol|number_format(0) }} <span class="stat-card-unit">%</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_humidSol is defined and avg_humidSol ? avg_humidSol|number_format(0) : '-' }}% | Min: {{ min_humidSol is defined and min_humidSol ? min_humidSol|number_format(0) : '-' }}% | Max: {{ max_humidSol is defined and max_humidSol ? max_humidSol|number_format(0) : '-' }}%</div>
                        </div>
                        {% endif %}
                        {% if latest.Pluie is defined and latest.Pluie is not null %}
                        <div class="stat-card rain">
                            <i class="fas fa-cloud-rain stat-card-icon"></i>
                            <div class="stat-card-label">Pluie</div>
                            <div class="stat-card-value">{{ latest.Pluie|number_format(0) }}</div>
                            <div class="stat-card-secondary">Moy: {{ avg_pluie is defined and avg_pluie ? avg_pluie|number_format(0) : '-' }} | Min: {{ min_pluie is defined and min_pluie ? min_pluie|number_format(0) : '-' }} | Max: {{ max_pluie is defined and max_pluie ? max_pluie|number_format(0) : '-' }}</div>
                        </div>
                        {% endif %}
                    </div>
                    {% if latest.sensor is defined %}<p style="font-size:0.9em;color:#7f8c8d;">Capteur : {{ latest.sensor|default('-') }} | Firmware : {{ latest.version|default('-') }}</p>{% endif %}
                {% else %}
                    <div class="no-data"><i class="fas fa-database" style="font-size:2em;margin-bottom:10px;color:#bbb;"></i><br>Aucune donnée enregistrée.</div>
                {% endif %}

                {# ===== GRAPHIQUES ===== #}
                {% if measure_count > 0 %}
                <div class="section-header">
                    <i class="fas fa-chart-area"></i>
                    <h3>Graphiques</h3>
                </div>

                <div class="chart-container">
                    <p class="chart-container-title"><i class="fas fa-thermometer-half"></i> Températures & Humidité</p>
                    <div id="chart-temperatures" style="min-height:350px;"></div>
                </div>

                <div class="chart-container">
                    <p class="chart-container-title"><i class="fas fa-sun"></i> Luminosité</p>
                    <div id="chart-lights" style="min-height:350px;"></div>
                </div>

                <div class="chart-container">
                    <p class="chart-container-title"><i class="fas fa-seedling"></i> Humidité du sol & Eau</p>
                    <div id="chart-niveauxeaux" style="min-height:350px;"></div>
                </div>

                <div class="chart-container">
                    <p class="chart-container-title"><i class="fas fa-cog"></i> Autonomie & Système</p>
                    <div id="chart-cycles" style="min-height:300px;"></div>
                </div>
                {% endif %}

                {# ===== FILTRAGE ===== #}
                <div class="filter-section">
                    <h3><i class="fas fa-filter"></i> Filtrage des données</h3>
                    <form method="POST" action="/msp1/msp1datas/msp1-data.php">
                        {{ csrf_field|raw }}
                        <div>
                            <label for="start_datetime">Début</label>
                            <input type="datetime-local" id="start_datetime" name="start_datetime" value="{{ start_date|date('Y-m-d\\TH:i') }}">
                        </div>
                        <div>
                            <label for="end_datetime">Fin</label>
                            <input type="datetime-local" id="end_datetime" name="end_datetime" value="{{ end_date|date('Y-m-d\\TH:i') }}">
                        </div>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Afficher</button>
                        <button type="submit" name="export_csv" value="1" class="btn btn-secondary"><i class="fas fa-download"></i> CSV</button>
                    </form>
                    <div class="quick-filters">
                        <span class="quick-filter-btn" onclick="setPeriod(1,'h')">1h</span>
                        <span class="quick-filter-btn" onclick="setPeriod(3,'h')">3h</span>
                        <span class="quick-filter-btn" onclick="setPeriod(6,'h')">6h</span>
                        <span class="quick-filter-btn" onclick="setPeriod(12,'h')">12h</span>
                        <span class="quick-filter-btn" onclick="setPeriod(1,'d')">1 jour</span>
                        <span class="quick-filter-btn" onclick="setPeriod(7,'d')">1 sem</span>
                        <span class="quick-filter-btn" onclick="setPeriod(30,'d')">1 mois</span>
                    </div>
                    <div class="period-info">
                        <span><i class="fas fa-database"></i> {{ measure_count }} mesures</span>
                        <span><i class="fas fa-clock"></i> {{ duration_str }}</span>
                    </div>
                </div>

                {# ===== ÉTAT DU SYSTÈME ===== #}
                <div class="system-health-panel">
                    <h3><i class="fas fa-heartbeat"></i> État du système</h3>
                    <div class="health-grid">
                        <div class="health-item">
                            <div class="health-item-label">Firmware</div>
                            <div class="health-item-value">v{{ firmware_version }}</div>
                        </div>
                        <div class="health-item">
                            <div class="health-item-label">Serveur</div>
                            <div class="health-item-value">{{ version }}</div>
                        </div>
                        <div class="health-item">
                            <div class="health-item-label">Mesures affichées</div>
                            <div class="health-item-value">{{ measure_count }}</div>
                        </div>
                        <div class="health-item">
                            <div class="health-item-label">Environnement</div>
                            <div class="health-item-value">{{ environment }}</div>
                        </div>
                    </div>
                </div>

                {# ===== MESURES MANUELLES (Google Sheets) ===== #}
                <div class="section-header">
                    <i class="fas fa-flask"></i>
                    <h3>Mesures manuelles</h3>
                </div>
                <div class="iframes-grid">
                    <div class="iframe-card">
                        <iframe src="https://docs.google.com/spreadsheets/d/e/2PACX-1vQR_cBafylH_-wpVrB2tBR4KmpO3TXn50OlaFQpDnSP3YuhDbNUhqIprunoNK3UKGTavwAi4c8Ga2M3/pubchart?oid=209032696&format=interactive" loading="lazy"></iframe>
                    </div>
                    <div class="iframe-card">
                        <iframe src="https://docs.google.com/spreadsheets/d/e/2PACX-1vQR_cBafylH_-wpVrB2tBR4KmpO3TXn50OlaFQpDnSP3YuhDbNUhqIprunoNK3UKGTavwAi4c8Ga2M3/pubchart?oid=699943208&format=interactive" loading="lazy"></iframe>
                    </div>
                    <div class="iframe-card">
                        <iframe src="https://docs.google.com/spreadsheets/d/e/2PACX-1vQR_cBafylH_-wpVrB2tBR4KmpO3TXn50OlaFQpDnSP3YuhDbNUhqIprunoNK3UKGTavwAi4c8Ga2M3/pubchart?oid=1338338691&format=interactive" loading="lazy"></iframe>
                    </div>
                </div>

                {# ===== HISTORIQUE ===== #}
                {% if measure_count > 0 %}
                <div class="section-header">
                    <i class="fas fa-history"></i>
                    <h3>Historique ({{ measure_count }} mesures)</h3>
                </div>
                <div class="data-table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th><th>Date</th><th>T°int</th><th>T°ext</th><th>H%int</th><th>H%ext</th><th>Lum.</th><th>T°eau</th><th>H%sol</th><th>Pluie</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in latest ? [latest] : [] %}{% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </article>
        </div>

        <footer id="footer">
            <div class="context-badges">
                <span class="context-badge {{ environment == 'msp_test' ? 'context-badge-test' : 'context-badge-prod' }}"><i class="fas fa-globe"></i> {{ environment == 'msp_test' ? 'Environnement TEST' : 'Environnement production' }}</span>
                <span class="context-badge"><i class="fas fa-database"></i> {{ environment == 'msp_test' ? 'msp1DataTest' : 'msp1Data' }}</span>
                <span class="context-badge"><i class="fas fa-code-branch"></i> {{ version }}</span>
                {% if firmware_version %}<span class="context-badge"><i class="fas fa-microchip"></i> Firmware v{{ firmware_version }}</span>{% endif %}
            </div>
            <p style="margin:0;">Station météo (Le potager) | n3 IoT | © 2025 olution</p>
        </footer>
    </div>

    <script>
    var reading_time = {{ reading_time|json_encode|raw }};
    var TempAirInt = {{ TempAirInt|json_encode|raw }};
    var TempAirExt = {{ TempAirExt|json_encode|raw }};
    var HumidAirInt = {{ HumidAirInt|json_encode|raw }};
    var HumidAirExt = {{ HumidAirExt|json_encode|raw }};
    var LuminositeMoy = {{ LuminositeMoy|json_encode|raw }};
    var LuminositeA = {{ LuminositeA|json_encode|raw }};
    var LuminositeB = {{ LuminositeB|json_encode|raw }};
    var LuminositeC = {{ LuminositeC|json_encode|raw }};
    var LuminositeD = {{ LuminositeD|json_encode|raw }};
    var HumidSol = {{ HumidSol|json_encode|raw }};
    var TempEau = {{ TempEau|json_encode|raw }};
    var Pluie = {{ Pluie|json_encode|raw }};
    var PontDiv = {{ PontDiv|json_encode|raw }};
    var bootCount = {{ bootCount|json_encode|raw }};
    var ServoHB = {{ ServoHB|json_encode|raw }};
    var ServoGD = {{ ServoGD|json_encode|raw }};
    var resetMode = {{ resetMode|json_encode|raw }};

    function zipSeries(values) {
        var r = [];
        for (var i = 0; i < reading_time.length; i++) {
            r.push([reading_time[i], values[i]]);
        }
        return r;
    }

    function setPeriod(val, unit) {
        var now = new Date();
        var start = new Date(now);
        if (unit === 'h') start.setHours(start.getHours() - val);
        else if (unit === 'd') start.setDate(start.getDate() - val);
        function fmt(d) { return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')+'T'+String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0'); }
        document.getElementById('start_datetime').value = fmt(start);
        document.getElementById('end_datetime').value = fmt(now);
        document.querySelector('.filter-section form').submit();
    }

    Highcharts.setOptions({ time: { timezone: 'Africa/Casablanca' }, lang: { months: ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'], shortMonths: ['Jan','Fév','Mar','Avr','Mai','Jun','Jul','Aoû','Sep','Oct','Nov','Déc'], weekdays: ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'], decimalPoint: ',', thousandsSep: ' ', loading: 'Chargement...', noData: 'Aucune donnée', resetZoom: 'Reset zoom' }});

    {% if measure_count > 0 %}
    Highcharts.stockChart('chart-temperatures', {
        rangeSelector: { enabled: false },
        title: { text: 'Températures & Humidité' },
        yAxis: [
            { title: { text: 'Température (°C)' }, opposite: false },
            { title: { text: 'Humidité (%)' }, opposite: true }
        ],
        series: [
            { name: 'Temp. int.', data: zipSeries(TempAirInt), type: 'spline', color: '#e74c3c', yAxis: 0, tooltip: { valueSuffix: ' °C' }},
            { name: 'Temp. ext.', data: zipSeries(TempAirExt), type: 'spline', color: '#c0392b', yAxis: 0, tooltip: { valueSuffix: ' °C' }},
            { name: 'Humid. int.', data: zipSeries(HumidAirInt), type: 'spline', color: '#3498db', yAxis: 1, tooltip: { valueSuffix: ' %' }},
            { name: 'Humid. ext.', data: zipSeries(HumidAirExt), type: 'spline', color: '#2980b9', yAxis: 1, tooltip: { valueSuffix: ' %' }}
        ],
        chart: { backgroundColor: 'transparent' },
        credits: { enabled: false }
    });

    Highcharts.stockChart('chart-lights', {
        rangeSelector: { enabled: false },
        title: { text: 'Luminosité' },
        series: [
            { name: 'Moy.', data: zipSeries(LuminositeMoy), type: 'spline', color: '#f39c12', lineWidth: 3 },
            { name: 'A', data: zipSeries(LuminositeA), type: 'spline', color: '#e67e22', dashStyle: 'Dash' },
            { name: 'B', data: zipSeries(LuminositeB), type: 'spline', color: '#d35400', dashStyle: 'Dash' },
            { name: 'C', data: zipSeries(LuminositeC), type: 'spline', color: '#f1c40f', dashStyle: 'Dash' },
            { name: 'D', data: zipSeries(LuminositeD), type: 'spline', color: '#e74c3c', dashStyle: 'Dash' }
        ],
        chart: { backgroundColor: 'transparent' },
        credits: { enabled: false }
    });

    Highcharts.stockChart('chart-niveauxeaux', {
        rangeSelector: { enabled: false },
        title: { text: 'Humidité du sol & Température eau' },
        yAxis: [
            { title: { text: 'Humidité sol / Pluie' }, opposite: false },
            { title: { text: 'Temp. eau (°C)' }, opposite: true }
        ],
        series: [
            { name: 'Humid. sol', data: zipSeries(HumidSol), type: 'areaspline', color: '#27ae60', fillOpacity: 0.15, yAxis: 0 },
            { name: 'Pluie', data: zipSeries(Pluie), type: 'column', color: '#9b59b6', yAxis: 0 },
            { name: 'Temp. eau', data: zipSeries(TempEau), type: 'spline', color: '#008B74', yAxis: 1, tooltip: { valueSuffix: ' °C' }},
            { name: 'Reset', data: zipSeries(resetMode), type: 'column', color: '#bdc3c7', yAxis: 0 }
        ],
        chart: { backgroundColor: 'transparent' },
        credits: { enabled: false }
    });

    Highcharts.stockChart('chart-cycles', {
        rangeSelector: { enabled: false },
        title: { text: 'Autonomie & Système' },
        yAxis: [
            { title: { text: 'Cycles / Servos' }, opposite: false },
            { title: { text: 'Batterie' }, opposite: true }
        ],
        series: [
            { name: 'bootCount', data: zipSeries(bootCount), type: 'spline', color: '#2c3e50', yAxis: 0 },
            { name: 'PontDiv', data: zipSeries(PontDiv), type: 'spline', color: '#e74c3c', yAxis: 1 },
            { name: 'ServoHB', data: zipSeries(ServoHB), type: 'spline', color: '#3498db', yAxis: 0 },
            { name: 'ServoGD', data: zipSeries(ServoGD), type: 'spline', color: '#f39c12', yAxis: 0 }
        ],
        chart: { backgroundColor: 'transparent' },
        credits: { enabled: false }
    });
    {% endif %}
    </script>
</body>
</html>

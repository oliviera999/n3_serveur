{% block scripts %}
    {% include 'partials/_live_badge.twig' %}
    <script src="{{ base_path }}/assets/js/highcharts-defaults.js"></script>
    <script src="{{ base_path }}/assets/js/chart-helpers.js"></script>
    <script>
    function setPeriod(value, unit) {
        const now = moment().tz('Africa/Casablanca');
        let start = moment(now);
        
        if (unit === 'hours') {
            start = start.subtract(value, 'hours');
        } else if (unit === 'days') {
            start = start.subtract(value, 'days');
        }
        
        const formatDateTime = (momentObj) => {
            return momentObj.format('YYYY-MM-DDTHH:mm');
        };
        
        document.getElementById('start_datetime').value = formatDateTime(start);
        document.getElementById('end_datetime').value = formatDateTime(now);
        
        document.getElementById('msp1FilterForm').submit();
    }
    </script>
    <script>
    var reading_time = {{ reading_time|json_encode|raw }};
    {% for col in chart_columns %}
    var {{ col }} = {{ attribute(_context, col)|json_encode|raw }};
    {% endfor %}
    </script>

    {% if measure_count > 0 %}
    <script>
    (function() {
        var chartLoadExtremes = function() {
            var xAxis = this.xAxis && this.xAxis[0];
            if (xAxis && xAxis.dataMin != null && xAxis.dataMax != null) {
                xAxis.setExtremes(xAxis.dataMin, xAxis.dataMax);
            }
        };
    Highcharts.stockChart('chart-temperatures', {
        rangeSelector: { enabled: false },
        title: { text: '' },
        xAxis: { ordinal: false },
        yAxis: [
            { title: { text: 'Température (°C)' }, opposite: false },
            { title: { text: 'Humidité (%)' }, opposite: true }
        ],
        series: [
            { name: 'Temp. int.', data: zipSeries(reading_time, TempAirInt), type: 'spline', color: '#e74c3c', yAxis: 0, tooltip: { valueSuffix: ' °C' }},
            { name: 'Temp. ext.', data: zipSeries(reading_time, TempAirExt), type: 'spline', color: '#c0392b', yAxis: 0, tooltip: { valueSuffix: ' °C' }},
            { name: 'Humid. int.', data: zipSeries(reading_time, HumidAirInt), type: 'spline', color: '#3498db', yAxis: 1, tooltip: { valueSuffix: ' %' }},
            { name: 'Humid. ext.', data: zipSeries(reading_time, HumidAirExt), type: 'spline', color: '#2980b9', yAxis: 1, tooltip: { valueSuffix: ' %' }}
        ],
        legend: { enabled: true, align: 'center', verticalAlign: 'bottom', itemStyle: { cursor: 'pointer' } },
        chart: { backgroundColor: 'transparent', height: 420, events: { load: chartLoadExtremes } },
        credits: { enabled: false }
    });
    Highcharts.stockChart('chart-lights', {

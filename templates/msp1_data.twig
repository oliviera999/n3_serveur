<!DOCTYPE HTML>
<html lang="fr">
<head>
    <title>{{ page_title }}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
    <meta name="theme-color" content="#008B74" />
    <link rel="stylesheet" href="https://iot.olution.info/assets/css/main.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" />
    <link rel="shortcut icon" type="image/png" href="/assets/logo.png"/>
    <style>
        body { background: #e8f4f2 !important; }
        #page-bg { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: -1; background-color: #e8f4f2; }
        .modern-header {
            background: linear-gradient(145deg, #008B74 0%, #007A61 25%, #00B794 50%, #008B74 100%);
            color: white;
            padding: 58px 0;
            margin: -20px -20px 20px -20px;
            position: relative;
            overflow: hidden;
            border-radius: 0 0 16px 16px;
        }
        .modern-header::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="g" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="0.5"/></pattern></defs><rect width="100" height="100" fill="url(%23g)"/></svg>');
            opacity: 0.2;
        }
        .header-content { position: relative; z-index: 2; text-align: center; max-width: 1200px; margin: 0 auto; padding: 0 20px; }
        .header-title {
            font-size: 2.2em;
            font-weight: bold;
            margin: 0 0 15px 0;
            text-shadow: 0 1px 2px rgba(0,0,0,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
        }
        .header-title i { font-size: 0.9em; }
        .header-subtitle { font-size: 1.15em; margin: 0; opacity: 0.9; font-weight: 300; }
        .section-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin: 40px 0 20px 0;
            padding-bottom: 12px;
            border-bottom: 3px solid #008B74;
            position: relative;
        }
        .section-header::after {
            content: '';
            position: absolute;
            bottom: -3px;
            left: 0;
            width: 60px;
            height: 3px;
            background: #00B794;
            border-radius: 2px;
        }
        .section-header h3 { margin: 0; color: #008B74; font-size: 1.5em; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
        .section-header i { font-size: 1.8em; color: #008B74; padding: 10px; background: rgba(0,139,116,0.1); border-radius: 12px; }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 20px;
            margin: 20px 0;
        }
        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 22px;
            box-shadow: 0 4px 20px rgba(0,139,116,0.1);
            text-align: center;
            transition: all 0.3s ease;
            border: 1px solid rgba(0,139,116,0.08);
            position: relative;
            overflow: hidden;
        }
        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: linear-gradient(90deg, #008B74, #00B794);
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }
        .stat-card:hover { transform: translateY(-6px); box-shadow: 0 12px 40px rgba(0,139,116,0.2); }
        .stat-card:hover::before { transform: scaleX(1); }
        .stat-card-icon { font-size: 2.5em; margin-bottom: 12px; display: block; }
        .stat-card-value { font-size: 2em; font-weight: bold; color: #2c3e50; margin: 10px 0; line-height: 1; }
        .stat-card-label { font-size: 0.9em; color: #7f8c8d; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; }
        .stat-card-unit { font-size: 0.7em; color: #95a5a6; font-weight: 400; }
        .stat-card.temp { border-left: 5px solid #e74c3c; background: linear-gradient(180deg, #ffffff 0%, #fef5f1 100%); }
        .stat-card.temp .stat-card-icon { color: #e74c3c; }
        .stat-card.humidity { border-left: 5px solid #3498db; background: linear-gradient(180deg, #ffffff 0%, #f4f8fb 100%); }
        .stat-card.humidity .stat-card-icon { color: #3498db; }
        .stat-card.light { border-left: 5px solid #f39c12; background: linear-gradient(180deg, #ffffff 0%, #fef9f3 100%); }
        .stat-card.light .stat-card-icon { color: #f39c12; }
        .stat-card.water { border-left: 5px solid #008B74; background: linear-gradient(180deg, #ffffff 0%, #f0faf8 100%); }
        .stat-card.water .stat-card-icon { color: #008B74; }
        .stat-card.rain { border-left: 5px solid #9b59b6; background: linear-gradient(180deg, #ffffff 0%, #f8f4fb 100%); }
        .stat-card.rain .stat-card-icon { color: #9b59b6; }
        .data-meta { font-size: 0.9em; color: #7f8c8d; margin-top: 10px; }
        .data-table-wrap { background: white; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,139,116,0.1); margin: 20px 0; }
        .data-table-wrap table { width: 100%; border-collapse: collapse; }
        .data-table-wrap th, .data-table-wrap td { padding: 12px 14px; text-align: left; border-bottom: 1px solid #eee; }
        .data-table-wrap th { background: #008B74; color: white; font-size: 0.85em; }
        .data-table-wrap tr:hover { background: #f8f9fa; }
        .no-data { text-align: center; padding: 50px 20px; color: #7f8c8d; background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,139,116,0.08); }
        #footer { text-align: center; padding: 1.5rem 2rem; margin-top: 2rem; color: #6c757d; font-size: 0.9em; border-top: 1px solid rgba(0,139,116,0.15); background: rgba(255,255,255,0.92); }
        #footer .footer-copyright { margin: 0; }
        .context-badges { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-bottom: 1rem; }
        .context-badge { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; font-size: 0.82em; font-weight: 600; background: rgba(0,0,0,0.05); color: #666; border: 1px solid rgba(0,0,0,0.1); }
        @media (max-width: 768px) {
            .header-title { font-size: 1.7em; flex-direction: column; gap: 10px; }
            .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 15px; }
        }
    </style>
</head>
<body class="is-preload">
    <div id="page-bg" aria-hidden="true"></div>
    <div id="wrapper" class="fade-in">
        <header id="header">
            <a href="/" class="logo"><img src="/assets/logo.png" alt="n3 iot datas" /><span class="logo-text">IOT</span></a>
        </header>
        <nav id="nav">
            <ul class="links">
                <li><a href="/">Accueil</a></li>
                <li><a href="/{{ environment == 'test' ? 'aquaponie-test' : (environment == 'test3' ? 'aquamobile-test' : (environment == 's3' ? 'aquamobile' : 'aquaponie')) }}">L'aquaponie (FFP3)</a></li>
                <li><a href="/{{ environment == 'test' ? 'aquaponie-alt-test' : (environment == 'test3' ? 'aquamobile-alt-test' : (environment == 's3' ? 'aquamobile-alt' : 'aquaponie-alt')) }}">Vue classique</a></li>
                <li><a href="/aquaponie-description">Caractéristiques</a></li>
                <li class="active"><a href="/msp1/msp1datas/msp1-data.php">Le potager</a></li>
                <li><a href="/n3pp/n3ppdatas/n3pp-data.php">L'élevage d'insectes</a></li>
            </ul>
            <ul class="icons">
                <li><a href="https://olution.info/course/view.php?id=511" class="icon solid fa-leaf"><span class="label">olution</span></a></li>
                <li><a href="https://farmflow.marout.org/" class="icon solid fa-fish"><span class="label">farmflow</span></a></li>
            </ul>
        </nav>
        <div id="main">
            <div class="modern-header">
                <div class="header-content">
                    <div class="header-title">
                        <i class="fas fa-sun" aria-hidden="true"></i>
                        Le potager – Station météo
                    </div>
                    <p class="header-subtitle">Données en direct de la station météo (température, humidité, luminosité, eau, pluie).</p>
                    <p class="header-more" style="margin-top:1rem;"><a href="/msp1/msp1control/">Contrôle des sorties</a></p>
                </div>
            </div>
            <article class="post featured">
                {% if latest %}
                    <div class="section-header">
                        <i class="fas fa-chart-line"></i>
                        <h3>Dernière mesure</h3>
                    </div>
                    <div class="stats-grid">
                        {% if latest.TempAirInt is defined and latest.TempAirInt is not null %}
                        <div class="stat-card temp">
                            <i class="fas fa-thermometer-half stat-card-icon"></i>
                            <div class="stat-card-label">Temp. air int.</div>
                            <div class="stat-card-value">{{ latest.TempAirInt|number_format(1) }} <span class="stat-card-unit">°C</span></div>
                        </div>
                        {% endif %}
                        {% if latest.TempAirExt is defined and latest.TempAirExt is not null %}
                        <div class="stat-card temp">
                            <i class="fas fa-temperature-low stat-card-icon"></i>
                            <div class="stat-card-label">Temp. air ext.</div>
                            <div class="stat-card-value">{{ latest.TempAirExt|number_format(1) }} <span class="stat-card-unit">°C</span></div>
                        </div>
                        {% endif %}
                        {% if latest.HumidAirInt is defined and latest.HumidAirInt is not null %}
                        <div class="stat-card humidity">
                            <i class="fas fa-tint stat-card-icon"></i>
                            <div class="stat-card-label">Humid. air int.</div>
                            <div class="stat-card-value">{{ latest.HumidAirInt|number_format(0) }} <span class="stat-card-unit">%</span></div>
                        </div>
                        {% endif %}
                        {% if latest.HumidAirExt is defined and latest.HumidAirExt is not null %}
                        <div class="stat-card humidity">
                            <i class="fas fa-cloud stat-card-icon"></i>
                            <div class="stat-card-label">Humid. air ext.</div>
                            <div class="stat-card-value">{{ latest.HumidAirExt|number_format(0) }} <span class="stat-card-unit">%</span></div>
                        </div>
                        {% endif %}
                        {% if latest.LuminositeMoy is defined and latest.LuminositeMoy is not null %}
                        <div class="stat-card light">
                            <i class="fas fa-sun stat-card-icon"></i>
                            <div class="stat-card-label">Luminosité moy.</div>
                            <div class="stat-card-value">{{ latest.LuminositeMoy|number_format(0) }}</div>
                        </div>
                        {% endif %}
                        {% if latest.TempEau is defined and latest.TempEau is not null %}
                        <div class="stat-card water">
                            <i class="fas fa-water stat-card-icon"></i>
                            <div class="stat-card-label">Temp. eau</div>
                            <div class="stat-card-value">{{ latest.TempEau|number_format(1) }} <span class="stat-card-unit">°C</span></div>
                        </div>
                        {% endif %}
                        {% if latest.HumidSol is defined and latest.HumidSol is not null %}
                        <div class="stat-card humidity">
                            <i class="fas fa-seedling stat-card-icon"></i>
                            <div class="stat-card-label">Humid. sol</div>
                            <div class="stat-card-value">{{ latest.HumidSol|number_format(0) }} <span class="stat-card-unit">%</span></div>
                        </div>
                        {% endif %}
                        {% if latest.Pluie is defined and latest.Pluie is not null %}
                        <div class="stat-card rain">
                            <i class="fas fa-cloud-rain stat-card-icon"></i>
                            <div class="stat-card-label">Pluie</div>
                            <div class="stat-card-value">{{ latest.Pluie|number_format(0) }}</div>
                        </div>
                        {% endif %}
                    </div>
                    {% if latest.sensor is defined or latest.version is defined %}
                    <p class="data-meta">Capteur : {{ latest.sensor|default('-') }} | Version firmware : {{ latest.version|default('-') }}</p>
                    {% endif %}
                {% else %}
                    <div class="no-data">Aucune donnée enregistrée pour le moment.</div>
                {% endif %}

                {% if recent is not empty %}
                    <div class="section-header">
                        <i class="fas fa-history"></i>
                        <h3>Historique récent ({{ recent|length }} mesures)</h3>
                    </div>
                    <div class="data-table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Temp. int.</th>
                                    <th>Temp. ext.</th>
                                    <th>Humid. int.</th>
                                    <th>Humid. ext.</th>
                                    <th>Luminosité</th>
                                    <th>Temp. eau</th>
                                    <th>Humid. sol</th>
                                    <th>Pluie</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in recent %}
                                <tr>
                                    <td>{{ row.id|default(loop.index) }}</td>
                                    <td>{{ row.TempAirInt is defined and row.TempAirInt is not null ? (row.TempAirInt|number_format(1)) ~ ' °C' : '-' }}</td>
                                    <td>{{ row.TempAirExt is defined and row.TempAirExt is not null ? (row.TempAirExt|number_format(1)) ~ ' °C' : '-' }}</td>
                                    <td>{{ row.HumidAirInt is defined and row.HumidAirInt is not null ? (row.HumidAirInt|number_format(0)) ~ ' %' : '-' }}</td>
                                    <td>{{ row.HumidAirExt is defined and row.HumidAirExt is not null ? (row.HumidAirExt|number_format(0)) ~ ' %' : '-' }}</td>
                                    <td>{{ row.LuminositeMoy is defined and row.LuminositeMoy is not null ? row.LuminositeMoy|number_format(0) : '-' }}</td>
                                    <td>{{ row.TempEau is defined and row.TempEau is not null ? (row.TempEau|number_format(1)) ~ ' °C' : '-' }}</td>
                                    <td>{{ row.HumidSol is defined and row.HumidSol is not null ? (row.HumidSol|number_format(0)) ~ ' %' : '-' }}</td>
                                    <td>{{ row.Pluie is defined and row.Pluie is not null ? row.Pluie|number_format(0) : '-' }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </article>
        </div>
        <footer id="footer">
            <div class="context-badges">
                {% if version %}
                <span class="context-badge"><i class="fas fa-code-branch"></i> {{ version }}</span>
                {% endif %}
            </div>
            <p class="footer-copyright">Données station météo (Le potager) | n3 IoT | © 2025 olution</p>
        </footer>
    </div>
</body>
</html>

{% extends 'layout.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block head_css %}
    <link rel="stylesheet" href="{{ base_path }}/assets/css/common-data.css" />
    <link rel="stylesheet" href="{{ base_path }}/assets/css/msp1-sheet-styles.css" />
{% endblock %}

{% block head_scripts %}
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://code.highcharts.com/stock/highstock.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script src="https://code.highcharts.com/modules/export-data.js"></script>
    <script src="https://code.highcharts.com/modules/accessibility.js"></script>
{% endblock %}

{% block content %}
    {% include 'partials/_hero_data.twig' with {
        hero_title: data_config.hero_title,
        hero_icon: data_config.hero_icon,
        hero_subtitle: data_config.hero_subtitle,
        hero_more_url: data_config.hero_more_url|default(''),
        hero_more_label: data_config.hero_more_label|default(''),
        hero_synthesis: '📊 Synthèse du ' ~ start_date|date('d/m/Y H:i') ~ ' au ' ~ end_date|date('d/m/Y H:i') ~ ' — ' ~ measure_count ~ ' mesures — ' ~ duration_str
    } %}

    {# Ordre des sections : Hero, Luminosité, Paramètres du sol, Paramètres physiques, Système, filter-health-row (filtrage + état), Mesures manuelles #}
    <article class="post featured">
        {% if not latest and measure_count == 0 %}
            <div class="no-data"><i class="fas fa-database no-data-icon"></i><br>Aucune donnée enregistrée.</div>
        {% else %}
            {# Section 1 : Luminosité #}
            <div class="section-header alt-section-title-full" data-aos="fade-up">
                <i class="fas fa-sun"></i>
                <h3>Luminosité</h3>
            </div>
            <div class="alt-data-chart-row" data-aos="fade-up">
                <div class="alt-stats-column">
                    <div class="stats-grid">
                        {% if latest %}
                        <div class="stat-card" style="border-left-color:#f39c12">
                            <i class="fas fa-sun stat-card-icon" style="color:#f39c12"></i>
                            <div class="stat-card-label">Luminosité moy.</div>
                            <div class="stat-card-value"><span data-sensor="LuminositeMoy" data-decimals="0">{{ latest.LuminositeMoy|default('-')|number_format(0) }}</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_luminositeMoy|default(0)|number_format(0) }} | Min: {{ min_luminositeMoy|default(0)|number_format(0) }} | Max: {{ max_luminositeMoy|default(0)|number_format(0) }}</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#e67e22">
                            <i class="fas fa-sun stat-card-icon" style="color:#e67e22"></i>
                            <div class="stat-card-label">A</div>
                            <div class="stat-card-value"><span data-sensor="LuminositeA" data-decimals="0">{{ latest.LuminositeA|default('-')|number_format(0) }}</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_luminositeA|default('-')|number_format(0) }} | Min: {{ min_luminositeA|default('-')|number_format(0) }} | Max: {{ max_luminositeA|default('-')|number_format(0) }}</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#d35400">
                            <i class="fas fa-sun stat-card-icon" style="color:#d35400"></i>
                            <div class="stat-card-label">B</div>
                            <div class="stat-card-value"><span data-sensor="LuminositeB" data-decimals="0">{{ latest.LuminositeB|default('-')|number_format(0) }}</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_luminositeB|default('-')|number_format(0) }} | Min: {{ min_luminositeB|default('-')|number_format(0) }} | Max: {{ max_luminositeB|default('-')|number_format(0) }}</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#f1c40f">
                            <i class="fas fa-sun stat-card-icon" style="color:#f1c40f"></i>
                            <div class="stat-card-label">C</div>
                            <div class="stat-card-value"><span data-sensor="LuminositeC" data-decimals="0">{{ latest.LuminositeC|default('-')|number_format(0) }}</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_luminositeC|default('-')|number_format(0) }} | Min: {{ min_luminositeC|default('-')|number_format(0) }} | Max: {{ max_luminositeC|default('-')|number_format(0) }}</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#e74c3c">
                            <i class="fas fa-sun stat-card-icon" style="color:#e74c3c"></i>
                            <div class="stat-card-label">D</div>
                            <div class="stat-card-value"><span data-sensor="LuminositeD" data-decimals="0">{{ latest.LuminositeD|default('-')|number_format(0) }}</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_luminositeD|default('-')|number_format(0) }} | Min: {{ min_luminositeD|default('-')|number_format(0) }} | Max: {{ max_luminositeD|default('-')|number_format(0) }}</div>
                        </div>
                        {% endif %}
                    </div>
                </div>
                <div class="alt-chart-column">
                    <div id="chart-lights" style="min-height:420px;"></div>
                </div>
            </div>

            {# Section 2 : Paramètres du sol #}
            <div class="section-header alt-section-title-full" data-aos="fade-up">
                <i class="fas fa-seedling"></i>
                <h3>Paramètres du sol</h3>
            </div>
            <div class="alt-data-chart-row" data-aos="fade-up">
                <div class="alt-stats-column">
                    <div class="stats-grid">
                        {% if latest %}
                        <div class="stat-card" style="border-left-color:#27ae60">
                            <i class="fas fa-seedling stat-card-icon" style="color:#27ae60"></i>
                            <div class="stat-card-label">Humidité sol</div>
                            <div class="stat-card-value"><span data-sensor="HumidSol" data-decimals="0">{{ latest.HumidSol|default('-')|number_format(0) }}</span> <span class="stat-card-unit">%</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_humidSol|default('-')|number_format(0) }}% | Min: {{ min_humidSol|default('-')|number_format(0) }}% | Max: {{ max_humidSol|default('-')|number_format(0) }}%</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#9b59b6">
                            <i class="fas fa-cloud-rain stat-card-icon" style="color:#9b59b6"></i>
                            <div class="stat-card-label">Pluie</div>
                            <div class="stat-card-value"><span data-sensor="Pluie" data-decimals="0">{{ latest.Pluie|default('-')|number_format(0) }}</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_pluie|default('-')|number_format(0) }} | Min: {{ min_pluie|default('-')|number_format(0) }} | Max: {{ max_pluie|default('-')|number_format(0) }}</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#008B74">
                            <i class="fas fa-water stat-card-icon" style="color:#008B74"></i>
                            <div class="stat-card-label">Température eau</div>
                            <div class="stat-card-value"><span data-sensor="TempEau" data-decimals="1">{{ latest.TempEau|default('-')|number_format(1) }}</span> <span class="stat-card-unit">°C</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_tempEau|default('-')|number_format(1) }} °C | Min: {{ min_tempEau|default('-')|number_format(1) }} °C | Max: {{ max_tempEau|default('-')|number_format(1) }} °C</div>
                        </div>
                        {% endif %}
                    </div>
                </div>
                <div class="alt-chart-column">
                    <div id="chart-niveauxeaux" style="min-height:420px;"></div>
                </div>
            </div>

            {# Section 3 : Paramètres physiques #}
            <div class="section-header alt-section-title-full" data-aos="fade-up">
                <i class="fas fa-thermometer-half"></i>
                <h3>Paramètres physiques</h3>
            </div>
            <div class="alt-data-chart-row" data-aos="fade-up">
                <div class="alt-stats-column">
                    <div class="stats-grid">
                        {% if latest %}
                        <div class="stat-card" style="border-left-color:#e74c3c">
                            <i class="fas fa-thermometer-half stat-card-icon" style="color:#e74c3c"></i>
                            <div class="stat-card-label">Temp. air int.</div>
                            <div class="stat-card-value"><span data-sensor="TempAirInt" data-decimals="1">{{ latest.TempAirInt|default('-')|number_format(1) }}</span> <span class="stat-card-unit">°C</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_tempAirInt|default('-')|number_format(1) }} °C | Min: {{ min_tempAirInt|default('-')|number_format(1) }} °C | Max: {{ max_tempAirInt|default('-')|number_format(1) }} °C</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#c0392b">
                            <i class="fas fa-temperature-low stat-card-icon" style="color:#c0392b"></i>
                            <div class="stat-card-label">Temp. air ext.</div>
                            <div class="stat-card-value"><span data-sensor="TempAirExt" data-decimals="1">{{ latest.TempAirExt|default('-')|number_format(1) }}</span> <span class="stat-card-unit">°C</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_tempAirExt|default('-')|number_format(1) }} °C | Min: {{ min_tempAirExt|default('-')|number_format(1) }} °C | Max: {{ max_tempAirExt|default('-')|number_format(1) }} °C</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#3498db">
                            <i class="fas fa-tint stat-card-icon" style="color:#3498db"></i>
                            <div class="stat-card-label">Humid. air int.</div>
                            <div class="stat-card-value"><span data-sensor="HumidAirInt" data-decimals="0">{{ latest.HumidAirInt|default('-')|number_format(0) }}</span> <span class="stat-card-unit">%</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_humidAirInt|default('-')|number_format(0) }}% | Min: {{ min_humidAirInt|default('-')|number_format(0) }}% | Max: {{ max_humidAirInt|default('-')|number_format(0) }}%</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#2980b9">
                            <i class="fas fa-cloud stat-card-icon" style="color:#2980b9"></i>
                            <div class="stat-card-label">Humid. air ext.</div>
                            <div class="stat-card-value"><span data-sensor="HumidAirExt" data-decimals="0">{{ latest.HumidAirExt|default('-')|number_format(0) }}</span> <span class="stat-card-unit">%</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_humidAirExt|default('-')|number_format(0) }}% | Min: {{ min_humidAirExt|default('-')|number_format(0) }}% | Max: {{ max_humidAirExt|default('-')|number_format(0) }}%</div>
                        </div>
                        {% endif %}
                    </div>
                </div>
                <div class="alt-chart-column">
                    <div id="chart-temperatures" style="min-height:420px;"></div>
                </div>
            </div>

            {# Section 4 : Système #}
            <div class="section-header alt-section-title-full" data-aos="fade-up">
                <i class="fas fa-cog"></i>
                <h3>Système</h3>
            </div>
            <div class="alt-data-chart-row" data-aos="fade-up">
                <div class="alt-stats-column">
                    <div class="stats-grid">
                        {% if latest %}
                        <div class="stat-card" style="border-left-color:#2c3e50">
                            <i class="fas fa-sync stat-card-icon" style="color:#2c3e50"></i>
                            <div class="stat-card-label">Redémarrages</div>
                            <div class="stat-card-value"><span data-sensor="bootCount" data-decimals="0">{{ latest.bootCount|default('-')|number_format(0) }}</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_bootCount|default('-')|number_format(0) }} | Min: {{ min_bootCount|default('-')|number_format(0) }} | Max: {{ max_bootCount|default('-')|number_format(0) }}</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#e74c3c">
                            <i class="fas fa-battery-half stat-card-icon" style="color:#e74c3c"></i>
                            <div class="stat-card-label">Pont div. (batterie)</div>
                            <div class="stat-card-value"><span data-sensor="PontDiv" data-decimals="0">{{ latest.PontDiv|default('-')|number_format(0) }}</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_pontDiv|default('-')|number_format(0) }} | Min: {{ min_pontDiv|default('-')|number_format(0) }} | Max: {{ max_pontDiv|default('-')|number_format(0) }}</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#3498db">
                            <i class="fas fa-cog stat-card-icon" style="color:#3498db"></i>
                            <div class="stat-card-label">Servo H-B</div>
                            <div class="stat-card-value"><span data-sensor="ServoHB" data-decimals="0">{{ latest.ServoHB|default('-')|number_format(0) }}</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_servoHB|default('-')|number_format(0) }} | Min: {{ min_servoHB|default('-')|number_format(0) }} | Max: {{ max_servoHB|default('-')|number_format(0) }}</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#f39c12">
                            <i class="fas fa-cog stat-card-icon" style="color:#f39c12"></i>
                            <div class="stat-card-label">Servo G-D</div>
                            <div class="stat-card-value"><span data-sensor="ServoGD" data-decimals="0">{{ latest.ServoGD|default('-')|number_format(0) }}</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_servoGD|default('-')|number_format(0) }} | Min: {{ min_servoGD|default('-')|number_format(0) }} | Max: {{ max_servoGD|default('-')|number_format(0) }}</div>
                        </div>
                        {% endif %}
                    </div>
                </div>
                <div class="alt-chart-column">
                    <div id="chart-cycles" style="min-height:380px;"></div>
                </div>
            </div>

            {% if latest and latest.sensor is defined %}<p class="data-sensor-caption">Capteur : {{ latest.sensor|default('-') }} | Firmware : {{ latest.version|default('-') }}</p>{% endif %}
        {% endif %}

        <div class="filter-health-row">
        <div class="filter-section">
            <div class="filter-header">
                <i class="fas fa-filter"></i>
                <h3>Filtrage des données</h3>
            </div>
            <form method="POST" action="{{ base_path|default('') }}{{ data_config.form_action }}" id="msp1FilterForm">
                {{ csrf_field|raw }}
                <div>
                    <label for="start_datetime">debut</label>
                    <input type="datetime-local" id="start_datetime" name="start_datetime" value="{{ start_date|date('Y-m-d\\TH:i') }}">
                </div>
                <div>
                    <label for="end_datetime">fin</label>
                    <input type="datetime-local" id="end_datetime" name="end_datetime" value="{{ end_date|date('Y-m-d\\TH:i') }}">
                </div>
                <div class="action-buttons">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Afficher les mesures</button>
                    <button type="submit" name="export_csv" value="1" class="btn btn-secondary"><i class="fas fa-file-csv"></i> Télécharger CSV</button>
                </div>
            </form>
            <div class="quick-filters">
                <button type="button" class="quick-filter-btn" onclick="setPeriod(1,'h')">1h</button>
                <button type="button" class="quick-filter-btn" onclick="setPeriod(3,'h')">3h</button>
                <button type="button" class="quick-filter-btn" onclick="setPeriod(6,'h')">6h</button>
                <button type="button" class="quick-filter-btn" onclick="setPeriod(12,'h')">12h</button>
                <button type="button" class="quick-filter-btn" onclick="setPeriod(1,'d')">1 jour</button>
                <button type="button" class="quick-filter-btn" onclick="setPeriod(7,'d')">1 sem</button>
                <button type="button" class="quick-filter-btn" onclick="setPeriod(30,'d')">1 mois</button>
            </div>
            <div class="period-info">
                <span><i class="fas fa-database"></i> {{ measure_count }} mesures</span>
                <span><i class="fas fa-clock"></i> {{ duration_str }}</span>
            </div>
            <!-- Temps total depuis le début du fonctionnement du module -->
            <div class="filter-module-uptime" style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.2); font-size: 0.9em;">
                <i class="fas fa-clock"></i>
                <strong>Temps total depuis le début du fonctionnement du module :</strong>
                <span id="module-uptime-total">{% if temps_total_module %}{{ temps_total_module }}{% else %}—{% endif %}</span>
            </div>
        </div>

        {% embed 'partials/_system_health_panel.twig' with { health_panel_title: 'État du système' } %}
            {% block health_items %}
                <div class="health-item">
                    <div class="health-item-label">Firmware</div>
                    <div class="health-item-value">v{{ firmware_version }}</div>
                </div>
                <div class="health-item">
                    <div class="health-item-label">Serveur</div>
                    <div class="health-item-value">{{ version }}</div>
                </div>
                <div class="health-item">
                    <div class="health-item-label">Mesures affichées</div>
                    <div class="health-item-value">{{ measure_count }}</div>
                </div>
                <div class="health-item">
                    <div class="health-item-label">Environnement</div>
                    <div class="health-item-value">{{ environment }}</div>
                </div>
            {% endblock %}
        {% endembed %}
        </div>

        {# Mesures manuelles (Google Sheets) #}
        <div class="section-header">
            <i class="fas fa-flask"></i>
            <h3>Mesures manuelles</h3>
        </div>
        <div class="msp-sheets-section">
            <div class="msp-sheets-grid">
                <div class="msp-sheet-card">
                    <div class="msp-sheet-card-header">
                        <i class="fas fa-chart-line"></i>
                        <h3 class="msp-sheet-card-title">Graphique des mesures</h3>
                    </div>
                    <div class="msp-sheet-card-container">
                        <iframe seamless scrolling="no" loading="lazy"
                            src="https://docs.google.com/spreadsheets/d/e/2PACX-1vT5i0I15n-Nef5J1LlY-MGYkPNQtmyzJJ08yObEc4dI_YCQrHFyEwxBx6vmwX-6MnqHwHVzDvupD_Qv/pubchart?oid=583144182&amp;format=interactive">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>
    </article>
{% endblock %}

{% block footer %}
    <footer id="footer" class="app-footer app-footer--elevated">
        <div class="context-badges">
            <span class="context-badge {{ environment == data_config.test_env ? 'context-badge-test' : 'context-badge-prod' }}"><i class="fas fa-globe"></i> {{ environment == data_config.test_env ? 'Environnement TEST' : 'Environnement production' }}</span>
            <span class="context-badge"><i class="fas fa-database"></i> {{ data_config.table_label|default(environment) }}</span>
            <span class="context-badge"><i class="fas fa-code-branch"></i> {{ version }}</span>
            {% if firmware_version %}<span class="context-badge"><i class="fas fa-microchip"></i> Firmware v{{ firmware_version }}</span>{% endif %}
        </div>
        <p style="margin:0;">{{ data_config.footer_text }} | N3 IoT Datas | &copy; 2025 olution</p>
    </footer>
{% endblock %}

{% block scripts %}
    {% include 'partials/_live_badge.twig' %}
    <script src="{{ base_path }}/assets/js/highcharts-defaults.js"></script>
    <script src="{{ base_path }}/assets/js/chart-helpers.js"></script>
    <script>
    function setPeriod(value, unit) {
        var now = new Date();
        var start = new Date(now);
        if (unit === 'h') start.setHours(start.getHours() - value);
        else if (unit === 'd') start.setDate(start.getDate() - value);
        var fmt = function(d) {
            var y = d.getFullYear(), m = String(d.getMonth() + 1).padStart(2, '0'), day = String(d.getDate()).padStart(2, '0');
            var h = String(d.getHours()).padStart(2, '0'), min = String(d.getMinutes()).padStart(2, '0');
            return y + '-' + m + '-' + day + 'T' + h + ':' + min;
        };
        var form = document.getElementById('msp1FilterForm');
        if (form) {
            var startEl = form.querySelector('#start_datetime');
            var endEl = form.querySelector('#end_datetime');
            if (startEl) startEl.value = fmt(start);
            if (endEl) endEl.value = fmt(now);
            form.submit();
        }
    }
    </script>
    <script>
    var reading_time = {{ reading_time|json_encode|raw }};
    {% for col in chart_columns %}
    var {{ col }} = {{ attribute(_context, col)|json_encode|raw }};
    {% endfor %}
    </script>

    {% if measure_count > 0 %}
    <script>
    (function() {
        var chartLoadExtremes = function() {
            var xAxis = this.xAxis && this.xAxis[0];
            if (xAxis && xAxis.dataMin != null && xAxis.dataMax != null) {
                xAxis.setExtremes(xAxis.dataMin, xAxis.dataMax);
            }
        };
    Highcharts.stockChart('chart-temperatures', {
        rangeSelector: { enabled: false },
        title: { text: '' },
        xAxis: { ordinal: false },
        yAxis: [
            { title: { text: 'Température (°C)' }, opposite: false },
            { title: { text: 'Humidité (%)' }, opposite: true }
        ],
        series: [
            { name: 'Temp. int.', data: zipSeries(reading_time, TempAirInt), type: 'spline', color: '#e74c3c', yAxis: 0, tooltip: { valueSuffix: ' °C' }},
            { name: 'Temp. ext.', data: zipSeries(reading_time, TempAirExt), type: 'spline', color: '#c0392b', yAxis: 0, tooltip: { valueSuffix: ' °C' }},
            { name: 'Humid. int.', data: zipSeries(reading_time, HumidAirInt), type: 'spline', color: '#3498db', yAxis: 1, tooltip: { valueSuffix: ' %' }},
            { name: 'Humid. ext.', data: zipSeries(reading_time, HumidAirExt), type: 'spline', color: '#2980b9', yAxis: 1, tooltip: { valueSuffix: ' %' }}
        ],
        legend: { enabled: true, align: 'center', verticalAlign: 'bottom', itemStyle: { cursor: 'pointer' } },
        chart: { backgroundColor: 'transparent', height: 420, events: { load: chartLoadExtremes } },
        credits: { enabled: false }
    });
    Highcharts.stockChart('chart-lights', {
        rangeSelector: { enabled: false },
        title: { text: '' },
        xAxis: { ordinal: false },
        series: [
            { name: 'Moy.', data: zipSeries(reading_time, LuminositeMoy), type: 'spline', color: '#f39c12', lineWidth: 3 },
            { name: 'A', data: zipSeries(reading_time, LuminositeA), type: 'spline', color: '#e67e22', dashStyle: 'Dash' },
            { name: 'B', data: zipSeries(reading_time, LuminositeB), type: 'spline', color: '#d35400', dashStyle: 'Dash' },
            { name: 'C', data: zipSeries(reading_time, LuminositeC), type: 'spline', color: '#f1c40f', dashStyle: 'Dash' },
            { name: 'D', data: zipSeries(reading_time, LuminositeD), type: 'spline', color: '#e74c3c', dashStyle: 'Dash' }
        ],
        legend: { enabled: true, align: 'center', verticalAlign: 'bottom', itemStyle: { cursor: 'pointer' } },
        chart: { backgroundColor: 'transparent', height: 420, events: { load: chartLoadExtremes } },
        credits: { enabled: false }
    });
    Highcharts.stockChart('chart-niveauxeaux', {
        rangeSelector: { enabled: false },
        title: { text: '' },
        xAxis: { ordinal: false },
        yAxis: [
            { title: { text: 'Humidité sol / Pluie' }, opposite: false },
            { title: { text: 'Temp. eau (°C)' }, opposite: true }
        ],
        series: [
            { name: 'Humid. sol', data: zipSeries(reading_time, HumidSol), type: 'areaspline', color: '#27ae60', fillOpacity: 0.15, yAxis: 0 },
            { name: 'Pluie', data: zipSeries(reading_time, Pluie), type: 'column', color: '#9b59b6', yAxis: 0 },
            { name: 'Temp. eau', data: zipSeries(reading_time, TempEau), type: 'spline', color: '#008B74', yAxis: 1, tooltip: { valueSuffix: ' °C' }},
            { name: 'Reset', data: zipSeries(reading_time, resetMode), type: 'column', color: '#bdc3c7', yAxis: 0 }
        ],
        legend: { enabled: true, align: 'center', verticalAlign: 'bottom', itemStyle: { cursor: 'pointer' } },
        chart: { backgroundColor: 'transparent', height: 420, events: { load: chartLoadExtremes } },
        credits: { enabled: false }
    });
    Highcharts.stockChart('chart-cycles', {
        rangeSelector: { enabled: false },
        title: { text: '' },
        xAxis: { ordinal: false },
        yAxis: [
            { title: { text: 'Cycles / Servos' }, opposite: false },
            { title: { text: 'Batterie' }, opposite: true }
        ],
        series: [
            { name: 'bootCount', data: zipSeries(reading_time, bootCount), type: 'spline', color: '#2c3e50', yAxis: 0 },
            { name: 'PontDiv', data: zipSeries(reading_time, PontDiv), type: 'spline', color: '#e74c3c', yAxis: 1 },
            { name: 'ServoHB', data: zipSeries(reading_time, ServoHB), type: 'spline', color: '#3498db', yAxis: 0 },
            { name: 'ServoGD', data: zipSeries(reading_time, ServoGD), type: 'spline', color: '#f39c12', yAxis: 0 }
        ],
        legend: { enabled: true, align: 'center', verticalAlign: 'bottom', itemStyle: { cursor: 'pointer' } },
        chart: { backgroundColor: 'transparent', height: 380, events: { load: chartLoadExtremes } },
        credits: { enabled: false }
    });
    })();
    </script>
    {% endif %}

    <script src="{{ base_path }}/assets/js/toast-notifications.js"></script>
    <script src="{{ base_path }}/assets/js/chart-updater-generic.js"></script>
    <script src="{{ base_path }}/assets/js/realtime-updater.js"></script>
    {% if measure_count > 0 %}
    {% include 'partials/_chart_init_js.twig' with {
        chart_ids_json: chart_ids_json,
        chart_debug: true,
        sensor_map_json: sensor_map_json
    } %}
    {% endif %}
    {% include 'partials/_realtime_init_js.twig' with {
        realtime_api_base: realtime_api_base,
        poll_interval: 15000,
        base_path: base_path|default('')
    } %}
{% endblock %}

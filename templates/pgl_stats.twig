{% extends 'layout.twig' %}

{% block title %}Poissonglouton - Données{% endblock %}

{% block meta_description %}Compteur recyclage plastique des bouteilles recyclées — suivi en temps réel (poisson glouton).{% endblock %}

{% block head_css %}
    <link rel="stylesheet" href="{{ base_path }}/assets/css/common-data.css" />
{% endblock %}

{% block head_scripts %}
    <script src="{{ base_path }}/assets/js/moment.min.js"></script>
    <script src="{{ base_path }}/assets/js/moment-timezone-with-data.min.js"></script>
    <script src="{{ base_path }}/assets/js/highstock.js"></script>
    <script src="{{ base_path }}/assets/js/exporting.js"></script>
    <script src="{{ base_path }}/assets/js/export-data.js"></script>
    <script src="{{ base_path }}/assets/js/accessibility.js"></script>
    <script src="{{ base_path }}/assets/js/highcharts-defaults.js"></script>
    <script src="{{ base_path }}/assets/js/chart-helpers.js"></script>
    <script src="{{ base_path }}/assets/js/n3-stock-chart-layout.js"></script>
    <script src="{{ base_path }}/assets/js/n3-stock-chart-bootstrap.js"></script>
{% endblock %}

{% block content %}
    {% include 'partials/_hero_data.twig' with {
        hero_title: 'Poissonglouton',
        hero_icon: 'fa-fish',
        hero_subtitle: 'Statistiques d’absorption des bouteilles plastique recyclées — mise à jour en direct',
        hero_synthesis: '📊 Synthèse du ' ~ start_date|localdt('d/m/Y H:i') ~ ' au ' ~ end_date|localdt('d/m/Y H:i') ~ ' — ' ~ measure_count ~ ' événements — fenêtre fixe 72h'
    } %}

    <article class="post featured">
        {% include 'partials/_filter_health_row.twig' with {
            form_id: 'pglFilterForm',
            data_config: { form_action: '/pgl' },
            show_filter_form: false
        } %}

        <div class="section-header alt-section-title-full" data-aos="fade-up">
            <i class="fas fa-recycle"></i>
            <h3>Suivi temps réel</h3>
        </div>

        <div class="alt-data-chart-row" data-aos="fade-up">
            <div class="alt-stats-column">
                {% include 'partials/_stat_cards.twig' with { sensors_config: sensors_config } %}
            </div>
            <div class="alt-chart-column">
                <div id="chart-hourly" class="n3-chart-main"></div>
            </div>
        </div>

        <div class="alt-data-chart-row" data-aos="fade-up">
            <div class="alt-chart-column">
                <div id="chart-cumulative" class="n3-chart-main"></div>
            </div>
        </div>
    </article>
{% endblock %}

{% block footer %}
    {% include 'partials/_footer.twig' %}
{% endblock %}

{% block scripts %}
    {% include 'partials/_live_badge.twig' %}

    <script>
    (function() {
        // Séries initiales (72 buckets horaires)
        window.pglRealtime = window.pglRealtime || {};
        window.pglRealtime.reading_time = {{ reading_time|json_encode(15)|raw }};
        window.pglRealtime.count_delta_series = {{ count_delta_series|json_encode(15)|raw }};
        window.pglRealtime.total_count_series = {{ total_count_series|json_encode(15)|raw }};
    })();
    </script>

    <script>
    (function() {
        var bootstrap = window.n3StockChartBootstrap;
        if (!bootstrap) {
            console.warn('[pgl] n3StockChartBootstrap indisponible');
            return;
        }

        bootstrap.ensureContainersReady(
            ['chart-hourly', 'chart-cumulative'],
            function () {
                bootstrap.createStockChart('chart-hourly', 'main', {
                    yAxis: [
                        { title: { text: 'Compteurs / heure' }, opposite: false }
                    ],
                    series: [
                        { name: 'Heure', data: zipSeries(window.pglRealtime.reading_time, window.pglRealtime.count_delta_series), type: 'column', color: '#f39c12', lineWidth: 2 }
                    ]
                });

                bootstrap.createStockChart('chart-cumulative', 'main', {
                    yAxis: [
                        { title: { text: 'Total recyclé (cumul)' }, opposite: false }
                    ],
                    series: [
                        { name: 'Cumul', data: zipSeries(window.pglRealtime.reading_time, window.pglRealtime.total_count_series), type: 'areaspline', color: '#008B74', fillColor: n3AreaGradientFill(0, 139, 116), lineWidth: 2 }
                    ]
                });
            }
        );
    })();
    </script>

    <script src="{{ base_path }}/assets/js/toast-notifications.js"></script>
    <script src="{{ base_path }}/assets/js/chart-updater-generic.js"></script>
    <script src="{{ base_path }}/assets/js/realtime-updater.js"></script>

    {% include 'partials/_chart_init_js.twig' with {
        chart_ids_json: chart_ids_json,
        chart_debug: true,
        sensor_map_json: sensor_map_json
    } %}

    {% include 'partials/_realtime_init_js.twig' with {
        realtime_api_base: realtime_api_base,
        poll_interval: 15000,
        base_path: base_path|default('')
    } %}
{% endblock %}

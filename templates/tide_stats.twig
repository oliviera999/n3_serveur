{% extends 'layout.twig' %}

{% block title %}Statistiques marée – Aquaponie{% endblock %}

{% block head_css %}
    <link rel="stylesheet" href="{{ base_path }}/assets/css/common-data.css" />
{% endblock %}

{% block head_scripts %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="{{ base_path }}/assets/js/chartjs-theme.js"></script>
{% endblock %}

{% block styles %}{% endblock %}

{% block content %}
    {# Ordre des sections : header, info-banner, Résultats principaux, Variations réserve, DiffMaree, Évolution (graphiques), Filtrage période #}
    <article class="post featured">
        <header class="major" data-aos="fade-up">
            <h1>
                <i class="icon solid fa-water"></i>
                Statistiques avancées des marées
                <i class="icon solid fa-water"></i>
            </h1>
            <p>Analyse des cycles de marée du système aquaponique</p>
            <hr />
        </header>

        <!-- Bannière période -->
        <div class="info-banner" data-aos="fade-up">
            <div class="info-banner-title">📊 Période analysée</div>
            <div class="info-banner-value">
                Du {{ start_date|localdt('d/m/Y H:i:s') }} au {{ end_date|localdt('d/m/Y H:i:s') }}
            </div>
        </div>
        <p class="tide-stats-definitions"><strong>Définitions :</strong> <em>Marnage</em> = amplitude de variation du niveau d'eau sur un cycle (distance max − min, en cm). <em>DiffMaree</em> = variation de la distance capteur → surface de l'aquarium sur une fenêtre temporelle (mm, valeur brute firmware) ; positif = eau qui monte.</p>

        <!-- Section Résultats principaux -->
        <div class="section-header" data-aos="fade-up">
            <i class="fas fa-chart-line"></i>
            <h3>Résultats principaux</h3>
        </div>
        
        <div class="stats-grid" data-aos="fade-up">
            <div class="stat-card">
                <i class="fas fa-arrows-alt-v stat-card-icon"></i>
                <div class="stat-card-label">Marnage moyen</div>
                <div class="stat-card-value">{{ marnage_moyen is not null ? marnage_moyen|number_format(1, ',', ' ') : 'n/a' }} <span class="stat-card-unit">cm</span></div>
            </div>
            
            <div class="stat-card">
                <i class="fas fa-rotate stat-card-icon"></i>
                <div class="stat-card-label">Cycles détectés</div>
                <div class="stat-card-value">{{ cycles }}</div>
            </div>
            
            <div class="stat-card">
                <i class="fas fa-clock stat-card-icon"></i>
                <div class="stat-card-label">Fréquence</div>
                <div class="stat-card-value">{{ frequence_marees is not null ? frequence_marees|number_format(2, ',', ' ') : 'n/a' }} <span class="stat-card-unit">cycles/h</span></div>
            </div>
        </div>

        <!-- Section Variations réserve -->
        <div class="section-header" data-aos="fade-up">
            <i class="fas fa-droplet"></i>
            <h3>Variations de la réserve</h3>
        </div>
        
        <div class="stats-grid" data-aos="fade-up">
            <div class="stat-card positive">
                <i class="fas fa-arrow-up stat-card-icon"></i>
                <div class="stat-card-label">Variation positive</div>
                <div class="stat-card-value">{{ reserve_pos|number_format(1, ',', ' ') }} <span class="stat-card-unit">cm</span></div>
            </div>
            
            <div class="stat-card negative">
                <i class="fas fa-arrow-down stat-card-icon"></i>
                <div class="stat-card-label">Variation négative</div>
                <div class="stat-card-value">{{ reserve_neg|number_format(1, ',', ' ') }} <span class="stat-card-unit">cm</span></div>
            </div>
            
            <div class="stat-card neutral">
                <i class="fas fa-chart-simple stat-card-icon"></i>
                <div class="stat-card-label">Variation globale</div>
                <div class="stat-card-value">{{ reserve_var|number_format(1, ',', ' ') }} <span class="stat-card-unit">cm</span></div>
            </div>
        </div>

        <!-- Section DiffMaree -->
        <div class="section-header" data-aos="fade-up">
            <i class="fas fa-wave-square"></i>
            <h3>Statistiques DiffMaree</h3>
        </div>
        
        <div class="stats-grid" data-aos="fade-up">
            <div class="stat-card">
                <i class="fas fa-chart-line stat-card-icon"></i>
                <div class="stat-card-label">Moyenne</div>
                <div class="stat-card-value">{{ diff_maree.moyenne is not null ? diff_maree.moyenne|number_format(2, ',', ' ') : 'n/a' }} <span class="stat-card-unit">cm</span></div>
            </div>
            
            <div class="stat-card">
                <i class="fas fa-down-long stat-card-icon"></i>
                <div class="stat-card-label">Minimum</div>
                <div class="stat-card-value">{{ diff_maree.min is not null ? diff_maree.min|number_format(2, ',', ' ') : 'n/a' }} <span class="stat-card-unit">cm</span></div>
            </div>
            
            <div class="stat-card">
                <i class="fas fa-up-long stat-card-icon"></i>
                <div class="stat-card-label">Maximum</div>
                <div class="stat-card-value">{{ diff_maree.max is not null ? diff_maree.max|number_format(2, ',', ' ') : 'n/a' }} <span class="stat-card-unit">cm</span></div>
            </div>
            
            <div class="stat-card">
                <i class="fas fa-chart-area stat-card-icon"></i>
                <div class="stat-card-label">Écart-type</div>
                <div class="stat-card-value">{{ diff_maree.ecart_type is not null ? diff_maree.ecart_type|number_format(2, ',', ' ') : 'n/a' }} <span class="stat-card-unit">cm</span></div>
            </div>
        </div>

        <hr/>

        <!-- Section Évolution -->
        <div class="section-header" data-aos="fade-up">
            <i class="fas fa-chart-bar"></i>
            <h3>Évolution sur les 6 derniers mois (moyenne hebdomadaire)</h3>
        </div>

        <div class="chart-container" data-aos="fade-up">
            <div class="chart-title">📈 Marnage moyen</div>
            <canvas id="chartMarnage" height="100"></canvas>
        </div>
        
        <div class="chart-container" data-aos="fade-up">
            <div class="chart-title">🔄 Fréquence des marées</div>
            <canvas id="chartFrequence" height="100"></canvas>
        </div>
        
        <div class="chart-container" data-aos="fade-up">
            <div class="chart-title">⬆️ Variation positive réserve</div>
            <canvas id="chartReservePos" height="100"></canvas>
        </div>
        
        <div class="chart-container" data-aos="fade-up">
            <div class="chart-title">⬇️ Variation négative réserve</div>
            <canvas id="chartReserveNeg" height="100"></canvas>
        </div>
        
        <div class="chart-container" data-aos="fade-up">
            <div class="chart-title">📊 Variation globale réserve</div>
            <canvas id="chartReserveVar" height="100"></canvas>
        </div>
        
        <!-- Graphiques DiffMaree -->
        <div class="section-header" data-aos="fade-up">
            <i class="fas fa-wave-square"></i>
            <h3>Évolution DiffMaree</h3>
        </div>
        
        <div class="chart-container" data-aos="fade-up">
            <div class="chart-title">📈 DiffMaree moyenne</div>
            <canvas id="chartDiffMareeMoyenne" height="100"></canvas>
        </div>
        
        <div class="chart-container" data-aos="fade-up">
            <div class="chart-title">📉 DiffMaree minimum</div>
            <canvas id="chartDiffMareeMin" height="100"></canvas>
        </div>
        
        <div class="chart-container" data-aos="fade-up">
            <div class="chart-title">📈 DiffMaree maximum</div>
            <canvas id="chartDiffMareeMax" height="100"></canvas>
        </div>

        <hr/>

        <!-- Section Filtrage -->
        <div class="section-header" data-aos="fade-up">
            <i class="fas fa-filter"></i>
            <h3>Choisir une autre période</h3>
        </div>

        <div class="filter-section" data-aos="fade-up">
            <!-- Filtres rapides (chart-helpers.js setPeriod attend start_datetime / end_datetime) -->
            <div class="quick-filters">
                <button type="button" class="quick-filter-btn" onclick="setPeriod(1, 'hours')">
                    <i class="far fa-clock"></i> 1 heure
                </button>
                <button type="button" class="quick-filter-btn" onclick="setPeriod(6, 'hours')">
                    <i class="far fa-clock"></i> 6 heures
                </button>
                <button type="button" class="quick-filter-btn" onclick="setPeriod(1, 'days')">
                    <i class="far fa-calendar"></i> 1 jour
                </button>
                <button type="button" class="quick-filter-btn" onclick="setPeriod(7, 'days')">
                    <i class="far fa-calendar-alt"></i> 1 semaine
                </button>
                <button type="button" class="quick-filter-btn" onclick="setPeriod(30, 'days')">
                    <i class="far fa-calendar-alt"></i> 1 mois
                </button>
            </div>

            <form method="POST" id="tideStatsFilterForm">
                {{ csrf_field|raw }}
                <div class="datetime-grid">
                    <div class="datetime-field">
                        <label for="tide_stats_start_datetime">Début</label>
                        <input type="datetime-local" id="tide_stats_start_datetime" name="start_datetime" value="{{ start_date|localdt('Y-m-d') }}T{{ start_date|localdt('H:i') }}" required step="60">
                    </div>
                    <div class="datetime-field">
                        <label for="tide_stats_end_datetime">Fin</label>
                        <input type="datetime-local" id="tide_stats_end_datetime" name="end_datetime" value="{{ end_date|localdt('Y-m-d') }}T{{ end_date|localdt('H:i') }}" required step="60">
                    </div>
                </div>
                <button type="submit" class="btn-primary">
                    <i class="fas fa-chart-line"></i> Analyser la période
                </button>
            </form>
        </div>
    </article>
{% endblock %}

{% block footer %}
{% include 'partials/_footer.twig' with {'footer_text': "Système d'aquaponie FFP3"} %}
{% endblock %}

{% block scripts %}
    {% include 'partials/_live_badge.twig' %}
    <script src="{{ base_path }}/assets/js/chart-helpers.js"></script>
    <script src="{{ base_path }}/assets/js/toast-notifications.js"></script>
    <script src="{{ base_path }}/assets/js/realtime-updater.js"></script>
    <script src="{{ base_path }}/assets/js/pwa-init.js"></script>
    <script>
    function setPeriod(value, unit) {
        var now = new Date();
        var start = new Date(now);
        if (unit === 'hours') start.setHours(start.getHours() - value);
        else if (unit === 'days') start.setDate(start.getDate() - value);
        var fmt = function(d) {
            var y = d.getFullYear(), m = String(d.getMonth() + 1).padStart(2, '0'), day = String(d.getDate()).padStart(2, '0');
            var h = String(d.getHours()).padStart(2, '0'), min = String(d.getMinutes()).padStart(2, '0');
            return y + '-' + m + '-' + day + 'T' + h + ':' + min;
        };
        var form = document.getElementById('tideStatsFilterForm');
        if (form) {
            var startEl = form.querySelector('#tide_stats_start_datetime');
            var endEl = form.querySelector('#tide_stats_end_datetime');
            if (startEl) startEl.value = fmt(start);
            if (endEl) endEl.value = fmt(now);
            form.submit();
        }
    }
    </script>
    <script>
        const weeklyStats = {{ weekly_stats_json|raw }};
        const labels = weeklyStats.labels;

        function lineChart(ctxId, label, data, color) {
            new Chart(document.getElementById(ctxId), {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: label,
                        data: data,
                        borderColor: color,
                        backgroundColor: color,
                        fill: false,
                        tension: 0.2,
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        x: { display: true, title: { display: false } },
                        y: { display: true, beginAtZero: true }
                    }
                }
            });
        }

        lineChart('chartMarnage', 'Marnage moyen (cm)', weeklyStats.marnage_moyen, 'rgba(54, 162, 235, 1)');
        lineChart('chartFrequence', 'Fréquence (cycles/h)', weeklyStats.frequence_marees, 'rgba(255, 99, 132, 1)');
        lineChart('chartReservePos', 'Variation positive réserve (cm)', weeklyStats.reserve_pos, 'rgba(75, 192, 192, 1)');
        lineChart('chartReserveNeg', 'Variation négative réserve (cm)', weeklyStats.reserve_neg, 'rgba(255, 159, 64, 1)');
        lineChart('chartReserveVar', 'Variation globale réserve (cm)', weeklyStats.reserve_var, 'rgba(153, 102, 255, 1)');
        lineChart('chartDiffMareeMoyenne', 'DiffMaree moyenne (cm)', weeklyStats.diff_maree_moyenne, 'rgba(255, 206, 86, 1)');
        lineChart('chartDiffMareeMin', 'DiffMaree minimum (cm)', weeklyStats.diff_maree_min, 'rgba(75, 192, 192, 1)');
        lineChart('chartDiffMareeMax', 'DiffMaree maximum (cm)', weeklyStats.diff_maree_max, 'rgba(255, 99, 132, 1)');
    </script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const apiBasePath = '{{ realtime_api_base|default("/api/realtime") }}';
            initRealtimeUpdater({
                apiBasePath: apiBasePath,
                pollInterval: 30000,
                enabled: true,
                onNewData: function(data) {
                    console.log('[Tide Stats] New sensor data received:', data);
                },
                onHealthUpdate: function(health) {
                    console.log('[Tide Stats] System health updated:', health);
                }
            });
        });
    </script>
{% endblock %}

{% extends 'layout.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block head_css %}
    <link rel="stylesheet" href="{{ base_path }}/assets/css/control-styles.css" />
{% endblock %}

{% block head_scripts %}
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
{% endblock %}

{% block body_tag %}<body class="is-preload" data-environment="{{ environment }}">{% endblock %}

{% block wrapper_class %} control-wrapper{% endblock %}

{% block before_wrapper %}
    <div id="control-sync-badge" class="connecting">CONNEXION...</div>
{% endblock %}

{% block content %}
    <div class="control-layout">
        {# ===== SIDEBAR ===== #}
        <aside class="panel">
            <section>
                <div class="context-badges">
                    <span class="context-badge"><i class="fas fa-globe"></i> {{ environment|upper }}</span>
                    <span class="context-badge"><i class="fas fa-code-branch"></i> {{ version }}</span>
                    {% if firmware_version %}<span class="context-badge"><i class="fas fa-microchip"></i> FW {{ firmware_version }}</span>{% endif %}
                </div>
                <div class="context-summary">
                    <h2><i class="fas fa-sliders-h"></i> Station météo</h2>
                    <p class="context-description">Contrôle des sorties et paramètres de la station météo (Le potager). Les commandes sont transmises à l'ESP32 au prochain cycle de synchronisation.</p>
                    <div class="context-stats">
                        <div class="context-stat">
                            <span class="stat-label">Sorties</span>
                            <span class="stat-value">{{ outputs|length }}</span>
                        </div>
                        <div class="context-stat">
                            <span class="stat-label">Board</span>
                            <span class="stat-value">{{ board }}</span>
                        </div>
                    </div>
                </div>
            </section>
            <section class="boards-status">
                <h3><i class="fas fa-satellite-dish"></i> Connexion</h3>
                <div class="board-card">
                    <header>
                        <span class="board-title"><i class="fas fa-microchip"></i> Board {{ board }}</span>
                        <span class="board-last">{{ last_board_request|default('N/A') }}</span>
                    </header>
                </div>
            </section>
        </aside>

        {# ===== MAIN ===== #}
        <section class="panel control-main">
            <header class="control-main-header">
                <h1><i class="fas fa-sun"></i> Contrôle MSP – Le potager</h1>
                <p>Activez/désactivez les sorties et configurez les paramètres du firmware msp2_5.</p>
                <div class="callout callout-warning">
                    <i class="fas fa-triangle-exclamation"></i>
                    <span>Les commandes agissent sur le système physique. Vérifiez sur site avant d'activer les sorties.</span>
                </div>
            </header>

            <section class="controls-section">
                {# ===== SORTIES (premiers GPIO : actionneurs physiques) ===== #}
                <h2><i class="fas fa-bolt"></i> Sorties</h2>
                <div class="control-cards-grid">
                    {% for output in outputs %}
                        {% if output.gpio is defined and output.gpio < 100 %}
                        <article class="action-card" data-state="{{ output.state }}" data-gpio="{{ output.gpio }}">
                            <header>
                                <div class="action-icon"><i class="fas fa-plug"></i></div>
                                <div><h3>{{ output.name|default('GPIO ' ~ output.gpio) }}</h3></div>
                            </header>
                            <footer>
                                <span data-state-label>{{ output.state == '1' ? 'Activé' : 'Désactivé' }}</span>
                                <label class="modern-switch">
                                    <input type="checkbox" onchange="updateOutput(this)" data-id="{{ output.id }}" data-gpio="{{ output.gpio }}" data-name="{{ output.name }}" {{ output.state == '1' ? 'checked' : '' }} role="switch" aria-checked="{{ output.state == '1' ? 'true' : 'false' }}" aria-label="{{ output.name|default('GPIO ' ~ output.gpio) }}">
                                    <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                                </label>
                            </footer>
                        </article>
                        {% endif %}
                    {% endfor %}
                </div>

                {# ===== PARAMÈTRES (GPIO 100+) ===== #}
                <h2><i class="fas fa-cog"></i> Paramètres</h2>
                <div class="control-cards-grid">
                    {% for output in outputs %}
                        {% if output.gpio is defined and output.gpio >= 100 %}
                        {% set labels = { '100': 'Mail', '101': 'Notification mail', '102': 'Seuil sécheresse', '103': 'Seuil pont diviseur', '104': 'Servo HB', '105': 'Servo GD', '106': 'Éco énergie (WakeUp)', '107': 'Fréquence réveil', '110': 'Reset ESP' } %}
                        {% set icons = { '100': 'fa-envelope', '101': 'fa-bell', '102': 'fa-seedling', '103': 'fa-battery-half', '104': 'fa-arrows-up-down', '105': 'fa-arrows-left-right', '106': 'fa-moon', '107': 'fa-clock', '110': 'fa-arrows-rotate' } %}
                        {% set gpioStr = output.gpio ~ '' %}
                        <article class="action-card {{ output.gpio == 110 ? 'warning' : '' }}" data-state="{{ output.state }}" data-gpio="{{ output.gpio }}">
                            <header>
                                <div class="action-icon"><i class="fas {{ icons[gpioStr]|default('fa-cog') }}"></i></div>
                                <div><h3>{{ labels[gpioStr]|default(output.name|default('GPIO ' ~ output.gpio)) }}</h3></div>
                            </header>
                            <footer>
                                <span data-state-label>{{ output.state }}</span>
                                <label class="modern-switch">
                                    <input type="checkbox" onchange="updateOutput(this)" data-id="{{ output.id }}" data-gpio="{{ output.gpio }}" data-name="{{ output.name }}" {{ output.state == '1' ? 'checked' : '' }} role="switch" aria-checked="{{ output.state == '1' ? 'true' : 'false' }}" aria-label="{{ labels[gpioStr]|default(output.name|default('GPIO ' ~ output.gpio)) }}">
                                    <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                                </label>
                            </footer>
                        </article>
                        {% endif %}
                    {% endfor %}
                </div>
            </section>

            <section class="quick-actions">
                <h3><i class="fas fa-bolt"></i> Actions rapides</h3>
                <div class="quick-actions-grid">
                    <a href="{{ base_path|default('') }}/meteo" class="quick-action-card"><i class="fas fa-chart-line"></i> Retour aux données</a>
                    <a href="/" class="quick-action-card"><i class="fas fa-home"></i> Accueil</a>
                </div>
            </section>
        </section>

        <footer id="footer">
            <div class="footer-badges">
                <span class="footer-badge"><i class="fas fa-globe"></i> {{ environment }}</span>
                <span class="footer-badge"><i class="fas fa-database"></i> msp1Outputs</span>
                <span class="footer-badge"><i class="fas fa-code-branch"></i> {{ version }}</span>
                {% if firmware_version %}<span class="footer-badge"><i class="fas fa-microchip"></i> FW {{ firmware_version }}</span>{% endif %}
            </div>
            <p style="margin:0;">Station météo (Le potager) | n3 IoT | © 2025 olution</p>
        </footer>
    </div>
{% endblock %}

{% block footer %}{% endblock %}

{% block scripts %}
    <script>
        window.CONTROL_API_BASE = '{{ base_path|default("") }}{{ outputs_api_base|default("/msp1/api/outputs") }}';
    </script>
    <script src="{{ base_path }}/assets/js/control-sync.js"></script>
    <script src="{{ base_path }}/assets/js/control-values-updater.js"></script>
    <script src="{{ base_path }}/assets/js/toast-notifications.js"></script>
    <script src="{{ base_path }}/assets/js/control-actions.js"></script>
    <script src="{{ base_path }}/assets/js/realtime-updater.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var controlApiBase = window.CONTROL_API_BASE;

            var valuesUpdater = new ControlValuesUpdater();
            valuesUpdater.init();

            var controlSync = new ControlSync({
                apiBase: controlApiBase,
                pollInterval: 10,
                useFresh: true,
                onStatesReceived: function(states) {
                    if (window.controlValuesUpdater && typeof window.controlValuesUpdater.updateParameters === 'function') {
                        window.controlValuesUpdater.updateParameters(states);
                    }
                }
            });
            controlSync.initializeFromDOM();
            controlSync.start();

            window.controlSync = controlSync;
            window.controlValuesUpdater = valuesUpdater;

            initRealtimeUpdater({
                apiBasePath: '{{ realtime_api_base|default("/msp1/api/realtime") }}',
                pollInterval: 15000,
                enabled: true
            });
        });
    </script>
{% endblock %}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title }}</title>
    <link rel="stylesheet" href="https://iot.olution.info/assets/css/main.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" />
    <link rel="shortcut icon" type="image/png" href="/assets/logo.png"/>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 700px; margin: 0 auto; padding: 20px; background: #f5f5f5; }
        .page-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 15px; margin-bottom: 25px; padding-bottom: 15px; border-bottom: 3px solid #008B74; }
        .page-header h1 { margin: 0; color: #2c3e50; font-size: 1.6em; }
        .page-header a { color: #008B74; text-decoration: none; font-weight: 600; }
        .page-header a:hover { text-decoration: underline; }
        .output-list { background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,139,116,0.1); }
        .output-row { display: flex; align-items: center; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #eee; gap: 15px; flex-wrap: wrap; }
        .output-row:last-child { border-bottom: none; }
        .output-name { font-weight: 600; color: #2c3e50; }
        .output-state { font-size: 0.9em; color: #7f8c8d; }
        .btn-toggle { padding: 8px 18px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 0.9em; transition: all 0.2s; }
        .btn-on { background: #008B74; color: white; }
        .btn-off { background: #e0e0e0; color: #555; }
        .btn-toggle:hover { opacity: 0.9; transform: scale(1.02); }
        .no-outputs { text-align: center; padding: 40px 20px; color: #7f8c8d; }
        .msg { margin-top: 15px; padding: 10px; border-radius: 8px; display: none; }
        .msg.success { background: #d4edda; color: #155724; }
        .msg.error { background: #f8d7da; color: #721c24; }
    </style>
</head>
<body>
    <div class="page-header">
        <h1><i class="fas fa-sliders-h"></i> {{ page_title }}</h1>
        <nav>
            <a href="/"><i class="fas fa-home"></i> Accueil</a>
            &nbsp;|&nbsp;
            <a href="/msp1/msp1datas/msp1-data.php">Données</a>
        </nav>
    </div>

    <div class="output-list">
        {% if outputs is not empty %}
            {% for row in outputs %}
            <div class="output-row" data-name="{{ row.name }}">
                <div>
                    <span class="output-name">{{ row.name }}</span>
                    <span class="output-state">({{ row.state == '1' ? 'ON' : 'OFF' }})</span>
                </div>
                <form method="post" action="/msp1/msp1control/msp1-outputs-action.php" class="form-toggle" style="display:inline;">
                    <input type="hidden" name="action" value="set" />
                    <input type="hidden" name="name" value="{{ row.name }}" />
                    <input type="hidden" name="board" value="{{ board }}" />
                    <input type="hidden" name="state" value="{{ row.state == '1' ? '0' : '1' }}" />
                    <button type="submit" class="btn-toggle {{ row.state == '1' ? 'btn-on' : 'btn-off' }}">
                        {{ row.state == '1' ? 'Éteindre' : 'Allumer' }}
                    </button>
                </form>
            </div>
            {% endfor %}
        {% else %}
            <div class="no-outputs">Aucun output configuré pour cette board (board={{ board }}).</div>
        {% endif %}
    </div>

    <div id="msg" class="msg"></div>

    <script>
        document.querySelectorAll('.form-toggle').forEach(function(form) {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                var f = this;
                var btn = f.querySelector('button[type="submit"]');
                btn.disabled = true;
                fetch(f.action, { method: 'POST', body: new FormData(f) })
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (data.success) { window.location.reload(); }
                        else { document.getElementById('msg').textContent = data.error || 'Erreur'; document.getElementById('msg').className = 'msg error'; document.getElementById('msg').style.display = 'block'; }
                    })
                    .catch(function() { document.getElementById('msg').textContent = 'Erreur réseau'; document.getElementById('msg').className = 'msg error'; document.getElementById('msg').style.display = 'block'; })
                    .finally(function() { btn.disabled = false; });
            });
        });
    </script>
</body>
</html>

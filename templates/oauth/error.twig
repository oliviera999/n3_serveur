{% extends 'layout.twig' %}
{# Erreur OAuth non redirigeable (client inconnu, redirect_uri refusée). #}
{% set page_family = 'entry' %}

{% block title %}{{ page_title }}{% endblock %}

{% block head_css %}
<link rel="stylesheet" href="{{ base_path }}/assets/css/login-styles.css" />
{% endblock %}

{% block body_tag %}<body class="login-page">{% endblock %}

{% block content %}
<div class="login-center">
    <div class="login-container">
        <div class="login-box">
            <div class="login-header">
                <i class="fas fa-ban" aria-hidden="true"></i>
                <h1>{{ error_title }}</h1>
            </div>
            <div class="alert alert-error" role="alert">{{ error_message }}</div>
            <p class="login-footer-link-row">
                <a href="{{ base_path|default('') }}/" class="login-footer-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> Retour à l'accueil</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}

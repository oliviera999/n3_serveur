{% extends 'layout.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block wrapper_class %} gallery-page-wrapper{% endblock %}

{% block head_css %}
<link rel="stylesheet" href="{{ base_path|default('') }}/assets/css/gallery-styles.css" />
<style>
.trash-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 16px 0;
    padding: 14px 16px;
    background: #fff3cd;
    border: 1px solid #ffc107;
    border-radius: 10px;
}
[data-theme="dark"] .trash-toolbar {
    background: rgba(255, 193, 7, 0.12);
    border-color: rgba(255, 193, 7, 0.3);
}
.trash-toolbar .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
}
.trash-toolbar .btn:hover { transform: translateY(-1px); }
.trash-toolbar .btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
.btn-restore { background: #008B74; color: #fff; }
.btn-restore:hover:not(:disabled) { background: #00B794; }
.btn-purge { background: #dc3545; color: #fff; }
.btn-purge:hover:not(:disabled) { background: #c82333; }
.btn-purge-all { background: #6c757d; color: #fff; }
.btn-purge-all:hover:not(:disabled) { background: #545b62; }
.btn-select-all { background: #e9ecef; color: #2c3e50; }
[data-theme="dark"] .btn-select-all { background: var(--bg-card); color: var(--text-primary); }
.btn-select-all:hover:not(:disabled) { background: #dee2e6; }
.trash-count { font-weight: 600; color: #856404; }
[data-theme="dark"] .trash-count { color: #ffc107; }
.trash-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
}
.trash-nav a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: #f8f9fa;
    border: 1px solid rgba(0,139,116,0.2);
    border-radius: 8px;
    text-decoration: none;
    color: #2c3e50;
    font-weight: 500;
    font-size: 0.9rem;
    transition: all 0.15s;
}
[data-theme="dark"] .trash-nav a {
    background: var(--bg-card);
    border-color: var(--accent-border);
    color: var(--text-primary);
}
.trash-nav a:hover { background: #008B74; color: #fff; border-color: #008B74; }
.trash-nav a.active { background: #008B74; color: #fff; border-color: #008B74; font-weight: 700; }
.trash-nav .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 10px;
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(220,53,69,0.15);
    color: #dc3545;
}
.trash-nav a.active .badge { background: rgba(255,255,255,0.25); color: #fff; }
.trash-reason {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
}
.reason-too_bright { background: #fff3cd; color: #856404; }
.reason-too_dark { background: #343a40; color: #f8f9fa; }
.reason-corrupted { background: #f8d7da; color: #721c24; }
.reason-manual { background: #e2e3e5; color: #383d41; }
.reason-unknown { background: #e2e3e5; color: #383d41; }
.gallery-item-check {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    width: 22px;
    height: 22px;
    cursor: pointer;
    accent-color: #008B74;
}
.gallery-item { position: relative; }
.gallery-item-meta {
    padding: 6px 8px;
    font-size: 0.8rem;
    color: #6c757d;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
}
[data-theme="dark"] .gallery-item-meta { color: var(--text-secondary); }
.trash-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    padding: 12px 20px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.9rem;
    color: #fff;
    box-shadow: 0 4px 16px rgba(0,0,0,0.2);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.3s, transform 0.3s;
    pointer-events: none;
}
.trash-toast.show { opacity: 1; transform: translateY(0); pointer-events: auto; }
.trash-toast.success { background: #008B74; }
.trash-toast.error { background: #dc3545; }
</style>
{% endblock %}

{% block content %}
<div class="gallery-page">
    <div class="gallery-links" data-aos="fade-up">
        <a href="{{ base_path|default('') }}/supervision" class="gallery-back"><i class="fas fa-cog"></i> Supervision</a>
        <a href="{{ base_path|default('') }}/gallery" class="gallery-back"><i class="fas fa-th-large"></i> Galeries</a>
        <a href="{{ base_path|default('') }}/admin/gallery/{{ gallery_slug }}" class="gallery-back"><i class="fas fa-images"></i> Galerie {{ gallery_slug }}</a>
    </div>

    <div class="gallery-hero" data-aos="fade-up">
        <h1><i class="fas fa-trash-alt"></i> {{ gallery_title }}</h1>
        <p>Photos retirées automatiquement (surexposées, sous-exposées, corrompues) ou manuellement. Vous pouvez les restaurer ou les supprimer définitivement.</p>
    </div>

    <nav class="trash-nav" data-aos="fade-up">
        {% for s in slugs %}
            <a href="{{ base_path|default('') }}/admin/gallery/{{ s }}/trash" class="{{ s == gallery_slug ? 'active' : '' }}">
                {{ slug_labels[s]|default(s) }}
                {% if trash_counts[s]|default(0) > 0 %}
                    <span class="badge">{{ trash_counts[s] }}</span>
                {% endif %}
            </a>
        {% endfor %}
    </nav>

    {% if images|length > 0 %}
        <div class="trash-toolbar" data-aos="fade-up">
            <button type="button" class="btn btn-select-all" id="selectAllBtn"><i class="fas fa-check-double"></i> Tout sélectionner</button>
            <button type="button" class="btn btn-restore" id="restoreSelectedBtn" disabled><i class="fas fa-undo"></i> Restaurer la sélection</button>
            <button type="button" class="btn btn-purge" id="purgeSelectedBtn" disabled><i class="fas fa-trash"></i> Supprimer la sélection</button>
            <button type="button" class="btn btn-purge-all" id="purgeAllBtn"><i class="fas fa-dumpster-fire"></i> Vider la corbeille ({{ total_images }})</button>
            <span class="trash-count"><span id="selectedCount">0</span> / {{ total_images }} sélectionnée(s)</span>
        </div>

        <div class="gallery-grid" data-aos="fade-up">
            {% for item in images %}
                <div class="gallery-item" data-filename="{{ item.filename }}">
                    <input type="checkbox" class="gallery-item-check" value="{{ item.filename }}" aria-label="Sélectionner {{ item.filename }}" />
                    <a class="gallery-item-link" href="{{ base_path|default('') }}/admin/gallery/{{ gallery_slug }}/trash/files/{{ item.filename }}">
                        <img src="{{ base_path|default('') }}/admin/gallery/{{ gallery_slug }}/trash/files/{{ item.filename }}" alt="{{ item.filename }}" loading="lazy" />
                    </a>
                    <div class="gallery-item-meta">
                        <span class="trash-reason reason-{{ item.reason|default('unknown') }}">{{ item.reason|default('?') }}</span>
                        {% if item.trashed_at %}
                            <span title="Date de mise en corbeille">{{ item.trashed_at|slice(0,10) }}</span>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

        <div id="galleryLightbox" class="gallery-lightbox" aria-hidden="true">
            <button type="button" class="gallery-lightbox-close" aria-label="Fermer">&times;</button>
            <button type="button" class="gallery-lightbox-prev" aria-label="Précédente"><i class="fas fa-chevron-left"></i></button>
            <img class="gallery-lightbox-img" src="" alt="" />
            <button type="button" class="gallery-lightbox-next" aria-label="Suivante"><i class="fas fa-chevron-right"></i></button>
            <div class="gallery-lightbox-caption"></div>
        </div>

        {% if max_page > 1 %}
            <nav class="gallery-pagination" aria-label="Pagination">
                {% if current_page > 1 %}
                    <a href="?page={{ current_page - 1 }}" class="gallery-nav-prevnext">&laquo; Précédent</a>
                {% endif %}
                {% for p in 1..max_page %}
                    {% if p == current_page %}
                        <span class="current" aria-current="page">{{ p }}</span>
                    {% else %}
                        <a href="?page={{ p }}">{{ p }}</a>
                    {% endif %}
                {% endfor %}
                {% if current_page < max_page %}
                    <a href="?page={{ current_page + 1 }}" class="gallery-nav-prevnext">Suivant &raquo;</a>
                {% endif %}
            </nav>
        {% endif %}
        <p class="gallery-photo-count">{{ total_images }} photo(s) en corbeille</p>
    {% else %}
        <div class="gallery-empty">
            <i class="fas fa-check-circle"></i>
            <p>La corbeille est vide.</p>
            <p>Les photos problématiques (trop claires, trop sombres, corrompues) y sont envoyées automatiquement à l'upload.</p>
        </div>
    {% endif %}
</div>

<div id="trashToast" class="trash-toast"></div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script src="{{ base_path|default('') }}/assets/js/confirm-modal.js"></script>
<script>
(function() {
    var BASE = '{{ base_path|default("") }}';
    var SLUG = '{{ gallery_slug }}';
    var API_PREFIX = BASE + '/admin/api/gallery/' + SLUG;

    function getSelected() {
        return Array.from(document.querySelectorAll('.gallery-item-check:checked')).map(function(cb) { return cb.value; });
    }

    function updateUI() {
        var sel = getSelected();
        var count = sel.length;
        var countEl = document.getElementById('selectedCount');
        if (countEl) countEl.textContent = count;
        var restoreBtn = document.getElementById('restoreSelectedBtn');
        var purgeBtn = document.getElementById('purgeSelectedBtn');
        if (restoreBtn) restoreBtn.disabled = count === 0;
        if (purgeBtn) purgeBtn.disabled = count === 0;
    }

    function showToast(msg, type) {
        var t = document.getElementById('trashToast');
        if (!t) return;
        t.textContent = msg;
        t.className = 'trash-toast ' + type + ' show';
        clearTimeout(t._tid);
        t._tid = setTimeout(function() { t.className = 'trash-toast'; }, 3500);
    }

    function apiCall(endpoint, body) {
        return fetch(API_PREFIX + endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        }).then(function(r) { return r.json(); });
    }

    document.querySelectorAll('.gallery-item-check').forEach(function(cb) {
        cb.addEventListener('change', updateUI);
    });

    var selectAllBtn = document.getElementById('selectAllBtn');
    if (selectAllBtn) {
        selectAllBtn.addEventListener('click', function() {
            var checks = document.querySelectorAll('.gallery-item-check');
            var allChecked = Array.from(checks).every(function(c) { return c.checked; });
            checks.forEach(function(c) { c.checked = !allChecked; });
            updateUI();
        });
    }

    function setButtonsBusy(busy) {
        var btns = document.querySelectorAll('.trash-toolbar .btn');
        btns.forEach(function(b) { b.disabled = busy; });
    }

    var restoreBtn = document.getElementById('restoreSelectedBtn');
    if (restoreBtn) {
        restoreBtn.addEventListener('click', function() {
            var sel = getSelected();
            if (sel.length === 0) return;
            confirmModal({
                title: 'Restaurer ' + sel.length + ' photo(s)',
                message: 'Les photos sélectionnées seront remises dans la galerie d\'origine.',
                confirmLabel: 'Restaurer',
                onConfirm: function() {
                    setButtonsBusy(true);
                    apiCall('/restore', { filenames: sel }).then(function(data) {
                        showToast(data.restored + ' photo(s) restaurée(s)', 'success');
                        setTimeout(function() { location.reload(); }, 1200);
                    }).catch(function() { showToast('Erreur lors de la restauration', 'error'); setButtonsBusy(false); });
                }
            });
        });
    }

    var purgeBtn = document.getElementById('purgeSelectedBtn');
    if (purgeBtn) {
        purgeBtn.addEventListener('click', function() {
            var sel = getSelected();
            if (sel.length === 0) return;
            confirmModal({
                title: 'Supprimer définitivement ' + sel.length + ' photo(s)',
                message: 'Cette action est irréversible. Les photos seront définitivement effacées.',
                confirmLabel: 'Supprimer définitivement',
                onConfirm: function() {
                    setButtonsBusy(true);
                    apiCall('/purge', { filenames: sel }).then(function(data) {
                        showToast(data.deleted + ' photo(s) supprimée(s)', 'success');
                        setTimeout(function() { location.reload(); }, 1200);
                    }).catch(function() { showToast('Erreur lors de la suppression', 'error'); setButtonsBusy(false); });
                }
            });
        });
    }

    var purgeAllBtn = document.getElementById('purgeAllBtn');
    if (purgeAllBtn) {
        purgeAllBtn.addEventListener('click', function() {
            confirmModal({
                title: 'Vider toute la corbeille',
                message: 'Toutes les photos de la corbeille {{ slug_labels[gallery_slug]|default(gallery_slug) }} seront définitivement supprimées. Cette action est irréversible.',
                confirmLabel: 'Vider la corbeille',
                onConfirm: function() {
                    setButtonsBusy(true);
                    apiCall('/purge-all', {}).then(function(data) {
                        showToast(data.deleted + ' photo(s) supprimée(s)', 'success');
                        setTimeout(function() { location.reload(); }, 1200);
                    }).catch(function() { showToast('Erreur lors du vidage', 'error'); setButtonsBusy(false); });
                }
            });
        });
    }

    // Lightbox
    var links = Array.from(document.querySelectorAll('.gallery-item-link'));
    var lightbox = document.getElementById('galleryLightbox');
    if (lightbox && links.length > 0) {
        var lbImg = lightbox.querySelector('.gallery-lightbox-img');
        var lbCaption = lightbox.querySelector('.gallery-lightbox-caption');
        var currentIndex = 0;

        function updateLb(i) {
            currentIndex = (i + links.length) % links.length;
            lbImg.src = links[currentIndex].getAttribute('href');
            lbCaption.textContent = 'Photo ' + (currentIndex + 1) + ' / ' + links.length;
        }
        var lbTrigger = null;
        var lbCloseBtn = lightbox.querySelector('.gallery-lightbox-close');
        var lbPrevBtn = lightbox.querySelector('.gallery-lightbox-prev');
        var lbNextBtn = lightbox.querySelector('.gallery-lightbox-next');

        function trapLbFocus(e) {
            if (e.key !== 'Tab') return;
            var btns = lightbox.querySelectorAll('button');
            var first = btns[0], last = btns[btns.length - 1];
            if (e.shiftKey) {
                if (document.activeElement === first) { e.preventDefault(); last.focus(); }
            } else {
                if (document.activeElement === last) { e.preventDefault(); first.focus(); }
            }
        }

        function openLb(i, trigger) {
            lbTrigger = trigger || null;
            updateLb(i);
            lightbox.classList.add('gallery-lightbox-open');
            lightbox.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            lbCloseBtn.focus();
            document.addEventListener('keydown', trapLbFocus);
        }
        function closeLb() {
            lightbox.classList.remove('gallery-lightbox-open');
            lightbox.setAttribute('aria-hidden', 'true');
            lbImg.removeAttribute('src');
            document.body.style.overflow = '';
            document.removeEventListener('keydown', trapLbFocus);
            if (lbTrigger) { lbTrigger.focus(); lbTrigger = null; }
        }

        links.forEach(function(link, i) {
            link.addEventListener('click', function(e) { e.preventDefault(); openLb(i, link); });
        });
        lbCloseBtn.addEventListener('click', closeLb);
        lbPrevBtn.addEventListener('click', function() { updateLb(currentIndex - 1); });
        lbNextBtn.addEventListener('click', function() { updateLb(currentIndex + 1); });
        lightbox.addEventListener('click', function(e) { if (e.target === lightbox) closeLb(); });
        document.addEventListener('keydown', function(e) {
            if (!lightbox.classList.contains('gallery-lightbox-open')) return;
            if (e.key === 'Escape') closeLb();
            else if (e.key === 'ArrowLeft') updateLb(currentIndex - 1);
            else if (e.key === 'ArrowRight') updateLb(currentIndex + 1);
        });
    }
})();
</script>
{% endblock %}

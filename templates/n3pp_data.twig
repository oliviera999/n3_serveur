{% extends 'layout.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block head_css %}
    <link rel="stylesheet" href="{{ base_path }}/assets/css/common-data.css" />
{% endblock %}

{% block head_scripts %}
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://code.highcharts.com/stock/highstock.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script src="https://code.highcharts.com/modules/export-data.js"></script>
    <script src="https://code.highcharts.com/modules/accessibility.js"></script>
{% endblock %}

{% block styles %}
    <style>
        .stat-card.pump { border-left: 5px solid #008B74; background: linear-gradient(180deg, #fff 0%, #f0faf8 100%); }
        .stat-card.pump .stat-card-icon { color: #008B74; }
    </style>
{% endblock %}

{% block content %}
    {% include 'partials/_hero_data.twig' with {
        hero_title: "L'élevage d'insectes – Serre",
        hero_icon: 'fa-leaf',
        hero_subtitle: 'Supervision des capteurs de la serre (température, humidité air et sol, luminosité, état pompe).',
        hero_synthesis: '📊 Synthèse du ' ~ start_date|date('d/m/Y H:i') ~ ' au ' ~ end_date|date('d/m/Y H:i') ~ ' — ' ~ measure_count ~ ' mesures — ' ~ duration_str
    } %}

    <article class="post featured">
        {% if latest %}
            <div class="section-header" style="flex-wrap: wrap; gap: 10px;">
                <i class="fas fa-chart-line"></i>
                <h3>Dernière mesure</h3>
            </div>
            <div class="stats-grid">
                {% if latest.TempAir is defined and latest.TempAir is not null %}
                <div class="stat-card temp">
                    <i class="fas fa-thermometer-half stat-card-icon"></i>
                    <div class="stat-card-label">Temp. air</div>
                    <div class="stat-card-value"><span data-sensor="TempAir" data-decimals="1">{{ latest.TempAir|number_format(1) }}</span> <span class="stat-card-unit">°C</span></div>
                    <div class="stat-card-secondary">Moy: {{ avg_tempAir is defined and avg_tempAir ? avg_tempAir|number_format(1) : '-' }} | Min: {{ min_tempAir is defined and min_tempAir ? min_tempAir|number_format(1) : '-' }} | Max: {{ max_tempAir is defined and max_tempAir ? max_tempAir|number_format(1) : '-' }}</div>
                </div>
                {% endif %}
                {% if latest.Humidite is defined and latest.Humidite is not null %}
                <div class="stat-card humidity">
                    <i class="fas fa-tint stat-card-icon"></i>
                    <div class="stat-card-label">Humidité air</div>
                    <div class="stat-card-value"><span data-sensor="Humidite" data-decimals="0">{{ latest.Humidite|number_format(0) }}</span> <span class="stat-card-unit">%</span></div>
                    <div class="stat-card-secondary">Moy: {{ avg_humidite is defined and avg_humidite ? avg_humidite|number_format(0) : '-' }}% | Min: {{ min_humidite is defined and min_humidite ? min_humidite|number_format(0) : '-' }}% | Max: {{ max_humidite is defined and max_humidite ? max_humidite|number_format(0) : '-' }}%</div>
                </div>
                {% endif %}
                {% if latest.Luminosite is defined and latest.Luminosite is not null %}
                <div class="stat-card light">
                    <i class="fas fa-sun stat-card-icon"></i>
                    <div class="stat-card-label">Luminosité</div>
                    <div class="stat-card-value"><span data-sensor="Luminosite" data-decimals="0">{{ latest.Luminosite|number_format(0) }}</span></div>
                    <div class="stat-card-secondary">Moy: {{ avg_luminosite is defined and avg_luminosite ? avg_luminosite|number_format(0) : '-' }} | Min: {{ min_luminosite is defined and min_luminosite ? min_luminosite|number_format(0) : '-' }} | Max: {{ max_luminosite is defined and max_luminosite ? max_luminosite|number_format(0) : '-' }}</div>
                </div>
                {% endif %}
                {% if latest.HumidMoy is defined and latest.HumidMoy is not null %}
                <div class="stat-card humidity">
                    <i class="fas fa-seedling stat-card-icon"></i>
                    <div class="stat-card-label">Humid. sol moy.</div>
                    <div class="stat-card-value"><span data-sensor="HumidMoy" data-decimals="0">{{ latest.HumidMoy|number_format(0) }}</span> <span class="stat-card-unit">UA</span></div>
                    <div class="stat-card-secondary">Moy: {{ avg_humidMoy is defined and avg_humidMoy ? avg_humidMoy|number_format(0) : '-' }} UA | Min: {{ min_humidMoy is defined and min_humidMoy ? min_humidMoy|number_format(0) : '-' }} UA | Max: {{ max_humidMoy is defined and max_humidMoy ? max_humidMoy|number_format(0) : '-' }} UA</div>
                </div>
                {% endif %}
                {% for i in 1..4 %}
                {% set col = 'Humid' ~ i %}
                {% if latest[col] is defined and latest[col] is not null %}
                <div class="stat-card humidity">
                    <i class="fas fa-droplet stat-card-icon"></i>
                    <div class="stat-card-label">Humid. sol {{ i }}</div>
                    <div class="stat-card-value"><span data-sensor="{{ col }}" data-decimals="0">{{ latest[col]|number_format(0) }}</span> <span class="stat-card-unit">UA</span></div>
                    {% set lc = 'humid' ~ i %}
                    <div class="stat-card-secondary">Moy: {{ attribute(_context, 'avg_' ~ lc) is defined and attribute(_context, 'avg_' ~ lc) ? attribute(_context, 'avg_' ~ lc)|number_format(0) : '-' }} UA | Min: {{ attribute(_context, 'min_' ~ lc) is defined and attribute(_context, 'min_' ~ lc) ? attribute(_context, 'min_' ~ lc)|number_format(0) : '-' }} UA | Max: {{ attribute(_context, 'max_' ~ lc) is defined and attribute(_context, 'max_' ~ lc) ? attribute(_context, 'max_' ~ lc)|number_format(0) : '-' }} UA</div>
                </div>
                {% endif %}
                {% endfor %}
                {% if latest.etatPompe is defined and latest.etatPompe is not null %}
                <div class="stat-card pump">
                    <i class="fas fa-water stat-card-icon"></i>
                    <div class="stat-card-label">État pompe</div>
                    <div class="stat-card-value"><span data-sensor="etatPompe">{{ latest.etatPompe }}</span></div>
                </div>
                {% endif %}
            </div>
            {% if latest.sensor is defined %}<p style="font-size:0.9em;color:#7f8c8d;">Capteur : {{ latest.sensor|default('-') }} | Firmware : {{ latest.version|default('-') }}</p>{% endif %}
        {% else %}
            <div class="no-data"><i class="fas fa-database" style="font-size:2em;margin-bottom:10px;color:#bbb;"></i><br>Aucune donnée enregistrée.</div>
        {% endif %}

        {% if measure_count > 0 %}
        <div class="section-header">
            <i class="fas fa-chart-area"></i>
            <h3>Graphiques</h3>
        </div>
        <div class="chart-container">
            <p class="chart-container-title"><i class="fas fa-seedling"></i> Humidité du sol</p>
            <div id="chart-niveauxeaux" style="min-height:350px;"></div>
        </div>
        <div class="chart-container">
            <p class="chart-container-title"><i class="fas fa-thermometer-half"></i> Température, Humidité air &amp; Luminosité</p>
            <div id="chart-temperatures" style="min-height:350px;"></div>
        </div>
        <div class="chart-container">
            <p class="chart-container-title"><i class="fas fa-cog"></i> Autonomie &amp; Système</p>
            <div id="chart-cycles" style="min-height:300px;"></div>
        </div>
        {% endif %}

        <div class="filter-section">
            <h3><i class="fas fa-filter"></i> Filtrage des données</h3>
            <form method="POST" action="/n3pp/n3ppdatas/n3pp-data.php">
                {{ csrf_field|raw }}
                <div>
                    <label for="start_datetime">Début</label>
                    <input type="datetime-local" id="start_datetime" name="start_datetime" value="{{ start_date|date('Y-m-d\\TH:i') }}">
                </div>
                <div>
                    <label for="end_datetime">Fin</label>
                    <input type="datetime-local" id="end_datetime" name="end_datetime" value="{{ end_date|date('Y-m-d\\TH:i') }}">
                </div>
                <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Afficher</button>
                <button type="submit" name="export_csv" value="1" class="btn btn-secondary"><i class="fas fa-download"></i> CSV</button>
            </form>
            <div class="quick-filters">
                <span class="quick-filter-btn" onclick="setPeriod(1,'h')">1h</span>
                <span class="quick-filter-btn" onclick="setPeriod(3,'h')">3h</span>
                <span class="quick-filter-btn" onclick="setPeriod(6,'h')">6h</span>
                <span class="quick-filter-btn" onclick="setPeriod(12,'h')">12h</span>
                <span class="quick-filter-btn" onclick="setPeriod(1,'d')">1 jour</span>
                <span class="quick-filter-btn" onclick="setPeriod(7,'d')">1 sem</span>
                <span class="quick-filter-btn" onclick="setPeriod(30,'d')">1 mois</span>
            </div>
            <div class="period-info">
                <span><i class="fas fa-database"></i> {{ measure_count }} mesures</span>
                <span><i class="fas fa-clock"></i> {{ duration_str }}</span>
            </div>
        </div>

        {% embed 'partials/_system_health_panel.twig' with { health_panel_title: 'État du système' } %}
            {% block health_items %}
                <div class="health-item">
                    <div class="health-item-label">Firmware</div>
                    <div class="health-item-value">v{{ firmware_version }}</div>
                </div>
                <div class="health-item">
                    <div class="health-item-label">Serveur</div>
                    <div class="health-item-value">{{ version }}</div>
                </div>
                <div class="health-item">
                    <div class="health-item-label">Mesures affichées</div>
                    <div class="health-item-value">{{ measure_count }}</div>
                </div>
                <div class="health-item">
                    <div class="health-item-label">Environnement</div>
                    <div class="health-item-value">{{ environment }}</div>
                </div>
            {% endblock %}
        {% endembed %}

        {% if measure_count > 0 %}
        <div class="section-header">
            <i class="fas fa-history"></i>
            <h3>Historique ({{ measure_count }} mesures)</h3>
        </div>
        <div class="data-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>#</th><th>Date</th><th>T°air</th><th>H%air</th><th>Lum.</th><th>H UA moy</th><th>H UA 1</th><th>H UA 2</th><th>H UA 3</th><th>H UA 4</th><th>Pompe</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
        {% endif %}
    </article>
{% endblock %}

{% block footer %}
    <footer id="footer" style="text-align: center; padding: 1.5rem 2rem; margin-top: 2rem; color: #6c757d; font-size: 0.9em; border-top: 1px solid rgba(0,139,116,0.15); background: rgba(255,255,255,0.92);">
        <div class="context-badges">
            <span class="context-badge {{ environment == 'n3pp_test' ? 'context-badge-test' : 'context-badge-prod' }}"><i class="fas fa-globe"></i> {{ environment == 'n3pp_test' ? 'Environnement TEST' : 'Environnement production' }}</span>
            <span class="context-badge"><i class="fas fa-database"></i> {{ environment == 'n3pp_test' ? 'n3ppDataTest' : 'n3ppData' }}</span>
            <span class="context-badge"><i class="fas fa-code-branch"></i> {{ version }}</span>
            {% if firmware_version %}<span class="context-badge"><i class="fas fa-microchip"></i> Firmware v{{ firmware_version }}</span>{% endif %}
        </div>
        <p style="margin:0;">Serre / élevage d'insectes (n3pp) | n3 IoT | &copy; 2025 olution</p>
    </footer>
{% endblock %}

{% block scripts %}
    <script src="{{ base_path }}/assets/js/highcharts-defaults.js"></script>
    <script src="{{ base_path }}/assets/js/chart-helpers.js"></script>
    <script>
    var reading_time = {{ reading_time|json_encode|raw }};
    var TempAir = {{ TempAir|json_encode|raw }};
    var Humidite = {{ Humidite|json_encode|raw }};
    var Luminosite = {{ Luminosite|json_encode|raw }};
    var HumidMoy = {{ HumidMoy|json_encode|raw }};
    var Humid1 = {{ Humid1|json_encode|raw }};
    var Humid2 = {{ Humid2|json_encode|raw }};
    var Humid3 = {{ Humid3|json_encode|raw }};
    var Humid4 = {{ Humid4|json_encode|raw }};
    var PontDiv = {{ PontDiv|json_encode|raw }};
    var bootCount = {{ bootCount|json_encode|raw }};
    var etatPompe = {{ etatPompe|json_encode|raw }};
    var resetMode = {{ resetMode|json_encode|raw }};

    {% if measure_count > 0 %}
    Highcharts.stockChart('chart-niveauxeaux', {
        rangeSelector: { enabled: false },
        title: { text: 'Humidité du sol' },
        yAxis: [{ title: { text: 'Humidité sol (UA)' }, opposite: false }],
        series: [
            { name: 'Humid. moy.', data: zipSeries(reading_time, HumidMoy), type: 'spline', color: '#27ae60', lineWidth: 3, tooltip: { valueSuffix: ' UA' }},
            { name: 'Humid. 1', data: zipSeries(reading_time, Humid1), type: 'spline', color: '#3498db', dashStyle: 'Dash', tooltip: { valueSuffix: ' UA' }},
            { name: 'Humid. 2', data: zipSeries(reading_time, Humid2), type: 'spline', color: '#2980b9', dashStyle: 'Dash', tooltip: { valueSuffix: ' UA' }},
            { name: 'Humid. 3', data: zipSeries(reading_time, Humid3), type: 'spline', color: '#1abc9c', dashStyle: 'Dash', tooltip: { valueSuffix: ' UA' }},
            { name: 'Humid. 4', data: zipSeries(reading_time, Humid4), type: 'spline', color: '#16a085', dashStyle: 'Dash', tooltip: { valueSuffix: ' UA' }},
            { name: 'État pompe', data: zipSeries(reading_time, etatPompe), type: 'column', color: '#008B74', opacity: 0.5 },
            { name: 'Reset', data: zipSeries(reading_time, resetMode), type: 'column', color: '#bdc3c7' }
        ],
        chart: { backgroundColor: 'transparent' },
        credits: { enabled: false }
    });
    Highcharts.stockChart('chart-temperatures', {
        rangeSelector: { enabled: false },
        title: { text: 'Température, Humidité air & Luminosité' },
        yAxis: [
            { title: { text: 'Température (°C)' }, opposite: false },
            { title: { text: 'Humidité (%)' }, opposite: true },
            { title: { text: 'Luminosité (UA)' }, opposite: true, offset: 60 }
        ],
        series: [
            { name: 'Temp. air', data: zipSeries(reading_time, TempAir), type: 'spline', color: '#e74c3c', yAxis: 0, tooltip: { valueSuffix: ' °C' }},
            { name: 'Humidité', data: zipSeries(reading_time, Humidite), type: 'spline', color: '#3498db', yAxis: 1, tooltip: { valueSuffix: ' %' }},
            { name: 'Luminosité', data: zipSeries(reading_time, Luminosite), type: 'spline', color: '#f39c12', yAxis: 2 }
        ],
        chart: { backgroundColor: 'transparent' },
        credits: { enabled: false }
    });
    Highcharts.stockChart('chart-cycles', {
        rangeSelector: { enabled: false },
        title: { text: 'Autonomie & Système' },
        yAxis: [
            { title: { text: 'Cycles' }, opposite: false },
            { title: { text: 'Batterie' }, opposite: true }
        ],
        series: [
            { name: 'bootCount', data: zipSeries(reading_time, bootCount), type: 'spline', color: '#2c3e50', yAxis: 0 },
            { name: 'PontDiv', data: zipSeries(reading_time, PontDiv), type: 'spline', color: '#e74c3c', yAxis: 1 }
        ],
        chart: { backgroundColor: 'transparent' },
        credits: { enabled: false }
    });
    {% endif %}
    </script>

    <script src="{{ base_path }}/assets/js/toast-notifications.js"></script>
    <script src="{{ base_path }}/assets/js/chart-updater-generic.js"></script>
    <script src="{{ base_path }}/assets/js/realtime-updater.js"></script>
    <script>
    (function() {
        var apiBase = '{{ realtime_api_base|default("/n3pp/api/realtime") }}';
        {% if measure_count > 0 %}
        window.chartUpdater = new ChartUpdaterGeneric({
            chartIds: ['chart-niveauxeaux', 'chart-temperatures', 'chart-cycles'],
            debug: true,
            sensorMap: {
                'HumidMoy': { chartId: 'chart-niveauxeaux', seriesIndex: 0 },
                'Humid1': { chartId: 'chart-niveauxeaux', seriesIndex: 1 },
                'Humid2': { chartId: 'chart-niveauxeaux', seriesIndex: 2 },
                'Humid3': { chartId: 'chart-niveauxeaux', seriesIndex: 3 },
                'Humid4': { chartId: 'chart-niveauxeaux', seriesIndex: 4 },
                'etatPompe': { chartId: 'chart-niveauxeaux', seriesIndex: 5 },
                'resetMode': { chartId: 'chart-niveauxeaux', seriesIndex: 6 },
                'TempAir': { chartId: 'chart-temperatures', seriesIndex: 0 },
                'Humidite': { chartId: 'chart-temperatures', seriesIndex: 1 },
                'Luminosite': { chartId: 'chart-temperatures', seriesIndex: 2 },
                'bootCount': { chartId: 'chart-cycles', seriesIndex: 0 },
                'PontDiv': { chartId: 'chart-cycles', seriesIndex: 1 }
            }
        });
        setTimeout(function() { chartUpdater.init(); }, 150);
        {% endif %}
        window.realtimeUpdater = new RealtimeUpdater({
            apiBasePath: apiBase,
            pollInterval: 15000,
            onNewData: function(readings) {
                if (!readings || readings.length === 0) return;
                var last = readings[readings.length - 1];
                var sensors = last.sensors || last;
                document.querySelectorAll('[data-sensor]').forEach(function(el) {
                    var key = el.getAttribute('data-sensor');
                    var val = sensors[key];
                    if (val === undefined || val === null) return;
                    var dec = el.getAttribute('data-decimals');
                    if (dec !== null) {
                        var n = parseFloat(val);
                        el.textContent = !isNaN(n) ? n.toFixed(parseInt(dec, 10) || 0) : val;
                    } else {
                        el.textContent = val;
                    }
                });
            }
        });
        realtimeUpdater.start();
    })();
    </script>
{% endblock %}

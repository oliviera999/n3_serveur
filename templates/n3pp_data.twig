{% extends 'layout.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block head_css %}
    <link rel="stylesheet" href="{{ base_path }}/assets/css/common-data.css" />
    <style>
        .stat-card.pump { border-left: 5px solid #008B74; background: linear-gradient(180deg, #fff 0%, #f0faf8 100%); }
        .stat-card.pump .stat-card-icon { color: #008B74; }
        [data-theme="dark"] .stat-card.pump { background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-secondary) 100%); }
        [data-theme="dark"] .stat-card.pump .stat-card-icon { color: var(--accent-primary); }
    </style>
{% endblock %}

{% block head_scripts %}
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://code.highcharts.com/stock/highstock.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script src="https://code.highcharts.com/modules/export-data.js"></script>
    <script src="https://code.highcharts.com/modules/accessibility.js"></script>
{% endblock %}

{% block content %}
    {% include 'partials/_hero_data.twig' with {
        hero_title: data_config.hero_title,
        hero_icon: data_config.hero_icon,
        hero_subtitle: data_config.hero_subtitle,
        hero_more_url: data_config.hero_more_url|default(''),
        hero_more_label: data_config.hero_more_label|default(''),
        hero_synthesis: '📊 Synthèse du ' ~ start_date|date('d/m/Y H:i') ~ ' au ' ~ end_date|date('d/m/Y H:i') ~ ' — ' ~ measure_count ~ ' mesures — ' ~ duration_str
    } %}

    <article class="post featured">
        {% if not latest and measure_count == 0 %}
            <div class="no-data"><i class="fas fa-database no-data-icon"></i><br>Aucune donnée enregistrée.</div>
        {% else %}
            {# Section 1 : Humidité du sol #}
            <div class="section-header alt-section-title-full">
                <i class="fas fa-seedling"></i>
                <h3>Humidité du sol</h3>
            </div>
            <div class="alt-data-chart-row">
                <div class="alt-stats-column">
                    <div class="stats-grid">
                        {% if latest %}
                        <div class="stat-card" style="border-left-color:#27ae60">
                            <i class="fas fa-seedling stat-card-icon" style="color:#27ae60"></i>
                            <div class="stat-card-label">Humid. sol moy.</div>
                            <div class="stat-card-value"><span data-sensor="HumidMoy" data-decimals="0">{{ latest.HumidMoy|default('-')|number_format(0) }}</span> <span class="stat-card-unit">UA</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_humidMoy|default(0)|number_format(0) }} | Min: {{ min_humidMoy|default(0)|number_format(0) }} | Max: {{ max_humidMoy|default(0)|number_format(0) }} UA</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#3498db">
                            <i class="fas fa-droplet stat-card-icon" style="color:#3498db"></i>
                            <div class="stat-card-label">Humid. sol 1</div>
                            <div class="stat-card-value"><span data-sensor="Humid1" data-decimals="0">{{ latest.Humid1|default('-')|number_format(0) }}</span> <span class="stat-card-unit">UA</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_humid1|default(0)|number_format(0) }} | Min: {{ min_humid1|default(0)|number_format(0) }} | Max: {{ max_humid1|default(0)|number_format(0) }} UA</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#2980b9">
                            <i class="fas fa-droplet stat-card-icon" style="color:#2980b9"></i>
                            <div class="stat-card-label">Humid. sol 2</div>
                            <div class="stat-card-value"><span data-sensor="Humid2" data-decimals="0">{{ latest.Humid2|default('-')|number_format(0) }}</span> <span class="stat-card-unit">UA</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_humid2|default(0)|number_format(0) }} | Min: {{ min_humid2|default(0)|number_format(0) }} | Max: {{ max_humid2|default(0)|number_format(0) }} UA</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#1abc9c">
                            <i class="fas fa-droplet stat-card-icon" style="color:#1abc9c"></i>
                            <div class="stat-card-label">Humid. sol 3</div>
                            <div class="stat-card-value"><span data-sensor="Humid3" data-decimals="0">{{ latest.Humid3|default('-')|number_format(0) }}</span> <span class="stat-card-unit">UA</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_humid3|default(0)|number_format(0) }} | Min: {{ min_humid3|default(0)|number_format(0) }} | Max: {{ max_humid3|default(0)|number_format(0) }} UA</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#16a085">
                            <i class="fas fa-droplet stat-card-icon" style="color:#16a085"></i>
                            <div class="stat-card-label">Humid. sol 4</div>
                            <div class="stat-card-value"><span data-sensor="Humid4" data-decimals="0">{{ latest.Humid4|default('-')|number_format(0) }}</span> <span class="stat-card-unit">UA</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_humid4|default(0)|number_format(0) }} | Min: {{ min_humid4|default(0)|number_format(0) }} | Max: {{ max_humid4|default(0)|number_format(0) }} UA</div>
                        </div>
                        <div class="stat-card pump" style="border-left-color:#008B74">
                            <i class="fas fa-water stat-card-icon" style="color:#008B74"></i>
                            <div class="stat-card-label">État pompe</div>
                            <div class="stat-card-value"><span data-sensor="etatPompe" data-decimals="0">{{ latest.etatPompe|default('-')|number_format(0) }}</span></div>
                        </div>
                        {% endif %}
                    </div>
                </div>
                <div class="alt-chart-column">
                    <div id="chart-niveauxeaux" style="min-height:350px;"></div>
                </div>
            </div>

            {# Section 2 : Paramètres physiques #}
            <div class="section-header alt-section-title-full">
                <i class="fas fa-thermometer-half"></i>
                <h3>Paramètres physiques</h3>
            </div>
            <div class="alt-data-chart-row">
                <div class="alt-stats-column">
                    <div class="stats-grid">
                        {% if latest %}
                        <div class="stat-card" style="border-left-color:#e74c3c">
                            <i class="fas fa-thermometer-half stat-card-icon" style="color:#e74c3c"></i>
                            <div class="stat-card-label">Température air</div>
                            <div class="stat-card-value"><span data-sensor="TempAir" data-decimals="1">{{ latest.TempAir|default('-')|number_format(1) }}</span> <span class="stat-card-unit">°C</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_tempAir|default(0)|number_format(1) }} °C | Min: {{ min_tempAir|default(0)|number_format(1) }} °C | Max: {{ max_tempAir|default(0)|number_format(1) }} °C</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#3498db">
                            <i class="fas fa-tint stat-card-icon" style="color:#3498db"></i>
                            <div class="stat-card-label">Humidité air</div>
                            <div class="stat-card-value"><span data-sensor="Humidite" data-decimals="0">{{ latest.Humidite|default('-')|number_format(0) }}</span> <span class="stat-card-unit">%</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_humidite|default(0)|number_format(0) }}% | Min: {{ min_humidite|default(0)|number_format(0) }}% | Max: {{ max_humidite|default(0)|number_format(0) }}%</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#f39c12">
                            <i class="fas fa-sun stat-card-icon" style="color:#f39c12"></i>
                            <div class="stat-card-label">Luminosité</div>
                            <div class="stat-card-value"><span data-sensor="Luminosite" data-decimals="0">{{ latest.Luminosite|default('-')|number_format(0) }}</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_luminosite|default(0)|number_format(0) }} | Min: {{ min_luminosite|default(0)|number_format(0) }} | Max: {{ max_luminosite|default(0)|number_format(0) }}</div>
                        </div>
                        {% endif %}
                    </div>
                </div>
                <div class="alt-chart-column">
                    <div id="chart-temperatures" style="min-height:350px;"></div>
                </div>
            </div>

            {# Section 3 : Système #}
            <div class="section-header alt-section-title-full">
                <i class="fas fa-cog"></i>
                <h3>Système</h3>
            </div>
            <div class="alt-data-chart-row">
                <div class="alt-stats-column">
                    <div class="stats-grid">
                        {% if latest %}
                        <div class="stat-card" style="border-left-color:#2c3e50">
                            <i class="fas fa-sync stat-card-icon" style="color:#2c3e50"></i>
                            <div class="stat-card-label">Redémarrages</div>
                            <div class="stat-card-value"><span data-sensor="bootCount" data-decimals="0">{{ latest.bootCount|default('-')|number_format(0) }}</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_bootCount|default(0)|number_format(0) }} | Min: {{ min_bootCount|default(0)|number_format(0) }} | Max: {{ max_bootCount|default(0)|number_format(0) }}</div>
                        </div>
                        <div class="stat-card" style="border-left-color:#e74c3c">
                            <i class="fas fa-battery-half stat-card-icon" style="color:#e74c3c"></i>
                            <div class="stat-card-label">Pont div. (batterie)</div>
                            <div class="stat-card-value"><span data-sensor="PontDiv" data-decimals="0">{{ latest.PontDiv|default('-')|number_format(0) }}</span></div>
                            <div class="stat-card-secondary">Moy: {{ avg_pontDiv|default(0)|number_format(0) }} | Min: {{ min_pontDiv|default(0)|number_format(0) }} | Max: {{ max_pontDiv|default(0)|number_format(0) }}</div>
                        </div>
                        {% endif %}
                    </div>
                </div>
                <div class="alt-chart-column">
                    <div id="chart-cycles" style="min-height:300px;"></div>
                </div>
            </div>

            {% if latest and latest.sensor is defined %}<p class="data-sensor-caption">Capteur : {{ latest.sensor|default('-') }} | Firmware : {{ latest.version|default('-') }}</p>{% endif %}
        {% endif %}

        <div class="filter-section">
            <h3><i class="fas fa-filter"></i> Filtrage des données</h3>
            <form method="POST" action="{{ base_path|default('') }}{{ data_config.form_action }}">
                {{ csrf_field|raw }}
                <div>
                    <label for="start_datetime">Début</label>
                    <input type="datetime-local" id="start_datetime" name="start_datetime" value="{{ start_date|date('Y-m-d\\TH:i') }}">
                </div>
                <div>
                    <label for="end_datetime">Fin</label>
                    <input type="datetime-local" id="end_datetime" name="end_datetime" value="{{ end_date|date('Y-m-d\\TH:i') }}">
                </div>
                <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Afficher</button>
                <button type="submit" name="export_csv" value="1" class="btn btn-secondary"><i class="fas fa-download"></i> CSV</button>
            </form>
            <div class="quick-filters">
                <span class="quick-filter-btn" onclick="setPeriod(1,'h')">1h</span>
                <span class="quick-filter-btn" onclick="setPeriod(3,'h')">3h</span>
                <span class="quick-filter-btn" onclick="setPeriod(6,'h')">6h</span>
                <span class="quick-filter-btn" onclick="setPeriod(12,'h')">12h</span>
                <span class="quick-filter-btn" onclick="setPeriod(1,'d')">1 jour</span>
                <span class="quick-filter-btn" onclick="setPeriod(7,'d')">1 sem</span>
                <span class="quick-filter-btn" onclick="setPeriod(30,'d')">1 mois</span>
            </div>
            <div class="period-info">
                <span><i class="fas fa-database"></i> {{ measure_count }} mesures</span>
                <span><i class="fas fa-clock"></i> {{ duration_str }}</span>
            </div>
        </div>

        {% embed 'partials/_system_health_panel.twig' with { health_panel_title: 'État du système' } %}
            {% block health_items %}
                <div class="health-item">
                    <div class="health-item-label">Firmware</div>
                    <div class="health-item-value">v{{ firmware_version }}</div>
                </div>
                <div class="health-item">
                    <div class="health-item-label">Serveur</div>
                    <div class="health-item-value">{{ version }}</div>
                </div>
                <div class="health-item">
                    <div class="health-item-label">Mesures affichées</div>
                    <div class="health-item-value">{{ measure_count }}</div>
                </div>
                <div class="health-item">
                    <div class="health-item-label">Environnement</div>
                    <div class="health-item-value">{{ environment }}</div>
                </div>
            {% endblock %}
        {% endembed %}
    </article>
{% endblock %}

{% block footer %}
    <footer id="footer" class="app-footer app-footer--elevated">
        <div class="context-badges">
            <span class="context-badge {{ environment == data_config.test_env ? 'context-badge-test' : 'context-badge-prod' }}"><i class="fas fa-globe"></i> {{ environment == data_config.test_env ? 'Environnement TEST' : 'Environnement production' }}</span>
            <span class="context-badge"><i class="fas fa-database"></i> {{ data_config.table_label|default(environment) }}</span>
            <span class="context-badge"><i class="fas fa-code-branch"></i> {{ version }}</span>
            {% if firmware_version %}<span class="context-badge"><i class="fas fa-microchip"></i> Firmware v{{ firmware_version }}</span>{% endif %}
        </div>
        <p style="margin:0;">{{ data_config.footer_text }} | N3 IoT Datas | &copy; 2025 olution</p>
    </footer>
{% endblock %}

{% block scripts %}
    {% include 'partials/_live_badge.twig' %}
    <script src="{{ base_path }}/assets/js/highcharts-defaults.js"></script>
    <script src="{{ base_path }}/assets/js/chart-helpers.js"></script>
    <script>
    var reading_time = {{ reading_time|json_encode|raw }};
    {% for col in chart_columns %}
    var {{ col }} = {{ attribute(_context, col)|json_encode|raw }};
    {% endfor %}
    </script>

    {% if measure_count > 0 %}
    <script>
    (function() {
        var chartLoadExtremes = function() {
            var xAxis = this.xAxis && this.xAxis[0];
            if (xAxis && xAxis.dataMin != null && xAxis.dataMax != null) {
                xAxis.setExtremes(xAxis.dataMin, xAxis.dataMax);
            }
        };
        function calculateLinearRegression(data) {
            if (!data || data.length < 2) return null;
            var valid = [];
            for (var i = 0; i < data.length; i++) {
                var y = data[i][1];
                if (y !== null && y !== undefined && !isNaN(y)) valid.push({ idx: i, y: y });
            }
            if (valid.length < 2) return null;
            var n = valid.length, sumX = 0, sumY = 0, sumXY = 0, sumXX = 0;
            for (var k = 0; k < n; k++) {
                var x = valid[k].idx, y = valid[k].y;
                sumX += x; sumY += y; sumXY += x * y; sumXX += x * x;
            }
            var denom = n * sumXX - sumX * sumX;
            if (denom === 0) return null;
            var a = (n * sumXY - sumX * sumY) / denom;
            var b = (sumY - a * sumX) / n;
            var trendData = [];
            for (var j = 0; j < data.length; j++) {
                trendData.push([data[j][0], a * j + b]);
            }
            return { data: trendData };
        }
        var HumidMoyData = zipSeries(reading_time, HumidMoy);
        var HumidMoyTrendLine = (HumidMoyData && HumidMoyData.length >= 2) ? calculateLinearRegression(HumidMoyData) : null;
    Highcharts.stockChart('chart-niveauxeaux', {
        rangeSelector: { enabled: false },
        title: { text: '' },
        xAxis: { ordinal: false },
        yAxis: [{ title: { text: 'Humidité sol (UA)' }, opposite: false }],
        series: [
            { name: 'Humid. moy.', data: zipSeries(reading_time, HumidMoy), type: 'spline', color: '#27ae60', lineWidth: 3, tooltip: { valueSuffix: ' UA' }},
            { name: 'Tendance humid. moy.', data: HumidMoyTrendLine ? HumidMoyTrendLine.data : [], type: 'line', color: '#1e8449', lineWidth: 2, dashStyle: 'Dot', tooltip: { valueSuffix: ' UA' }},
            { name: 'Humid. 1', data: zipSeries(reading_time, Humid1), type: 'spline', color: '#3498db', dashStyle: 'Dash', visible: false, tooltip: { valueSuffix: ' UA' }},
            { name: 'Humid. 2', data: zipSeries(reading_time, Humid2), type: 'spline', color: '#2980b9', dashStyle: 'Dash', visible: false, tooltip: { valueSuffix: ' UA' }},
            { name: 'Humid. 3', data: zipSeries(reading_time, Humid3), type: 'spline', color: '#1abc9c', dashStyle: 'Dash', visible: false, tooltip: { valueSuffix: ' UA' }},
            { name: 'Humid. 4', data: zipSeries(reading_time, Humid4), type: 'spline', color: '#16a085', dashStyle: 'Dash', visible: false, tooltip: { valueSuffix: ' UA' }},
            { name: 'État pompe', data: zipSeries(reading_time, etatPompe), type: 'column', color: '#008B74', opacity: 0.5 },
            { name: 'Reset', data: zipSeries(reading_time, resetMode), type: 'column', color: '#bdc3c7' }
        ],
        legend: { enabled: true, align: 'center', verticalAlign: 'bottom', itemStyle: { cursor: 'pointer' } },
        chart: { backgroundColor: 'transparent', events: { load: chartLoadExtremes } },
        credits: { enabled: false }
    });
    Highcharts.stockChart('chart-temperatures', {
        rangeSelector: { enabled: false },
        title: { text: '' },
        xAxis: { ordinal: false },
        yAxis: [
            { title: { text: 'Température (°C)' }, opposite: false },
            { title: { text: 'Humidité (%)' }, opposite: true },
            { title: { text: 'Luminosité (UA)' }, opposite: true, offset: 60 }
        ],
        series: [
            { name: 'Temp. air', data: zipSeries(reading_time, TempAir), type: 'spline', color: '#e74c3c', yAxis: 0, tooltip: { valueSuffix: ' °C' }},
            { name: 'Humidité', data: zipSeries(reading_time, Humidite), type: 'spline', color: '#3498db', yAxis: 1, tooltip: { valueSuffix: ' %' }},
            { name: 'Luminosité', data: zipSeries(reading_time, Luminosite), type: 'spline', color: '#f39c12', yAxis: 2 }
        ],
        legend: { enabled: true, align: 'center', verticalAlign: 'bottom', itemStyle: { cursor: 'pointer' } },
        chart: { backgroundColor: 'transparent', events: { load: chartLoadExtremes } },
        credits: { enabled: false }
    });
    Highcharts.stockChart('chart-cycles', {
        rangeSelector: { enabled: false },
        title: { text: '' },
        xAxis: { ordinal: false },
        yAxis: [
            { title: { text: 'Cycles' }, opposite: false },
            { title: { text: 'Batterie' }, opposite: true }
        ],
        series: [
            { name: 'bootCount', data: zipSeries(reading_time, bootCount), type: 'spline', color: '#2c3e50', yAxis: 0 },
            { name: 'PontDiv', data: zipSeries(reading_time, PontDiv), type: 'spline', color: '#e74c3c', yAxis: 1 }
        ],
        legend: { enabled: true, align: 'center', verticalAlign: 'bottom', itemStyle: { cursor: 'pointer' } },
        chart: { backgroundColor: 'transparent', events: { load: chartLoadExtremes } },
        credits: { enabled: false }
    });
    })();
    </script>
    {% endif %}

    <script src="{{ base_path }}/assets/js/toast-notifications.js"></script>
    <script src="{{ base_path }}/assets/js/chart-updater-generic.js"></script>
    <script src="{{ base_path }}/assets/js/realtime-updater.js"></script>
    {% if measure_count > 0 %}
    {% include 'partials/_chart_init_js.twig' with {
        chart_ids_json: chart_ids_json,
        chart_debug: true,
        sensor_map_json: sensor_map_json
    } %}
    {% endif %}
    {% include 'partials/_realtime_init_js.twig' with {
        realtime_api_base: realtime_api_base,
        poll_interval: 15000,
        base_path: base_path|default('')
    } %}
{% endblock %}

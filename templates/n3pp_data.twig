{# Page de suivi N3PP (serre / élevage) : rendu générique, cadres décrits par App\Display\Catalog\N3ppCatalog. #}
{% extends 'monitoring_page.twig' %}

{% block meta_description %}Habitat connecté pour une diversité d'insectes, de plus en plus locaux : humidité, température, arrosage automatique, suivis en direct.{% endblock %}

{% block page_css %}
    <style>
        .stat-card.pump { border-left: 5px solid #008B74; background: linear-gradient(180deg, #fff 0%, #f0faf8 100%); }
        .stat-card.pump .stat-card-icon { color: #008B74; }
        [data-theme="dark"] .stat-card.pump { background: linear-gradient(180deg, var(--bg-card) 0%, var(--bg-secondary) 100%); }
        [data-theme="dark"] .stat-card.pump .stat-card-icon { color: var(--accent-primary); }
    </style>
{% endblock %}

                    <script>
                        function setPeriod(value, unit) {
                            // Utiliser moment-timezone pour créer les dates dans le timezone du serveur (Africa/Casablanca)
                            const now = moment().tz('Africa/Casablanca');
                            let start = moment(now);
                            
                            if (unit === 'hours') {
                                start = start.subtract(value, 'hours');
                            } else if (unit === 'days') {
                                start = start.subtract(value, 'days');
                            }
                            
                            // Mise à jour dynamique des champs sans recharger la page
                            const formatDateTime = (momentObj) => {
                                return momentObj.format('YYYY-MM-DDTHH:mm');
                            };
                            
                            document.getElementById('start_datetime').value = formatDateTime(start);
                            document.getElementById('end_datetime').value = formatDateTime(now);
                            
                            // Soumettre le formulaire pour recharger les données
                            document.getElementById('customFilterForm').submit();
                        }
                    </script>

                    {# --------------------------------------------------------------------- #}
                    {# SCRIPTS JS – INJECTION DES DONNÉES                                         #}
                    {# --------------------------------------------------------------------- #}

                    <script>
                        // Configuration globale Highcharts : utilise Africa/Casablanca
                        // Les timestamps PHP sont créés avec Europe/Paris mais l'heure RÉELLE est à Casablanca
                        // Afficher en Casablanca pour voir l'heure locale réelle du projet
                        /* time / dataGrouping / légende : highcharts-defaults.js ; axe X non ordinal pour le stock */
                        if (typeof Highcharts !== 'undefined') {
                            Highcharts.setOptions({
                                xAxis: { ordinal: false }
                            });
                        }

                        // Tableaux PHP ➜ Twig ➜ JavaScript (données Highcharts)
                        var EauAquarium = {{ EauAquarium|raw }};
                        var EauReserve  = {{ EauReserve|raw }};
                        var EauPotager  = {{ EauPotager|raw }};

                        var TempAir    = {{ TempAir|raw }};
                        var TempEau    = {{ TempEau|raw }};
                        var Humidite   = {{ Humidite|raw }};
                        var Luminosite = {{ Luminosite|raw }};

                        var etatPompeAqua = {{ etatPompeAqua|raw }};
                        var etatPompeTank = {{ etatPompeTank|raw }};
                        var etatHeat      = {{ etatHeat|raw }};
                        var etatUV        = {{ etatUV|raw }};

                        var bouffePetits = {{ bouffePetits|raw }};
                        var bouffeGros   = {{ bouffeGros|raw }};

                        var reading_time = {{ reading_time|raw }};
                        var tidePeaks = {{ tide_peaks|default('[]')|raw }};
                        var tideTroughs = {{ tide_troughs|default('[]')|raw }};

                        // Association horodatage ➜ valeurs
                        // Itération sur reading_time.length (source de vérité) pour éviter
                        // tout accès hors-borne si une série était plus courte que les autres.
                        for (var i = 0, l = reading_time.length; i < l; i++) {
                            var ts = reading_time[i];
                            if (i < EauAquarium.length)  EauAquarium[i]  = [ ts, EauAquarium[i]  ];
                            if (i < EauReserve.length)   EauReserve[i]   = [ ts, EauReserve[i]   ];
                            if (i < EauPotager.length)   EauPotager[i]   = [ ts, EauPotager[i]   ];
                            if (i < etatPompeAqua.length) etatPompeAqua[i] = [ ts, etatPompeAqua[i] ];
                            if (i < etatPompeTank.length) etatPompeTank[i] = [ ts, etatPompeTank[i] ];
                            if (i < etatHeat.length)     etatHeat[i]     = [ ts, etatHeat[i]     ];
                            if (i < TempEau.length)      TempEau[i]      = [ ts, TempEau[i]      ];
                            if (i < TempAir.length)      TempAir[i]      = [ ts, TempAir[i]      ];
                            if (i < Humidite.length)     Humidite[i]     = [ ts, Humidite[i]     ];
                            if (i < Luminosite.length)   Luminosite[i]   = [ ts, Luminosite[i]   ];
                            if (i < etatUV.length)       etatUV[i]       = [ ts, etatUV[i]       ];
                            if (i < bouffePetits.length) bouffePetits[i] = [ ts, bouffePetits[i] ];
                            if (i < bouffeGros.length)   bouffeGros[i]   = [ ts, bouffeGros[i]   ];
                        }

                        // ==============================================
                        // Calcul des lignes de tendance pour les niveaux d'eau
                        // ==============================================
                        
                        // Calcul des tendances pour EauAquarium
                        var EauAquariumTrendLine = null;
                        var EauAquariumMovingAvg = null;
                        if (EauAquarium && EauAquarium.length >= 2) {
                            EauAquariumTrendLine = calculateLinearRegression(EauAquarium);
                            EauAquariumMovingAvg = calculateMovingAverage(EauAquarium, 20);
                        }
                        
                        // Calcul des tendances pour EauReserve
                        var EauReserveTrendLine = null;
                        var EauReserveMovingAvg = null;
                        if (EauReserve && EauReserve.length >= 2) {
                            EauReserveTrendLine = calculateLinearRegression(EauReserve);
                            EauReserveMovingAvg = calculateMovingAverage(EauReserve, 20);
                        }
                        
                        // Calcul des tendances pour EauPotager
                        var EauPotagerTrendLine = null;
                        var EauPotagerMovingAvg = null;
                        if (EauPotager && EauPotager.length >= 2) {
                            EauPotagerTrendLine = calculateLinearRegression(EauPotager);
                            EauPotagerMovingAvg = calculateMovingAverage(EauPotager, 20);
                        }

                        // ==============================================
                        // Configuration globale du timezone
                        // ==============================================

                        // Le serveur stocke en Europe/Paris, mais on affiche en Africa/Casablanca
                        // (heure locale réelle du projet physique au Maroc)
                        if (typeof moment !== 'undefined' && moment.tz) {
                            moment.tz.setDefault('Africa/Casablanca');
                        }
                        // Note : timezone / dataGrouping via highcharts-defaults.js (chargé dans head_scripts)

                        // ==============================================
                        // Fonctions de calcul des lignes de tendance
                        // ==============================================
                        
                        // Calcul de régression linéaire (y = ax + b)
                        function calculateLinearRegression(data) {
                            if (!data || data.length < 2) return null;

                            // Filtrer les points null/NaN avant calcul
                            var valid = [];
                            for (var i = 0; i < data.length; i++) {
                                var y = data[i][1];
                                if (y !== null && y !== undefined && !isNaN(y)) {
                                    valid.push({ idx: i, x: data[i][0], y: y });
                                }
                            }
                            if (valid.length < 2) return null;

                            var n = valid.length, sumX = 0, sumY = 0, sumXY = 0, sumXX = 0;
                            for (var k = 0; k < n; k++) {
                                var xi = valid[k].idx, yi = valid[k].y;
                                sumX += xi; sumY += yi; sumXY += xi * yi; sumXX += xi * xi;
                            }
                            var denom = n * sumXX - sumX * sumX;
                            if (denom === 0) return null;
                            var a = (n * sumXY - sumX * sumY) / denom;
                            var b = (sumY - a * sumX) / n;

                            // Générer les points sur tout le dataset (y compris les positions nulles)
                            var trendData = [];
                            for (var j = 0; j < data.length; j++) {
                                trendData.push([data[j][0], a * j + b]);
                            }
                            return { data: trendData, slope: a, intercept: b };
                        }
                        
                        // Calcul de moyenne mobile
                        function calculateMovingAverage(data, window) {
                            if (window === undefined) window = 20;
                            if (!data || data.length < window) return null;

                            var movingAvgData = [];
                            for (var i = window - 1; i < data.length; i++) {
                                var sum = 0, count = 0;
                                for (var j = 0; j < window; j++) {
                                    var v = data[i - j][1];
                                    if (v !== null && v !== undefined && !isNaN(v)) {
                                        sum += v;
                                        count++;
                                    }
                                }
                                // Si aucune valeur valide dans la fenêtre, on pousse null (gap dans le graphique)
                                movingAvgData.push([data[i][0], count > 0 ? sum / count : null]);
                            }
                            return movingAvgData;
                        }
                        
                        // ==============================================
                        // Fonction de redimensionnement responsive
                        // ==============================================
                        
                        function handleChartResize() {
                            if (typeof n3AquaponieCharts === 'undefined') return;
                            if (window.chartEau) window.chartEau.setSize(null, n3AquaponieCharts.chartHeight('eau'), false);
                            if (window.chartTemp) window.chartTemp.setSize(null, n3AquaponieCharts.chartHeight('temp'), false);
                        }
                        
                        // Écouter les changements de taille d'écran
                        window.addEventListener('resize', function() {
                            clearTimeout(window.resizeTimeout);
                            window.resizeTimeout = setTimeout(handleChartResize, 250);
                        });
                        
                        // Écouter les changements d'orientation
                        window.addEventListener('orientationchange', function() {
                            setTimeout(handleChartResize, 500);
                        });
                        
                        // ==============================================
                        // Graphiques Stock Navigator + Aires colorées
                        // ==============================================
                        
                        var createVersionDAttempts = 0;
                        var maxCreateVersionDAttempts = 25; // ~4s sur mobile
                        function createVersionD() {
                            createVersionDAttempts++;
                            // Vérifier que les conteneurs existent et sont visibles
                            var containerEau = document.getElementById('chart-stock-area-eau-D');
                            var containerTemp = document.getElementById('chart-stock-area-temp-D');
                            
                            if (!containerEau || !containerTemp) {
                                console.error('[Highcharts] Conteneurs de graphiques non trouvés');
                                return;
                            }
                            
                            // Détection mobile
                            var isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
                            var isAndroid = /Android/i.test(navigator.userAgent);
                            
                            // Forcer dimensions explicites sur les conteneurs (tous viewports)
                            if (typeof n3AquaponieCharts !== 'undefined') {
                                n3AquaponieCharts.prepareContainers(
                                    containerEau,
                                    containerTemp,
                                    function () { return n3AquaponieCharts.chartHeight('eau'); },
                                    function () { return n3AquaponieCharts.chartHeight('temp'); }
                                );
                            }
                            
                            // S'assurer que les conteneurs ont une taille
                            var containerEauRect = containerEau.getBoundingClientRect();
                            var containerWidth = containerEauRect.width || containerEau.offsetWidth || 0;
                            
                            var minWidth = isMobile ? 100 : 1;
                            if (containerWidth < minWidth && createVersionDAttempts < maxCreateVersionDAttempts) {
                                var retryDelay = isMobile ? 200 : 150;
                                console.warn('[Highcharts] Conteneur sans dimensions (' + containerWidth + 'px), tentative ' + createVersionDAttempts + '/' + maxCreateVersionDAttempts);
                                setTimeout(createVersionD, retryDelay);
                                return;
                            }
                            if (containerWidth < minWidth) {
                                console.warn('[Highcharts] Procédure malgré dimensions insuffisantes (fallback mobile)');
                                if (isMobile && containerEau.scrollIntoView) {
                                    containerEau.scrollIntoView({ behavior: 'auto', block: 'nearest' });
                                    containerEau.offsetHeight; // force reflow après scroll
                                }
                            }
                            
                            console.log('[Highcharts] Création graphiques - Mobile:', isMobile, 'Width:', containerWidth);
                            
                            // BOOST DÉSACTIVÉ - cause des problèmes de rendu (graphiques en colonnes au lieu de courbes)
                            // Le module boost utilise WebGL qui peut avoir des incompatibilités sur certains GPU/navigateurs
                            // Si besoin de réactiver pour de très grandes quantités de données:
                            // - Tester sur différents appareils avant de déployer
                            // - Vérifier que les types de séries (areaspline, line) sont préservés
                            
                            var aqEau = n3AquaponieCharts.baseOptions('eau');
                            var aqTemp = n3AquaponieCharts.baseOptions('temp');
                            var tideMarkerSeries = (window.n3TideMarkers && window.n3TideMarkers.buildSeries)
                                ? window.n3TideMarkers.buildSeries(tidePeaks, tideTroughs)
                                : [];

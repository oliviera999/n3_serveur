                                            if (!(e.min && e.max)) {
                                                return;
                                            }
                                            var visibleData = {
                                                EauAquarium: EauAquarium.filter(function (point) { return point[0] >= e.min && point[0] <= e.max; }),
                                                EauReserve: EauReserve.filter(function (point) { return point[0] >= e.min && point[0] <= e.max; }),
                                                EauPotager: EauPotager.filter(function (point) { return point[0] >= e.min && point[0] <= e.max; })
                                            };
                                            var newTrends = {};
                                            Object.keys(visibleData).forEach(function (key) {
                                                if (visibleData[key].length >= 2) {
                                                    newTrends[key + 'TrendLine'] = calculateLinearRegression(visibleData[key]);
                                                    newTrends[key + 'MovingAvg'] = calculateMovingAverage(visibleData[key], 20);
                                                }

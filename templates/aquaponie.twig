                            // Synchroniser la hauteur des conteneurs avec les graphiques pour éviter le blanc sous les graphiques
                            function syncChartContainerHeights() {
                                var cEau = document.getElementById('chart-stock-area-eau-D');
                                var cTemp = document.getElementById('chart-stock-area-temp-D');
                                if (cEau && window.chartEau) {
                                    var inner = cEau.querySelector('.highcharts-container') || cEau.firstElementChild;
                                    if (inner && inner.offsetHeight > 0) cEau.style.height = inner.offsetHeight + 'px';
                                    else if (window.chartEau.chartHeight) cEau.style.height = (window.chartEau.chartHeight + 80) + 'px';
                                }
                                if (cTemp && window.chartTemp) {
                                    var inner = cTemp.querySelector('.highcharts-container') || cTemp.firstElementChild;
                                    if (inner && inner.offsetHeight > 0) cTemp.style.height = inner.offsetHeight + 'px';
                                    else if (window.chartTemp.chartHeight) cTemp.style.height = (window.chartTemp.chartHeight + 80) + 'px';
                                }
                            }
                            if (window.requestAnimationFrame) {
                                requestAnimationFrame(function() { requestAnimationFrame(syncChartContainerHeights); });
                            } else {
                                setTimeout(syncChartContainerHeights, 50);
                            }
                            
                            console.log('[Highcharts] Graphiques créés avec succès');
                        }
                        

                                }
                                if (cTemp && window.chartTemp) {
                                    var inner = cTemp.querySelector('.highcharts-container') || cTemp.firstElementChild;
                                    if (inner && inner.offsetHeight > 0) cTemp.style.height = inner.offsetHeight + 'px';
                                }
                            }, 100);
                        }
                        
                        // Écouter les changements de taille d'écran
                        window.addEventListener('resize', function() {
                            clearTimeout(window.resizeTimeout);
                            window.resizeTimeout = setTimeout(handleChartResize, 250);
                        });
                        
                        // Écouter les changements d'orientation
                        window.addEventListener('orientationchange', function() {
                            setTimeout(handleChartResize, 500);
                        });
                        
                        // ==============================================
                        // Graphiques Stock Navigator + Aires colorées
                        // ==============================================
                        
                        var createVersionDAttempts = 0;
                        var maxCreateVersionDAttempts = 25; // ~4s sur mobile
                        function createVersionD() {
                            createVersionDAttempts++;
                            // Vérifier que les conteneurs existent et sont visibles
                            var containerEau = document.getElementById('chart-stock-area-eau-D');
                            var containerTemp = document.getElementById('chart-stock-area-temp-D');
                            
                            if (!containerEau || !containerTemp) {
                                console.error('[Highcharts] Conteneurs de graphiques non trouvés');
                                return;
                            }
                            
                            // Détection mobile
                            var isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
                            var isAndroid = /Android/i.test(navigator.userAgent);
                            
                            // Sur mobile, forcer dimensions explicites sur les conteneurs
                            if (isMobile) {
                                var fallbackWidth = Math.max(280, (window.innerWidth || document.documentElement.clientWidth || 360) - 40);
                                containerEau.style.minHeight = '350px';
                                containerTemp.style.minHeight = '400px';
                                if (containerEau.offsetWidth < 100) {
                                    containerEau.style.width = fallbackWidth + 'px';
                                    containerTemp.style.width = fallbackWidth + 'px';
                                    containerEau.offsetHeight; // force reflow
                                }
                            }
                            
                            // S'assurer que les conteneurs ont une taille
                            var containerEauRect = containerEau.getBoundingClientRect();
                            var containerWidth = containerEauRect.width || containerEau.offsetWidth || 0;
                            
                            var minWidth = isMobile ? 100 : 0;
                            if (containerWidth <= minWidth && createVersionDAttempts < maxCreateVersionDAttempts) {
                                var retryDelay = isMobile ? 200 : 150;
                                console.warn('[Highcharts] Conteneur sans dimensions (' + containerWidth + 'px), tentative ' + createVersionDAttempts + '/' + maxCreateVersionDAttempts);
                                setTimeout(createVersionD, retryDelay);
                                return;
                            }
                            if (containerWidth <= minWidth) {
                                console.warn('[Highcharts] Procédure malgré dimensions insuffisantes (fallback mobile)');
                                if (isMobile && containerEau.scrollIntoView) {
                                    containerEau.scrollIntoView({ behavior: 'auto', block: 'nearest' });
                                    containerEau.offsetHeight; // force reflow après scroll
                                }
                            }
                            
                            console.log('[Highcharts] Création graphiques - Mobile:', isMobile, 'Width:', containerWidth);
                            
                            // BOOST DÉSACTIVÉ - cause des problèmes de rendu (graphiques en colonnes au lieu de courbes)
                            // Le module boost utilise WebGL qui peut avoir des incompatibilités sur certains GPU/navigateurs
                            // Si besoin de réactiver pour de très grandes quantités de données:

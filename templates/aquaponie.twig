{#
    n³ iot datas by HTML5 UP (version twig)
    Identique visuellement au template legacy. Toute logique PHP a été
    migrée dans App\Controller\AquaponieController.
#}
{% extends 'layout.twig' %}

{% block title %}{{ page_title|default('Aquaponie FFP3 — Données en direct | n³ IoT') }}{% endblock %}
{% block meta_description %}Niveaux d'eau, températures, marées et chimie de l'eau d'une ferme aquaponique pédagogique, mesurés en temps réel.{% endblock %}

{% block head_scripts %}
        <script src="{{ base_path }}/assets/js/moment.min.js"></script>
        <script src="{{ base_path }}/assets/js/moment-timezone-with-data.min.js"></script>
        <script src="{{ base_path }}/assets/js/highstock.js"></script>
        {# boost.js supprimé : WebGL cause des problèmes sur mobile (graphiques invisibles) et laptop (colonnes au lieu de courbes) #}
        <script src="{{ base_path }}/assets/js/exporting.js"></script>
        <script src="{{ base_path }}/assets/js/export-data.js"></script>
        <script src="{{ base_path }}/assets/js/accessibility.js"></script>
        <script src="{{ base_path }}/assets/js/highcharts-defaults.js"></script>
        <script src="{{ base_path }}/assets/js/chart-helpers.js"></script>
        <script src="{{ base_path }}/assets/js/n3-stock-chart-layout.js"></script>
        <script src="{{ base_path }}/assets/js/aquaponie-chart-layout.js"></script>
        <script src="{{ base_path }}/assets/js/aquaponie-tide-markers.js"></script>
{% endblock %}

{% block head_css %}
    <link rel="stylesheet" href="{{ base_path }}/assets/css/common-data.css" />
    <link rel="stylesheet" href="{{ base_path }}/assets/css/aquaponie.css" />
{% endblock %}

{% block styles %}{% endblock %}

{% block content %}
                {% include 'partials/_hero_data.twig' with {
                    hero_icon_left: 'fa-seedling',
                    hero_icon_right: 'fa-fish',
                    hero_title: "L'aquaponie",
                    hero_subtitle: 'Tout ce que la ferme aquaponique mesure et fait, en direct : capteurs, pompes, marées et chimie de l\'eau.',
                    hero_more_url: '/aquaponie-description',
                    hero_more_label: 'En savoir plus sur le module',
                    hero_synthesis: '📊 Synthèse du <span id="summary-start-date">' ~ start_date|date('d/m/Y H:i') ~ '</span> au <span id="summary-end-date">' ~ end_date|date('d/m/Y H:i') ~ '</span> — ' ~ measure_count ~ ' mesures — ' ~ duration_str
                } %}

                <!-- Featured Post : ordre des sections = Hero, Niveaux d'eau, Paramètres physiques, Bilan hydrique (révélable), Graphiques eau/temp, Chimie, Filtrage + État système + Contrôles live -->
                <article class="post featured">
                    <!-- En un coup d'œil -->
                    <div class="aquaponie-glance" data-aos="fade-up">
                        <p>
                            <strong>En un coup d'œil.</strong> L'eau circule par cycles (comme des marées), la température et l'humidité sont stables. Pour vérifier la santé du bassin, regardez surtout les paramètres chimiques plus bas : ce sont eux qui protègent les poissons.
                        </p>
                    </div>

                    <!-- Section Niveaux d'eau -->
                    <div class="section-header" data-aos="fade-up">
                        <i class="fas fa-tint"></i>
                        <h3>Niveaux d'eau</h3>
                    </div>
                    <p class="aquaponie-section-intro" data-aos="fade-up">
                        Trois bacs sont surveillés : l'aquarium, la réserve et le potager. Pourquoi cette « marée » ? L'eau monte et descend en cycles pour irriguer les plantes puis revenir aux poissons. Note de précision : une variation d'1 cm ou moins est considérée comme une incertitude de mesure et n'est pas comptée.
                    </p>

                    <div class="stats-grid">
                        <!-- Aquarium -->
                        <div class="stat-card aquarium" data-aos="fade-up" data-aos-delay="0">
                            <i class="fas fa-fish stat-card-icon"></i>
                            <div class="stat-card-label">Aquarium</div>
                            <div class="stat-card-value" id="eauaqua-display">{% if last_reading_eauaqua is null %}—{% else %}{{ last_reading_eauaqua|number_format(1, ',', ' ') }}{% endif %} <span class="stat-card-unit">cm</span></div>
                            <div class="progress-bar-container">
                                <div class="progress-bar" id="eauaqua-progress" style="width: {% if last_reading_eauaqua is null %}0{% else %}{{ (last_reading_eauaqua / 100 * 100)|round(0) }}{% endif %}%"></div>
                            </div>
                            <div class="stat-card-details">
                                <div>Moy: <span id="eauaqua-avg">{{ avg_eauaqua|default(0)|number_format(1, ',', ' ') }}</span> cm | Écart-type: <span id="eauaqua-stddev">{{ stddev_eauaqua|default(0)|number_format(2, ',', ' ') }}</span></div>
                                <div>Min: <span id="eauaqua-min">{{ min_eauaqua|default(0)|number_format(1, ',', ' ') }}</span> cm | Max: <span id="eauaqua-max">{{ max_eauaqua|default(0)|number_format(1, ',', ' ') }}</span> cm</div>
                            </div>
                        </div>
                        
                        <!-- Réserve -->
                        <div class="stat-card reserve" data-aos="fade-up" data-aos-delay="50">
                            <i class="fas fa-droplet stat-card-icon"></i>
                            <div class="stat-card-label">Réserve</div>
                            <div class="stat-card-value" id="eaureserve-display">{{ last_reading_eaureserve|default(0)|number_format(1, ',', ' ') }} <span class="stat-card-unit">cm</span></div>
                            <div class="progress-bar-container">
                                <div class="progress-bar" id="eaureserve-progress" style="width: {{ (last_reading_eaureserve|default(0) / 100 * 100)|round(0) }}%;"></div>
                            </div>
                            <div class="stat-card-details">
                                <div>Moy: <span id="eaureserve-avg">{{ avg_eaureserve|default(0)|number_format(1, ',', ' ') }}</span> cm | Écart-type: <span id="eaureserve-stddev">{{ stddev_eaureserve|default(0)|number_format(2, ',', ' ') }}</span></div>
                                <div>Min: <span id="eaureserve-min">{{ min_eaureserve|default(0)|number_format(1, ',', ' ') }}</span> cm | Max: <span id="eaureserve-max">{{ max_eaureserve|default(0)|number_format(1, ',', ' ') }}</span> cm</div>
                            </div>
                        </div>
                        
                        <!-- Potager -->
                        <div class="stat-card potager" data-aos="fade-up" data-aos-delay="100">
                            <i class="fas fa-seedling stat-card-icon"></i>
                            <div class="stat-card-label">Potager</div>
                            <div class="stat-card-value" id="eaupota-display">{{ last_reading_eaupota|default(0)|number_format(1, ',', ' ') }} <span class="stat-card-unit">cm</span></div>
                            <div class="progress-bar-container">
                                <div class="progress-bar" id="eaupota-progress" style="width: {{ (last_reading_eaupota|default(0) / 100 * 100)|round(0) }}%;"></div>
                            </div>
                            <div class="stat-card-details">
                                <div>Moy: <span id="eaupota-avg">{{ avg_eaupota|default(0)|number_format(1, ',', ' ') }}</span> cm | Écart-type: <span id="eaupota-stddev">{{ stddev_eaupota|default(0)|number_format(2, ',', ' ') }}</span></div>
                                <div>Min: <span id="eaupota-min">{{ min_eaupota|default(0)|number_format(1, ',', ' ') }}</span> cm | Max: <span id="eaupota-max">{{ max_eaupota|default(0)|number_format(1, ',', ' ') }}</span> cm</div>
                            </div>
                        </div>
                    </div>

                    <!-- Section Paramètres physiques -->
                    <div class="section-header" data-aos="fade-up">
                        <i class="fas fa-thermometer-half"></i>
                        <h3>Paramètres physiques</h3>
                    </div>
                    
                    <div class="stats-grid">
                        <!-- Température eau -->
                        <div class="stat-card tempeau" data-aos="fade-up" data-aos-delay="0">
                            <i class="fas fa-water stat-card-icon"></i>
                            <div class="stat-card-label">Température eau</div>
                            <div class="stat-card-value" id="tempeau-display">{{ last_reading_tempeau|default(0)|round(1) }} <span class="stat-card-unit">°C</span></div>
                            <div class="progress-bar-container">
                                <div class="progress-bar" id="tempeau-progress" style="width: {{ (last_reading_tempeau|default(0) / 40 * 100)|round(0) }}%;"></div>
                            </div>
                            <div class="stat-card-details">
                                <div>Moy: <span id="tempeau-avg">{{ avg_tempeau|default(0)|round(1) }}</span> °C | Écart-type: <span id="tempeau-stddev">{{ stddev_tempeau|default(0)|round(2) }}</span></div>
                                <div>Min: <span id="tempeau-min">{{ min_tempeau|default(0) }}</span> °C | Max: <span id="tempeau-max">{{ max_tempeau|default(0) }}</span> °C</div>
                            </div>
                        </div>
                        
                        <!-- Température air -->
                        <div class="stat-card reserve" data-aos="fade-up" data-aos-delay="50">
                            <i class="fas fa-temperature-high stat-card-icon"></i>
                            <div class="stat-card-label">Température air</div>
                            <div class="stat-card-value" id="tempair-display">{{ last_reading_tempair|default(0)|round(1) }} <span class="stat-card-unit">°C</span></div>
                            <div class="progress-bar-container">
                                <div class="progress-bar" id="tempair-progress" style="width: {{ (last_reading_tempair|default(0) / 40 * 100)|round(0) }}%;"></div>
                            </div>
                            <div class="stat-card-details">
                                <div>Moy: <span id="tempair-avg">{{ avg_tempair|default(0)|round(1) }}</span> °C | Écart-type: <span id="tempair-stddev">{{ stddev_tempair|default(0)|round(2) }}</span></div>
                                <div>Min: <span id="tempair-min">{{ min_tempair|default(0) }}</span> °C | Max: <span id="tempair-max">{{ max_tempair|default(0) }}</span> °C</div>
                            </div>
                        </div>
                        
                        <!-- Humidité -->
                        <div class="stat-card humidity" data-aos="fade-up" data-aos-delay="100">
                            <i class="fas fa-cloud stat-card-icon"></i>
                            <div class="stat-card-label">Humidité</div>
                            <div class="stat-card-value" id="humi-display">{{ last_reading_humi|default(0)|round(1) }} <span class="stat-card-unit">%</span></div>
                            <div class="progress-bar-container">
                                <div class="progress-bar" id="humi-progress" style="width: {{ last_reading_humi|default(0) }}%;"></div>
                            </div>
                            <div class="stat-card-details">
                                <div>Moy: <span id="humi-avg">{{ avg_humi|default(0)|round(1) }}</span> % | Écart-type: <span id="humi-stddev">{{ stddev_humi|default(0)|round(2) }}</span></div>
                                <div>Min: <span id="humi-min">{{ min_humi|default(0) }}</span> % | Max: <span id="humi-max">{{ max_humi|default(0) }}</span> %</div>
                            </div>
                        </div>
                        
                        <!-- Luminosité -->
                        <div class="stat-card aquarium" data-aos="fade-up" data-aos-delay="150">
                            <i class="fas fa-lightbulb stat-card-icon"></i>
                            <div class="stat-card-label">Luminosité</div>
                            <div class="stat-card-value" id="lumi-display">{{ last_reading_lumi|default(0)|round(0) }} <span class="stat-card-unit">UA</span></div>
                            <div class="progress-bar-container">
                                <div class="progress-bar" id="lumi-progress" style="width: {{ (last_reading_lumi|default(0) / 4000 * 100)|round(0) }}%;"></div>
                            </div>
                            <div class="stat-card-details">
                                <div>Moy: <span id="lumi-avg">{{ avg_lumi|default(0)|round(0) }}</span> UA | Écart-type: <span id="lumi-stddev">{{ stddev_lumi|default(0)|round(2) }}</span></div>
                                <div>Min: <span id="lumi-min">{{ min_lumi|default(0) }}</span> UA | Max: <span id="lumi-max">{{ max_lumi|default(0) }}</span> UA</div>
                            </div>
                        </div>
                    </div>

                    <!-- Section Bilan Hydrique (révélable) -->
                    <div class="balance-reveal-wrapper" data-aos="fade-up">
                        <div class="section-header balance-reveal-header">
                            <i class="fas fa-water"></i>
                            <h3>Bilan Hydrique</h3>
                            <button type="button" class="balance-reveal-btn" aria-expanded="false" aria-controls="balance-reveal-content" id="balance-reveal-btn">
                                <i class="fas fa-chevron-down balance-reveal-btn-icon"></i>
                                En savoir plus
                            </button>
                        </div>
                        <div class="balance-reveal-content" id="balance-reveal-content" role="region" aria-label="Statistiques de consommation et marnage">
                    <div class="water-balance-grid">
                        <!-- Carte Réserve -->
                        <div class="balance-card reserve" data-aos="fade-up" data-aos-delay="0">
                            <div class="balance-card-header">
                                <i class="fas fa-droplet balance-card-icon"></i>
                                <h4 class="balance-card-title">Réserve d'eau</h4>
                            </div>
                            
                            <div class="balance-stat">
                                <span class="balance-stat-label">
                                    <i class="fas fa-arrow-down balance-icon-negative" aria-hidden="true"></i>
                                    Consommation totale
                                </span>
                                <span class="balance-stat-value negative">
                                    {{ reserve_consumption|default(0)|number_format(1, ',', ' ') }}
                                    <span class="balance-stat-unit">cm</span>
                                </span>
                            </div>
                            
                            <div class="balance-stat">
                                <span class="balance-stat-label">
                                    <i class="fas fa-arrow-up balance-icon-positive" aria-hidden="true"></i>
                                    Ravitaillement total
                                </span>
                                <span class="balance-stat-value positive">
                                    {{ reserve_refill|default(0)|number_format(1, ',', ' ') }}
                                    <span class="balance-stat-unit">cm</span>
                                </span>
                            </div>
                            
                            <div class="balance-stat">
                                <span class="balance-stat-label">
                                    <i class="fas fa-balance-scale balance-icon-neutral" aria-hidden="true"></i>
                                    Bilan net
                                </span>
                                <span class="balance-stat-value {% if reserve_balance|default(0) > 0 %}positive{% elseif reserve_balance|default(0) < 0 %}negative{% else %}neutral{% endif %}">
                                    {% if reserve_balance|default(0) > 0 %}+{% endif %}{{ reserve_balance|default(0)|number_format(1, ',', ' ') }}
                                    <span class="balance-stat-unit">cm</span>
                                </span>
                            </div>
                            
                            <div class="balance-note">
                                <i class="fas fa-info-circle"></i>
                                <strong>Note :</strong> Les variations ≤ 1 cm sont considérées comme des incertitudes de mesure et ne sont pas prises en compte.
                            </div>
                        </div>
                        
                        <!-- Carte Aquarium - Marées -->
                        <div class="balance-card aquarium" data-aos="fade-up" data-aos-delay="100">
                            <div class="balance-card-header">
                                <i class="fas fa-water balance-card-icon"></i>
                                <h4 class="balance-card-title">Cycles de marée</h4>
                            </div>
                            
                            <div class="balance-stat">
                                <span class="balance-stat-label">
                                    <i class="fas fa-arrows-alt-v"></i>
                                    Tendance actuelle
                                </span>
                                <span class="balance-stat-value neutral">
                                    {% if tide_trend == 'rising' %}
                                        <i class="fas fa-arrow-up" aria-hidden="true"></i>
                                    {% elseif tide_trend == 'falling' %}
                                        <i class="fas fa-arrow-down" aria-hidden="true"></i>
                                    {% elseif tide_trend == 'stable' %}
                                        <i class="fas fa-arrows-alt-h" aria-hidden="true"></i>
                                    {% endif %}
                                    {{ tide_trend_label|default('n/a') }}
                                </span>
                            </div>

                            <div class="balance-stat">
                                <span class="balance-stat-label">
                                    <i class="fas fa-arrows-alt-v"></i>
                                    Marnage moyen
                                </span>
                                <span class="balance-stat-value neutral">
                                    {% if tide_marnage is not null %}
                                        {{ tide_marnage|number_format(2, ',', ' ') }}
                                        <span class="balance-stat-unit">cm</span>
                                        {% if tide_marnage_stddev is not null %}
                                            <span class="balance-stat-stddev">
                                                ± {{ tide_marnage_stddev|number_format(2, ',', ' ') }}
                                            </span>
                                        {% endif %}
                                    {% else %}
                                        n/a
                                    {% endif %}
                                </span>
                            </div>
                            
                            <div class="balance-stat">
                                <span class="balance-stat-label">
                                    <i class="fas fa-clock"></i>
                                    Fréquence des marées
                                </span>
                                <span class="balance-stat-value neutral">
                                    {% if tide_frequency is not null %}
                                        {{ tide_frequency|number_format(2, ',', ' ') }}
                                        <span class="balance-stat-unit">/heure</span>
                                        {% if tide_frequency_stddev is not null %}
                                            <span class="balance-stat-stddev">
                                                ± {{ tide_frequency_stddev|number_format(2, ',', ' ') }}
                                            </span>
                                        {% endif %}
                                    {% else %}
                                        n/a
                                    {% endif %}
                                </span>
                            </div>
                            
                            <div class="balance-stat">
                                <span class="balance-stat-label">
                                    <i class="fas fa-repeat"></i>
                                    Nombre de cycles
                                </span>
                                <span class="balance-stat-value neutral">
                                    {% if tide_cycles > 0 %}{{ tide_cycles }}{% else %}n/a{% endif %}
                                </span>
                            </div>

                            <p class="balance-note" style="font-size:0.85em;opacity:0.85;margin-top:0.5em;">
                                On mesure la distance entre le capteur et la surface de l'eau. Si cette distance augmente, l'eau descend ; si elle diminue, l'eau monte. Le seuil de détection est de {{ tide_threshold_cm|default(2) }} cm.
                            </p>
                            
                            <div class="balance-stat">
                                <span class="balance-stat-label">
                                    <i class="fas fa-chart-line"></i>
                                    Consommation moyenne
                                </span>
                                <span class="balance-stat-value neutral">
                                    {{ aquarium_consumption|default(0)|number_format(2, ',', ' ') }}
                                    <span class="balance-stat-unit">cm</span>
                                </span>
                            </div>

                            <div class="balance-stat">
                                <span class="balance-stat-label">
                                    <i class="fas fa-calendar-day"></i>
                                    Consommation (tendance)
                                </span>
                                <span class="balance-stat-value {% if aquarium_consumption_per_day|default(0) > 0 %}negative{% else %}neutral{% endif %}">
                                    {% if aquarium_consumption_per_day is not null %}
                                        {{ aquarium_consumption_per_day|number_format(2, ',', ' ') }}
                                        <span class="balance-stat-unit">cm/jour</span>
                                    {% else %}
                                        n/a
                                    {% endif %}
                                </span>
                            </div>

                            <p class="balance-note" style="font-size:0.85em;opacity:0.85;margin-top:0.5em;">
                                Consommation (tendance) : pente de la courbe de tendance (régression linéaire)
                                du niveau d'aquarium, ramenée à une baisse moyenne par jour.
                            </p>
                        </div>
                    </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Graphiques Stock Navigator + Aires colorées -->
                    <h3 class="chart-container-title" data-aos="fade-up">📊 Niveaux d'eau</h3>
                    <div id="chart-stock-area-eau-D" class="chart-stock-wrapper"></div>
                    
                    <h3 class="chart-container-title" data-aos="fade-up">🌡️ Paramètres physiques</h3>
                    <div id="chart-stock-area-temp-D" class="chart-stock-wrapper"></div>
                    
                    <hr />

                    {# --------------------------------------------------------------------- #}
                    {# SUIVI DES PARAMÈTRES CHIMIQUES (même zone que Niveaux d'eau, Paramètres physiques) #}
                    {# --------------------------------------------------------------------- #}
                    <div class="chemistry-section">
                        <div class="section-header">
                            <i class="fas fa-flask"></i>
                            <h3>Suivi des paramètres chimiques de l'eau</h3>
                        </div>

                        <!-- Texte de présentation au-dessus des blocs -->
                        <div class="chemistry-info-banner">
                            <div class="chemistry-info-icon">
                                <i class="fas fa-graduation-cap"></i>
                            </div>
                            <div class="chemistry-info-content">
                                <div class="chemistry-info-title">
                                    Analyses manuelles réalisées par les élèves
                                </div>
                                <div class="chemistry-info-text">
                                    Régulièrement, les élèves analysent l'eau avec un kit d'aquariophilie. Ces mesures chimiques sont le vrai tableau de bord de santé du bassin : elles garantissent l'équilibre entre les poissons, les bactéries et les plantes.
                                </div>
                            </div>
                        </div>

                        <!-- 4 blocs en grille 2x2 (référence MSP) -->
                        <div class="chemistry-blocks-grid">
                            <!-- Bloc 1 : Paramètres principaux -->
                            <div class="chemistry-chart-card" data-aos="fade-up" data-aos-delay="0">
                                <div class="chemistry-chart-header">
                                    <i class="fas fa-chart-line chemistry-chart-icon"></i>
                                    <h3 class="chemistry-chart-title">Paramètres principaux</h3>
                                </div>
                                {% include 'partials/_google_sheet_chart.twig' with {
                                    src: 'https://docs.google.com/spreadsheets/d/e/2PACX-1vTrF6mLbo5-qLN-uhd7J2LeeV7LvE9LEr9nkyXgh7KUUh7lL-Houdx3XpIQ_-3vJk50e7dTuUAvQ-dR/pubchart?oid=209032696&format=interactive',
                                    title: 'Paramètres principaux — analyses chimiques manuelles'
                                } %}
                            </div>

                            <!-- Bloc 2 : Nutriments et minéraux -->
                            <div class="chemistry-chart-card" data-aos="fade-up" data-aos-delay="100">
                                <div class="chemistry-chart-header">
                                    <i class="fas fa-chart-area chemistry-chart-icon"></i>
                                    <h3 class="chemistry-chart-title">Nutriments et minéraux</h3>
                                </div>
                                {% include 'partials/_google_sheet_chart.twig' with {
                                    src: 'https://docs.google.com/spreadsheets/d/e/2PACX-1vTrF6mLbo5-qLN-uhd7J2LeeV7LvE9LEr9nkyXgh7KUUh7lL-Houdx3XpIQ_-3vJk50e7dTuUAvQ-dR/pubchart?oid=699943208&format=interactive',
                                    title: 'Nutriments et minéraux — analyses chimiques manuelles'
                                } %}
                            </div>

                            <!-- Bloc 3 : Équilibre chimique -->
                            <div class="chemistry-chart-card" data-aos="fade-up" data-aos-delay="200">
                                <div class="chemistry-chart-header">
                                    <i class="fas fa-chart-bar chemistry-chart-icon"></i>
                                    <h3 class="chemistry-chart-title">Équilibre chimique</h3>
                                </div>
                                {% include 'partials/_google_sheet_chart.twig' with {
                                    src: 'https://docs.google.com/spreadsheets/d/e/2PACX-1vTrF6mLbo5-qLN-uhd7J2LeeV7LvE9LEr9nkyXgh7KUUh7lL-Houdx3XpIQ_-3vJk50e7dTuUAvQ-dR/pubchart?oid=1338338691&format=interactive',
                                    title: 'Équilibre chimique — analyses chimiques manuelles'
                                } %}
                            </div>

                            <!-- Bloc 4 : Paramètres surveillés -->
                            <div class="chemistry-chart-card chemistry-legend-card">
                                <div class="chemistry-legend">
                                    <div class="chemistry-legend-title">
                                        <i class="fas fa-info-circle"></i>
                                        Paramètres surveillés
                                    </div>
                                    <div class="chemistry-legend-grid">

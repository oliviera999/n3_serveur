{% extends 'layout.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block head_css %}
<link rel="stylesheet" href="{{ base_path }}/assets/css/login-styles.css" />
{% endblock %}

{% block body_tag %}<body class="is-preload login-page">{% endblock %}

{% block content %}
<div class="login-center">
    <div class="login-container">
        <div class="login-box">
            <div class="login-header">
                <i class="fas fa-lock"></i>
                <h1>Connexion</h1>
                <p>Accès à l'interface d'administration</p>
            </div>

            {% if error %}
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i>
                {{ error }}
            </div>
            {% endif %}

            {% if message is defined %}
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                {{ message }}
            </div>
            {% endif %}

            <form method="POST" action="{% if base_path %}{{ base_path }}{% endif %}/login" class="login-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token }}" />
                <input type="hidden" name="redirect" value="{{ redirect }}" />

                <div class="form-group">
                    <label for="username">
                        <i class="fas fa-user"></i>
                        Nom d'utilisateur
                    </label>
                    <input 
                        type="text" 
                        id="username" 
                        name="username" 
                        required 
                        autofocus
                        autocomplete="username"
                        placeholder="Entrez votre nom d'utilisateur"
                    />
                </div>

                <div class="form-group">
                    <label for="password">
                        <i class="fas fa-key"></i>
                        Mot de passe
                    </label>
                    <input 
                        type="password" 
                        id="password" 
                        name="password" 
                        required
                        autocomplete="current-password"
                        placeholder="Entrez votre mot de passe"
                    />
                </div>

                <button type="submit" class="btn-login">
                    <i class="fas fa-sign-in-alt"></i>
                    Se connecter
                </button>
            </form>

            <div class="login-footer">
                <p>
                    <i class="fas fa-shield-alt"></i>
                    Connexion sécurisée
                </p>
            </div>
        </div>

        <div class="login-info">
            <p>
                <i class="fas fa-info-circle"></i>
                Plateforme N3 IoT Datas - olution
            </p>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>window.addEventListener('load', function() { document.body.classList.remove('is-preload'); });</script>
{% endblock %}

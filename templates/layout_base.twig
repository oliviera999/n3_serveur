<!DOCTYPE HTML>
<html lang="fr">
<head>
    <title>{% block page_title %}n³ iot{% endblock %}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#008B74" />
    {% if csrf_token is defined and csrf_token %}<meta name="csrf-token" content="{{ csrf_token }}" />{% endif %}
    <script src="{{ base_path|default('') }}/assets/js/theme-toggle.js"></script>
    <link rel="stylesheet" href="{{ base_path|default('') }}/assets/css/theme-variables.css" />
    <link rel="stylesheet" href="{{ base_path|default('') }}/assets/css/main.css" />
    <link rel="stylesheet" href="{{ base_path|default('') }}/assets/css/realtime-styles.css" />
    <link rel="stylesheet" href="{{ base_path|default('') }}/assets/css/fontawesome.min.css" />
    <link rel="icon" type="image/png" href="{{ base_path|default('') }}/assets/icons/favicon-n3-orange.png" />
    <link rel="shortcut icon" type="image/png" href="{{ base_path|default('') }}/assets/icons/favicon-n3-orange.png" />
    {#
       Librairies de graphiques (Highcharts/Highstock) chargees a la demande.
       Bloc vide par defaut : les pages sans graphe (ex. admin) ne telechargent plus
       ~600 Ko de scripts CDN bloquants inutilement.
       Pour activer sur une page : {% block chart_libs %}{% include 'partials/_highcharts_libs.twig' %}{% endblock %}
    #}
    {% block chart_libs %}{% endblock %}
    {% block page_styles %}{% endblock %}
</head>
<body class="is-preload">
    <div id="page-bg" aria-hidden="true"></div>
    <div id="wrapper" class="fade-in">
        <header id="header">
            <a href="/" class="logo"><img src="{{ base_path|default('') }}/assets/logo.png" alt="n³ iot datas" /><span class="logo-text">IOT</span></a>
        </header>
        {% include 'partials/_nav.twig' with { nav_active: block('nav_active')|trim, environment: environment|default('prod'), base_path: base_path|default('') } %}

        <div id="main">
            {% block content %}{% endblock %}
        </div>

        <footer id="footer">
            <div class="context-badges">{% block footer_badges %}{% endblock %}</div>
            <p>n³ IoT — Données et contrôle</p>
        </footer>
    </div>
    {% block scripts %}{% endblock %}
</body>
</html>

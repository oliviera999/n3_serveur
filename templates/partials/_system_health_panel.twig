{# Panneau état du système (temps réel). Titre optionnel. Le contenu de la grille est dans le block. #}
<div class="system-health-panel">
    <h3><i class="fas fa-heartbeat"></i> {{ health_panel_title|default('État du système') }}</h3>
    <div class="health-grid">
        {% block health_items %}{% endblock %}
    </div>
</div>

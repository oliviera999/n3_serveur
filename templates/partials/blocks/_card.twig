{# Carte de mesure (valeur live + statistiques de la période). `card` : carte du catalogue.
   Statistiques lues dans le contexte : avg_/min_/max_ + clé en lcfirst.
   format « onoff » : état d'actionneur affiché Marche / Arrêt (mis à jour en live via data-format). #}
{%- set d = card.decimals -%}
{%- set v = latest[card.key] ?? null -%}
{%- if not card.if_present or v is not null -%}
{%- set lc = card.key[:1]|lower ~ card.key[1:] -%}
{%- set suffix = card.unit ? ' ' ~ card.unit : '' -%}
{%- set has_value = v is not null and v is not same as('') -%}
<div class="stat-card{{ card.css_class ? ' ' ~ card.css_class : '' }}" style="border-left-color:{{ card.color }}" data-card="{{ card.key }}">
    <i class="fas {{ card.icon }} stat-card-icon" style="color:{{ card.color }}"></i>
    <div class="stat-card-label">{{ card.label }}</div>
    {% if card.format|default('number') == 'onoff' %}
    <div class="stat-card-value"><span data-sensor="{{ card.key }}" data-format="onoff">{{ has_value ? (v > 0 ? 'Marche' : 'Arrêt') : '—' }}</span></div>
    {% else %}
    <div class="stat-card-value"><span data-sensor="{{ card.key }}" data-decimals="{{ d }}">{{ has_value ? v|number_format(d, ',', ' ') : '—' }}</span>{% if card.unit %} <span class="stat-card-unit">{{ card.unit }}</span>{% endif %}</div>
    {% endif %}
    {% if card.stats %}
        {%- set avg = attribute(_context, 'avg_' ~ lc)|default(null) -%}
        {%- set min = attribute(_context, 'min_' ~ lc)|default(null) -%}
        {%- set max = attribute(_context, 'max_' ~ lc)|default(null) -%}
        <div class="stat-card-secondary">Moy: {{ avg is not null ? avg|number_format(d, ',', ' ') ~ suffix : '-' }} | Min: {{ min is not null ? min|number_format(d, ',', ' ') ~ suffix : '-' }} | Max: {{ max is not null ? max|number_format(d, ',', ' ') ~ suffix : '-' }}</div>
    {% endif %}
    {% if card.hint %}<div class="stat-card-secondary">{{ card.hint }}</div>{% endif %}
    {%- set lv = (last_valid|default({}))[card.key] ?? null -%}
    {% if not has_value and lv %}
        <div class="stat-card-secondary stat-card-alert" data-last-valid="{{ card.key }}">
            <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
            Pas de mesure récente. Dernière valeur valide :
            {{ card.format|default('number') == 'onoff' ? (lv.value > 0 ? 'Marche' : 'Arrêt') : lv.value|number_format(d, ',', ' ') ~ suffix }}
            le {{ lv.reading_time|localdt('d/m/Y à H:i') }}
        </div>
    {% endif %}
    {% if (stuck|default({}))[card.key] is defined %}
        <div class="stat-card-secondary stat-card-alert" data-stuck="{{ card.key }}">
            <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
            Valeur identique sur toute la période : capteur figé ?
        </div>
    {% endif %}
</div>
{%- endif -%}

{#
  Initialise ChartUpdaterGeneric avec le mapping capteurs -> graphiques.
  Variables attendues :
    - chart_ids_json  : chaîne JSON, ex '["chart-temperatures","chart-lights"]'
    - sensor_map_json : chaîne JSON, ex '{"TempAirInt":{"chartId":"chart-temperatures","seriesIndex":0}}'
    - chart_debug     : booléen (optionnel, défaut false)
#}
<script>
(function () {
    var chartIds = {{ chart_ids_json|raw }};
    var sensorMap = {{ sensor_map_json|raw }};

    window.chartUpdater = new ChartUpdaterGeneric({
        chartIds: chartIds,
        sensorMap: sensorMap,
        maxPoints: 10000,
        autoScroll: true
    });

    {% if chart_debug|default(false) %}
    console.log('[_chart_init_js] chartIds:', chartIds);
    console.log('[_chart_init_js] sensorMap keys:', Object.keys(sensorMap));
    {% endif %}

    window.chartUpdater.init();
})();
</script>

{# Initialisation du ChartUpdater générique (MSP1 / N3PP) pour mise à jour temps réel des graphiques Highcharts #}
<script>
(function() {
    var chartIds = {{ chart_ids_json|raw }};
    var sensorMap = {{ sensor_map_json|raw }};
    if (typeof window.ChartUpdaterGeneric !== 'undefined' && chartIds && chartIds.length && sensorMap) {
        window.chartUpdater = new window.ChartUpdaterGeneric({
            chartIds: chartIds,
            sensorMap: sensorMap,
            maxPoints: 10000,
            autoScroll: true
        });
        if (window.chartUpdater.init()) {
            {% if chart_debug|default(false) %}
            console.log('[ChartInit] ChartUpdaterGeneric initialisé avec ' + chartIds.length + ' graphique(s)');
            {% endif %}
        }
    }
})();
</script>

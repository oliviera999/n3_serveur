{# Barre de navigation — Accueil, Aquaponie, Potager, Élevage, Galeries, toggle dark mode #}
{% set bp = base_path|default('') %}
<nav id="nav">
    <ul class="links">
        <li class="{{ nav_active == 'home' ? 'active' }}"><a href="{{ bp }}/">Accueil</a></li>
        <li class="{{ nav_active == 'aquaponie' ? 'active' }}"><a href="{{ bp }}/{{ environment == 'test' ? 'aquaponie-test' : (environment == 'test3' ? 'aquamobile-test' : (environment == 's3' ? 'aquamobile' : 'aquaponie')) }}">Aquaponie</a></li>
        <li class="{{ nav_active == 'potager' or nav_active == 'potager_control' ? 'active' }}"><a href="{{ bp }}/meteo" title="Potager — Station météo">Potager</a></li>
        <li class="{{ nav_active == 'elevage' or nav_active == 'elevage_control' ? 'active' }}"><a href="{{ bp }}/serre" title="Élevage d'insectes — Serre">Élevage</a></li>
        <li class="{{ nav_active == 'gallery' ? 'active' }}"><a href="{{ bp }}/gallery/ffp3" title="Galeries photos des projets">Galeries</a></li>
        <li class="nav-theme-toggle">
            <button type="button" id="theme-toggle-btn" class="theme-toggle-btn" aria-label="Basculer le mode sombre" title="Mode sombre / clair">
                <i class="fas fa-moon theme-icon-dark" aria-hidden="true"></i>
                <i class="fas fa-sun theme-icon-light" aria-hidden="true"></i>
            </button>
        </li>
    </ul>
</nav>

{# Barre de navigation — pages pilotées par les switchs de la page supervision
   (état serveur global : table navPages), + toggle dark mode.
   Le lien « Utilisateurs » est piloté par le switch `admin-users` mais reste
   filtré par la permission `canManageUsers` (cf. TemplateRenderer).
   Le lien Admin/Supervision reste conditionné par la permission (jamais
   désactivable) afin de ne jamais verrouiller l'accès à la supervision. #}
{% set bp = base_path|default('') %}
<nav id="nav" aria-label="Navigation principale">
    <ul class="links">
        {% for page in nav_pages|default([]) %}
        <li class="nav-dyn-item{{ nav_active == page.key ? ' active' : '' }}" data-nav-key="{{ page.key }}"><a href="{{ page.url }}" title="{{ page.label }}"{{ nav_active == page.key ? ' aria-current="page"' : '' }}>{{ page.label }}</a></li>
        {% endfor %}
        {% if can_manage_users|default(false) %}
        <li class="nav-perm-item {{ nav_active == 'supervision' ? 'active' }}"><a href="{{ bp }}/supervision" title="Supervision et administration"{{ nav_active == 'supervision' ? ' aria-current="page"' : '' }}><i class="fas fa-cog" aria-hidden="true"></i> Admin</a></li>
        {% endif %}
        <li class="nav-theme-toggle">
            <button type="button" id="theme-toggle-btn" class="theme-toggle-btn" aria-label="Basculer le mode sombre" title="Mode sombre / clair">
                <i class="fas fa-moon theme-icon-dark" aria-hidden="true"></i>
                <i class="fas fa-sun theme-icon-light" aria-hidden="true"></i>
            </button>
        </li>
    </ul>
</nav>

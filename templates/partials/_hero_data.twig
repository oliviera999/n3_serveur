{# Bloc hero paramétrable pour les pages de données (MSP1, N3PP). #}
<header class="major" style="text-align: center; margin-bottom: 20px;">
    <h2>
        {% if hero_icon is defined %}<i class="fas {{ hero_icon }}"></i> {% endif %}
        {{ hero_title|default('Données') }}
    </h2>
    {% if hero_subtitle is defined %}
        <p>{{ hero_subtitle }}</p>
    {% endif %}
    {% if hero_synthesis is defined %}
        <p class="synthesis">{{ hero_synthesis|raw }}</p>
    {% endif %}
</header>

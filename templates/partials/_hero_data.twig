{# Bloc hero unifié (même style que aquaponie) pour MSP1, N3PP. #}
<div class="modern-header">
    <div class="header-content">
        <div class="header-title">
            {% if hero_icon_left is defined %}<i class="fas {{ hero_icon_left }} header-icon-float" aria-hidden="true"></i>{% elseif hero_icon is defined %}<i class="fas {{ hero_icon }} header-icon-float" aria-hidden="true"></i>{% endif %}
            {{ hero_title|default('Données') }}
            {% if hero_icon_right is defined %}<i class="fas {{ hero_icon_right }}" aria-hidden="true"></i>{% endif %}
        </div>
        {% if hero_subtitle is defined %}
            <p class="header-subtitle">{{ hero_subtitle }}</p>
        {% endif %}
        {% if hero_more_url is defined and hero_more_label is defined %}
            <p class="header-more"><a href="{{ hero_more_url }}">{{ hero_more_label }}</a></p>
        {% endif %}
        {% if hero_synthesis is defined %}
            <p class="header-synthesis">{{ hero_synthesis|raw }}</p>
        {% endif %}
    </div>
</div>

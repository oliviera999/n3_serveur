{# Bloc hero pour les pages de données (MSP1, N3PP, FFP3) #}
<header class="major hero-data" data-aos="fade-up">
    <h1 style="margin-bottom: 0.5em; color: #f39c12;">
        {% if hero_icon_left is defined and hero_icon_left %}
            <i class="fas {{ hero_icon_left }}"></i>
        {% endif %}
        {% if hero_icon is defined and hero_icon %}
            <i class="fas {{ hero_icon }}"></i>
        {% endif %}
        {{ hero_title|default('Données') }}
        {% if hero_icon_right is defined and hero_icon_right %}
            <i class="fas {{ hero_icon_right }}"></i>
        {% endif %}
    </h1>
    {% if hero_subtitle is defined and hero_subtitle %}
        <p class="hero-subtitle">{{ hero_subtitle }}</p>
    {% endif %}
    {% if hero_more_url is defined and hero_more_url and hero_more_label is defined and hero_more_label %}
        <p><a href="{{ base_path|default('') }}{{ hero_more_url }}" class="button primary">{{ hero_more_label }}</a></p>
    {% endif %}
    {% if hero_synthesis is defined and hero_synthesis %}
        <p class="hero-synthesis">{{ hero_synthesis|raw }}</p>
    {% endif %}
    <hr />
</header>

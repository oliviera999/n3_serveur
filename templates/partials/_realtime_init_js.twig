{# Initialisation du polling temps réel (MSP1 / N3PP) #}
<script>
(function() {
    var apiBase = {{ realtime_api_base|json_encode|raw }};
    var pollInterval = {{ poll_interval|default(15000) }};
    if (typeof initRealtimeUpdater === 'function' && apiBase) {
        initRealtimeUpdater({
            apiBasePath: apiBase,
            pollInterval: pollInterval,
            enabled: true
        });
    }
})();
</script>

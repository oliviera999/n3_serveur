<!DOCTYPE html>
<html lang="fr">
<head>
    <title>{{ page_title }}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
    <meta name="theme-color" content="#008B74" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="stylesheet" href="{{ base_path }}/assets/css/main.css" />
    <noscript><link rel="stylesheet" href="{{ base_path }}/assets/css/noscript.css" /></noscript>
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/webfonts/fa-solid-900.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/js/all.min.js" integrity="sha512-GWzVrcGlo0TxTRvz9ttioyYJ+Wwk9Ck0G81D+eO63BaqHaJ3YZX9wuqjwgfcV/MrB2PhaVX9DkYVhbFpStnqpQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <link rel="stylesheet" href="{{ base_path }}/assets/css/realtime-styles.css" />
    <link rel="manifest" href="{{ base_path }}/manifest.json" />
    <link rel="apple-touch-icon" href="{{ base_path }}/assets/icons/icon-192.png" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <link rel="shortcut icon" type="image/png" href="{{ base_path }}/assets/logo.png"/>
    <link rel="stylesheet" href="{{ base_path }}/assets/css/control-styles.css" />
    <style>
        .msg-toast { position: fixed; bottom: 20px; right: 20px; padding: 12px 20px; border-radius: 10px; color: white; font-weight: 600; z-index: 1000; display: none; animation: fadeIn 0.3s ease; }
        .msg-toast.success { background: #008B74; }
        .msg-toast.error { background: #e74c3c; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .parameter-item-switch { display: flex; flex-direction: column; gap: 6px; }
        .parameter-item-switch .modern-switch { flex-shrink: 0; }
        .parameter-item-hint { font-size: 0.82em; color: #7f8c8d; }
    </style>
</head>
<body class="is-preload" data-environment="{{ environment|default('prod') }}">
    <div id="page-bg" aria-hidden="true"></div>
    <div id="control-sync-badge" class="connecting">CONNEXION...</div>

    <div id="wrapper" class="fade-in control-wrapper">
        <header id="header">
            <a href="/" class="logo"><img src="{{ base_path }}/assets/logo.png" alt="n3 iot datas" /><span class="logo-text">IOT</span></a>
        </header>
        {% include 'partials/_nav.twig' with { nav_active: 'elevage_control', environment: environment|default('prod'), base_path: base_path|default('') } %}

        <div id="main" class="control-layout">
            <aside class="control-sidebar panel">
                <section class="control-context">
                    <div class="context-badges">
                        <span class="context-badge {{ environment == 'test' ? 'context-badge-test' : 'context-badge-prod' }}">
                            <i class="fas fa-globe"></i>
                            {{ environment == 'test' ? 'TEST' : 'PROD' }}
                        </span>
                        <span class="context-badge">
                            <i class="fas fa-code-branch"></i>
                            {{ version }}
                        </span>
                        {% if firmware_version %}
                        <span class="context-badge">
                            <i class="fas fa-microchip"></i>
                            FW {{ firmware_version }}
                        </span>
                        {% endif %}
                    </div>
                    <div class="context-summary">
                        <h2><i class="fas fa-sliders-h"></i> Serre / Élevage</h2>
                        <p class="context-description">
                            Contrôle des sorties et paramètres de la serre et de l'élevage d'insectes (n3pp). Les commandes sont transmises à l'ESP32 au prochain cycle de synchronisation.
                        </p>
                        <div class="context-stats">
                            <div class="context-stat">
                                <span class="stat-label">Sorties</span>
                                <span class="stat-value">{{ part_outputs|length }}</span>
                            </div>
                            <div class="context-stat">
                                <span class="stat-label">Board</span>
                                <span class="stat-value">{{ board }}</span>
                            </div>
                        </div>
                    </div>
                </section>
                <section class="boards-status">
                    <h3><i class="fas fa-satellite-dish"></i> Connexion</h3>
                    <div class="boards-grid">
                        <article class="board-card" data-board="{{ board }}">
                            <header>
                                <span class="board-title"><i class="fas fa-microchip"></i> Board {{ board }}</span>
                                <span class="board-last">Dernière requête : <span class="last-request-time">{{ last_board_request|default('N/A') }}</span></span>
                            </header>
                        </article>
                    </div>
                </section>
            </aside>

            <section class="control-main panel">
                <header class="control-main-header">
                    <div class="header-left">
                        <h1><i class="fas fa-seedling"></i> Contrôle N3PP – Serre & Élevage</h1>
                        <p>Activez/désactivez les sorties et configurez les paramètres du firmware n3pp4_2 (arrosage, énergie, notifications).</p>
                        <div class="callout callout-warning">
                            <i class="fas fa-triangle-exclamation"></i>
                            <span>Les commandes agissent sur le système physique. Vérifiez sur site avant d'activer les sorties.</span>
                        </div>
                    </div>
                </header>

                <section class="controls-section">
                    <div class="controls-group">
                        <header>
                            <h2><i class="fas fa-bolt"></i> Sorties</h2>
                        </header>
                        <div class="control-cards-grid">
                            {% for output in part_outputs %}
                            <article class="action-card" data-state="{{ output.state }}" data-gpio="{{ output.gpio }}">
                                <header>
                                    <div class="action-icon"><i class="fas fa-plug"></i></div>
                                    <div>
                                        <h3>{{ output.name|default('GPIO ' ~ output.gpio) }}</h3>
                                    </div>
                                </header>
                                <footer>
                                    <span data-state-label>{{ output.state == '1' ? 'Activé' : 'Désactivé' }}</span>
                                    <label class="modern-switch" title="Toggle sortie">
                                        <input type="checkbox" onchange="updateOutput(this)" id="output-{{ output.id }}" data-id="{{ output.id }}" data-gpio="{{ output.gpio }}" {{ output.state == '1' ? 'checked' : '' }} role="switch" aria-checked="{{ output.state == '1' ? 'true' : 'false' }}" aria-label="{{ output.name|default('GPIO ' ~ output.gpio) }}">
                                        <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                                    </label>
                                </footer>
                            </article>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="controls-group">
                        <header>
                            <h2><i class="fas fa-droplet"></i> Changer les paramètres</h2>
                        </header>
                        <form id="form-params-n3pp" class="parameters-panel" method="post" action="">
                            <h3>Paramètres</h3>
                            <div class="parameters-grid">
                                <label class="parameter-item">
                                    <span>Mail</span>
                                    <input type="text" name="mail" id="mail" value="{{ params.mail|default('')|e('html_attr') }}" placeholder="email@exemple.com">
                                </label>
                                <label class="parameter-item parameter-item-switch">
                                    <span>Notification par mail</span>
                                    <label class="modern-switch" title="Activer/désactiver les notifications par mail">
                                        <input type="checkbox" id="mailNotif" {{ params.mailNotif|default('') == 'checked' ? 'checked' : '' }} role="switch" aria-label="Notification par mail">
                                        <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                                    </label>
                                    <span class="parameter-item-hint">{{ params.mailNotif|default('') == 'checked' ? 'Activé' : 'Désactivé' }}</span>
                                </label>
                                <label class="parameter-item">
                                    <span>Limite de sécheresse (SeuilSec)</span>
                                    <input type="number" name="SeuilSec" id="SeuilSec" min="0" value="{{ params.SeuilSec|default('0') }}">
                                </label>
                                <label class="parameter-item">
                                    <span>Limite du pont diviseur (SeuilPontDiv)</span>
                                    <input type="number" name="SeuilPontDiv" id="SeuilPontDiv" min="0" value="{{ params.SeuilPontDiv|default('0') }}">
                                </label>
                                <label class="parameter-item">
                                    <span>Heure arrosage</span>
                                    <input type="number" name="HeureArrosage" id="HeureArrosage" min="0" value="{{ params.HeureArrosage|default('0') }}">
                                </label>
                                <label class="parameter-item">
                                    <span>Temps arrosage (en ms)</span>
                                    <input type="number" name="tempsArrosage" id="tempsArrosage" min="0" value="{{ params.tempsArrosage|default('0') }}">
                                </label>
                                <label class="parameter-item parameter-item-switch">
                                    <span>Éco d'énergie (WakeUp)</span>
                                    <label class="modern-switch" title="Activer/désactiver l'éco d'énergie">
                                        <input type="checkbox" id="WakeUp" {{ params.WakeUp|default('0') == '1' ? 'checked' : '' }} role="switch" aria-label="Éco d'énergie (WakeUp)">
                                        <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                                    </label>
                                    <span class="parameter-item-hint">{{ params.WakeUp|default('0') == '1' ? 'Activé' : 'Désactivé' }}</span>
                                </label>
                                <label class="parameter-item">
                                    <span>Fréquence d'éveil (FreqWakeUp)</span>
                                    <input type="number" name="FreqWakeUp" id="FreqWakeUp" min="0" value="{{ params.FreqWakeUp|default('0') }}">
                                </label>
                            </div>
                            <input type="hidden" name="action" value="output_create">
                            <button type="submit" class="trigger-ota-btn" style="margin-top:12px;">Changer les valeurs</button>
                        </form>
                    </div>
                </section>

                <section class="quick-actions panel">
                    <h3><i class="fas fa-bolt"></i> Actions rapides</h3>
                    <div class="quick-actions-grid">
                        <a href="{{ base_path|default('') }}/n3pp/n3ppdatas/n3pp-data.php" class="quick-action-card"><i class="fas fa-chart-line"></i> Retour aux données</a>
                        <a href="{{ base_path|default('') }}/" class="quick-action-card"><i class="fas fa-home"></i> Accueil</a>
                    </div>
                </section>
            </section>
        </div>
    </div>

    <div id="msg-toast" class="msg-toast"></div>

    <script src="{{ base_path }}/assets/js/control-sync.js"></script>
    <script>
    (function() {
        var base = '{{ base_path }}' || '';
        if (base && base.indexOf('/') !== 0) base = '/' + base;
        var actionUrl = base + '/n3pp/n3ppcontrol/n3pp-outputs-action.php'.replace(/\/+/g, '/');

        window.updateOutput = function(el) {
            var id = el.getAttribute('data-id');
            var state = el.checked ? '1' : '0';
            var card = el.closest('.action-card');
            var label = card ? card.querySelector('[data-state-label]') : null;

            fetch(actionUrl + '?action=output_update&id=' + encodeURIComponent(id) + '&state=' + state, { method: 'GET', headers: { 'Accept': 'application/json' } })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success) {
                        if (card) card.setAttribute('data-state', state);
                        if (label) label.textContent = state === '1' ? 'Activé' : 'Désactivé';
                        showToast('Commande envoyée', 'success');
                    } else {
                        el.checked = !el.checked;
                        showToast(data.error || 'Erreur', 'error');
                    }
                })
                .catch(function() {
                    el.checked = !el.checked;
                    showToast('Erreur réseau', 'error');
                });
        };

        function showToast(msg, type) {
            var t = document.getElementById('msg-toast');
            if (!t) return;
            t.textContent = msg;
            t.className = 'msg-toast ' + (type || 'success');
            t.style.display = 'block';
            setTimeout(function() { t.style.display = 'none'; }, 3000);
        }

        document.getElementById('form-params-n3pp').addEventListener('submit', function(e) {
            e.preventDefault();
            var form = this;
            var btn = form.querySelector('button[type="submit"]');
            var data = new URLSearchParams(new FormData(form));
            var wakeUpEl = document.getElementById('WakeUp');
            if (wakeUpEl) data.set('WakeUp', wakeUpEl.checked ? '1' : '0');
            var mailNotifEl = document.getElementById('mailNotif');
            if (mailNotifEl) data.set('mailNotif', mailNotifEl.checked ? 'checked' : 'false');
            if (btn) btn.disabled = true;

            fetch(actionUrl, { method: 'POST', body: data, headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' } })
                .then(function(r) { return r.json(); })
                .then(function(res) {
                    if (res.success) {
                        showToast('Changement pris en compte', 'success');
                        setTimeout(function() { window.location.reload(); }, 1000);
                    } else {
                        showToast(res.error || 'Erreur', 'error');
                        if (btn) btn.disabled = false;
                    }
                })
                .catch(function() {
                    showToast('Erreur réseau', 'error');
                    if (btn) btn.disabled = false;
                });
        });

        var apiBase = (base + '/n3pp/api/outputs').replace(/\/+/g, '/');
        window.controlSync = new ControlSync({ apiBase: apiBase, pollInterval: 10000, useFresh: true });
        controlSync.initializeFromDOM();
        controlSync.start();
    })();
    </script>
</body>
</html>

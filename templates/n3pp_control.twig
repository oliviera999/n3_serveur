{% extends 'partials/_control_base.twig' %}

{% block outputs_section %}
    <div id="params-n3pp-container" data-aos="fade-up">
    <section class="controls-section">
        <div class="controls-group">
            <header>
                <h2><i class="fas fa-water"></i> Gestion de l'eau</h2>
            </header>
            <div class="control-cards-grid">
                {% for output in outputs %}
                {% set gpio = output.gpio|default(0) %}
                <article class="action-card" data-state="{{ output.state }}" data-gpio="{{ gpio }}">
                    <header>
                        <div class="action-icon"><i class="fas fa-droplet"></i></div>
                        <div>
                            <h3>
                                {% if gpio == 12 %}
                                    Pompe irrigation
                                {% elseif gpio == 13 %}
                                    Arrosage manuel
                                {% else %}
                                    {{ output.name|default('GPIO ' ~ gpio) }}
                                {% endif %}
                            </h3>
                            {% if gpio == 13 %}
                            <p class="action-description">Déclenche un cycle unique au prochain poll ESP32.</p>
                            {% elseif gpio == 15 or gpio == 16 %}
                            <p class="action-description parameter-item-hint">Non connecté au firmware — commande enregistrée en BDD uniquement.</p>
                            {% endif %}
                        </div>
                    </header>
                    <footer>
                        <span data-state-label>{{ output.state == '1' ? 'Activé' : 'Désactivé' }}</span>
                        <label class="modern-switch" title="Toggle sortie">
                            <input type="checkbox" onchange="updateOutput(this)" id="output-{{ output.id }}" data-id="{{ output.id }}" data-gpio="{{ gpio }}" {{ output.state == '1' ? 'checked' : '' }} role="switch" aria-checked="{{ output.state == '1' ? 'true' : 'false' }}" aria-label="{{ output.name|default('GPIO ' ~ gpio) }}">
                            <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                        </label>
                    </footer>
                </article>
                {% endfor %}
            </div>
            <section class="parameters-panel">
                <h3>Paramètres arrosage</h3>
                <div class="parameters-grid">
                    <label class="parameter-item" data-parameter-wrapper title="Seuil ADC brut (0–4095), comparé à HumidMoy côté firmware — en dessous, le système déclenche l'arrosage">
                        <span>Seuil de sécheresse</span>
                        <input type="number" data-parameter="SeuilSec" data-parameter-gpio="102" id="SeuilSec" min="0" max="4095" value="{{ params.SeuilSec|default('0') }}">
                        <small class="save-indicator" data-save-indicator data-parameter="SeuilSec" data-state="idle"></small>
                    </label>
                    <label class="parameter-item" data-parameter-wrapper title="Heure de la journée (0–23) pour le déclenchement de l'arrosage automatique">
                        <span>Heure arrosage</span>
                        <input type="number" data-parameter="HeureArrosage" data-parameter-gpio="104" id="HeureArrosage" min="0" max="23" value="{{ params.HeureArrosage|default('0') }}">
                        <small class="save-indicator" data-save-indicator data-parameter="HeureArrosage" data-state="idle"></small>
                    </label>
                    <label class="parameter-item" data-parameter-wrapper title="Durée d'un cycle d'arrosage en secondes (max 20 s côté firmware)">
                        <span>Durée arrosage (s)</span>
                        <input type="number" data-parameter="tempsArrosage" data-parameter-gpio="105" id="tempsArrosage" min="1" max="20" value="{{ params.tempsArrosage|default('0') }}">
                        <small class="save-indicator" data-save-indicator data-parameter="tempsArrosage" data-state="idle"></small>
                    </label>
                </div>
            </section>
        </div>

        <div class="controls-group">
            <header>
                <h2><i class="fas fa-envelope"></i> Notification</h2>
            </header>
            <div class="parameters-panel">
                {% include 'partials/_notification_policy.twig' with { mail_gpio: 100, test_mail: true } %}
            </div>
        </div>

        <div class="controls-group">
            <header>
                <h2><i class="fas fa-bolt"></i> Énergie</h2>
            </header>
            <div class="parameters-panel">
                <div class="parameters-grid">
                    <label class="parameter-item parameter-item-switch" title="Coché = veille entre les mesures (WakeUp=0). Décoché = module toujours éveillé.">
                        <span>Mode économie d'énergie</span>
                        <label class="modern-switch" title="Activer/désactiver l'éco d'énergie">
                            <input type="checkbox" data-parameter-gpio="106" id="WakeUp" {{ params.WakeUp|default('0') == '0' ? 'checked' : '' }} role="switch" aria-label="Mode économie d'énergie" onchange="saveParamSwitch('WakeUp', this.checked, '0', '1')">
                            <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                        </label>
                        <span class="parameter-item-hint" id="WakeUp-hint">{{ params.WakeUp|default('0') == '0' ? 'Activé' : 'Désactivé' }}</span>
                    </label>
                    <label class="parameter-item" data-parameter-wrapper title="Intervalle entre les réveils du système pour prendre les mesures (secondes, 1–86400)">
                        <span>Fréquence de réveil (s)</span>
                        <input type="number" data-parameter="FreqWakeUp" data-parameter-gpio="107" id="FreqWakeUp" min="1" max="86400" value="{{ params.FreqWakeUp|default('0') }}">
                        <small class="save-indicator" data-save-indicator data-parameter="FreqWakeUp" data-state="idle"></small>
                    </label>
                    <label class="parameter-item" data-parameter-wrapper title="Seuil de tension batterie en dessous duquel le système se met en veille">
                        <span>Seuil batterie (veille)</span>
                        <input type="number" data-parameter="SeuilPontDiv" data-parameter-gpio="103" id="SeuilPontDiv" min="0" value="{{ params.SeuilPontDiv|default('0') }}">
                        <small class="save-indicator" data-save-indicator data-parameter="SeuilPontDiv" data-state="idle"></small>
                    </label>
                    <label class="parameter-item parameter-item-switch" title="Coché = sous le seuil batterie, le module entre en veille infinie (réveil bouton uniquement) pour préserver la batterie. Décoché = il continue son cycle de réveil normal malgré la batterie basse.">
                        <span>Veille infinie batterie faible</span>
                        <label class="modern-switch" title="Activer/désactiver la mise en veille infinie sous le seuil batterie">
                            <input type="checkbox" data-parameter-gpio="112" id="veilleInfinie" {{ params.veilleInfinie|default('1') == '1' ? 'checked' : '' }} role="switch" aria-label="Veille infinie batterie faible" onchange="saveParamSwitch('veilleInfinie', this.checked, '1', '0')">
                            <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                        </label>
                        <span class="parameter-item-hint" id="veilleInfinie-hint">{{ params.veilleInfinie|default('1') == '1' ? 'Activée' : 'Désactivée' }}</span>
                    </label>
                </div>
            </div>
            {% if reset_output is defined and reset_output is not null %}
            <div class="control-cards-grid" style="margin-top: 1rem;">
                <article class="action-card warning" data-state="{{ reset_output.state }}" data-gpio="110">
                    <header>
                        <div class="action-icon"><i class="fas fa-arrows-rotate"></i></div>
                        <div>
                            <h3>Reset ESP</h3>
                        </div>
                    </header>
                    <p class="action-description">Redémarre le microcontrôleur. À utiliser en dernier recours.</p>
                    <footer>
                        <span data-state-label>{{ reset_output.state == '1' ? 'Activé' : 'Désactivé' }}</span>
                        <label class="modern-switch" title="Reset ESP">
                            <input type="checkbox" onchange="updateOutput(this)" id="output-reset-esp" data-id="{{ reset_output.id }}" data-gpio="110" {{ reset_output.state == '1' ? 'checked' : '' }} role="switch" aria-label="Reset ESP">
                            <span class="modern-switch-slider"><span class="modern-switch-button"></span></span>
                        </label>
                    </footer>
                </article>
            </div>
            {% endif %}
        </div>
    </section>
    </div>
{% endblock %}

{% block quick_actions_links %}
    <a href="{{ base_path|default('') }}/serre" class="quick-action-card"><i class="fas fa-chart-line"></i> Retour aux données</a>
    <a href="{{ base_path|default('') }}/" class="quick-action-card"><i class="fas fa-home"></i> Accueil</a>
{% endblock %}

{% block control_scripts %}
    {% include 'partials/_control_init_js.twig' with { realtime_api_base: realtime_api_base|default('/n3pp/api/realtime') } %}
{% endblock %}

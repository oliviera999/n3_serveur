{% block scripts %}
<script>
// Configuration des switchs de navigation (état serveur global, pilotage admin).
// Lu par page-nav-toggles.js. Défini avant DOMContentLoaded.
window.NAV_PAGES_API = '{{ base_path }}' + '/api/nav-pages/toggle';
window.NAV_PAGES_CAN_EDIT = {{ can_access_control|default(false) ? 'true' : 'false' }};
window.NAV_PAGES_STATE = {{ nav_states|default({})|json_encode|raw }};
</script>
<script>
(function() {
    var BASE = '{{ base_path }}' || '';
    var LIVE_MODULES = [
        { id: 'ffp3-wroom-prod', url: BASE + '/api/realtime/system/health' },
        { id: 'ffp3-wroom-test', url: BASE + '/api/realtime-test/system/health' },
        { id: 'ffp3-s3-prod', url: BASE + '/api/realtime3/system/health' },
        { id: 'ffp3-s3-test', url: BASE + '/api/realtime3-test/system/health' },
        { id: 'msp1-prod', url: BASE + '/msp1/api/realtime/system/health' },
        { id: 'msp1-test', url: BASE + '/msp1-test/api/realtime/system/health' },
        { id: 'n3pp-prod', url: BASE + '/n3pp/api/realtime/system/health' },
        { id: 'n3pp-test', url: BASE + '/n3pp-test/api/realtime/system/health' }
    ];
    var POLL_INTERVAL_MS = 15000;

    function formatHealthDatetime(health) {
        if (!health) return '—';
        // Priorité à l'epoch serveur (last_reading_ts) : formaté en heure de
        // Casablanca via Intl (gère le DST, sans dépendance), cohérent avec le
        // reste du site (DisplayTime / realtime-updater.js).
        if (health.last_reading_ts !== null && health.last_reading_ts !== undefined) {
            try {
                return new Date(health.last_reading_ts * 1000).toLocaleString('fr-FR', {
                    timeZone: 'Africa/Casablanca',
                    day: '2-digit', month: '2-digit', year: 'numeric',
                    hour: '2-digit', minute: '2-digit', second: '2-digit'
                });
            } catch (e) { /* repli legacy ci-dessous */ }
        }
        var str = health.last_reading;
        if (!str) return '—';
        var d = new Date(str.replace(' ', 'T'));
        if (isNaN(d.getTime())) return str;
        var pad = function(n) { return (n < 10 ? '0' : '') + n; };
        return pad(d.getDate()) + '/' + pad(d.getMonth() + 1) + '/' + d.getFullYear() + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
    }

    // N'écrit dans le DOM que si la valeur change : évite que l'aria-live de la
    // grille ré-annonce les 8 cartes à chaque poll (15 s) aux lecteurs d'écran.
    function setIfChanged(el, prop, value) {
        if (el[prop] !== value) el[prop] = value;
    }

    function updateCard(moduleId, health) {
        var card = document.querySelector('.live-card[data-module="' + moduleId + '"]');
        if (!card) return;
        var badge = card.querySelector('.live-card-badge');
        var datetimeEl = card.querySelector('.live-card-datetime');
        if (!badge || !datetimeEl) return;

        if (health === null) {
            setIfChanged(card, 'className', 'live-card live-error');
            setIfChanged(badge, 'className', 'live-card-badge error');
            setIfChanged(badge, 'innerHTML', '<i class="fas fa-exclamation-triangle"></i> Erreur');
            setIfChanged(datetimeEl, 'textContent', '—');
            return;
        }

        var online = health.online === true;
        setIfChanged(card, 'className', 'live-card ' + (online ? 'live-online' : 'live-offline'));
        setIfChanged(badge, 'className', 'live-card-badge ' + (online ? 'online' : 'offline'));
        setIfChanged(badge, 'innerHTML', '<i class="fas fa-circle"></i> ' + (online ? 'LIVE' : 'HORS LIGNE'));
        setIfChanged(datetimeEl, 'textContent', formatHealthDatetime(health) || '—');
    }

    function setLoading(moduleId) {
        var card = document.querySelector('.live-card[data-module="' + moduleId + '"]');
        if (!card) return;
        var badge = card.querySelector('.live-card-badge');
        var datetimeEl = card.querySelector('.live-card-datetime');
        if (!badge || !datetimeEl) return;
        card.className = 'live-card live-loading';
        badge.className = 'live-card-badge loading';
        badge.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Chargement...';
        datetimeEl.textContent = '—';
    }

    function fetchOne(mod) {
        return fetch(mod.url).then(function(r) {
            if (r.ok) return r.json();
            return null;
        }).catch(function() { return null; });
    }

    function pollAll(isFirst) {
        if (isFirst) {
            LIVE_MODULES.forEach(function(mod) { setLoading(mod.id); });
        }
        Promise.all(LIVE_MODULES.map(function(mod) {
            return fetchOne(mod).then(function(h) { updateCard(mod.id, h); });
        })).catch(function() {});
    }

    pollAll(true);
    setInterval(function() { pollAll(false); }, POLL_INTERVAL_MS);
})();

function csrfToken() {
    var meta = document.querySelector('meta[name="csrf-token"]');
    return meta ? meta.getAttribute('content') : '';
}

var clearAllCacheBtn = document.getElementById('clearAllCacheBtn');
if (clearAllCacheBtn) clearAllCacheBtn.addEventListener('click', async function () {
    var btn = this;
    var resultEl = document.getElementById('clearCacheResult');
    var url = btn.getAttribute('data-clear-url');
    btn.disabled = true;
    resultEl.className = 'cache-result';
    resultEl.textContent = 'Vidage en cours…';
    resultEl.style.display = 'block';
    try {
        var response = await fetch(url, {
            method: 'POST',
            headers: { 'X-CSRF-Token': csrfToken() }
        });
        var data = await response.json();
        resultEl.className = 'cache-result ' + (data.success ? 'success' : 'error');
        resultEl.textContent = data.message || (data.errors && data.errors.join(' ; ')) || 'Erreur inconnue';
    } catch (e) {
        resultEl.className = 'cache-result error';
        resultEl.textContent = 'Erreur : ' + (e.message || 'réseau');
    } finally {
        btn.disabled = false;
    }
});

var runGallerySortBtn = document.getElementById('runGallerySortBtn');
if (runGallerySortBtn) runGallerySortBtn.addEventListener('click', async function () {
    var btn = this;
    var resultEl = document.getElementById('runGallerySortResult');
    var url = btn.getAttribute('data-sort-url');
    if (!confirm('Lancer le tri auto sur toutes les galeries (MSP1, N3PP, FFP3) ?')) {
        return;
    }
    btn.disabled = true;
    resultEl.className = 'cache-result';
    resultEl.textContent = 'Tri global en cours…';
    resultEl.style.display = 'block';
    try {
        var response = await fetch(url, {
            method: 'POST',
            headers: { 'X-CSRF-Token': csrfToken() }
        });
        var data = await response.json();
        if (data.success) {
            var r = data.data || {};
            resultEl.className = 'cache-result success';
            resultEl.textContent = 'Tri terminé : ' + (r.moved || 0) + ' photo(s) déplacée(s) en corbeille sur ' + (r.scanned || 0) + ' analysée(s).';
        } else {
            resultEl.className = 'cache-result error';
            resultEl.textContent = data.message || 'Erreur pendant le tri';
        }
    } catch (e) {
        resultEl.className = 'cache-result error';
        resultEl.textContent = 'Erreur : ' + (e.message || 'réseau');
    } finally {
        btn.disabled = false;
    }
});

(function () {
    var BASE = '{{ base_path|default('') }}';
    var API = BASE + '/admin/api/hmac-audit';
    var cb = document.getElementById('hmacAuditSupervisionCb');
    var statusEl = document.getElementById('hmacAuditSupervisionStatus');
    var previewEl = document.getElementById('hmacAuditSupervisionPreview');
    var strictCb = document.getElementById('hmacStrictSupervisionCb');
    var nonceCb = document.getElementById('hmacNonceSupervisionCb');
    var strictSourceEl = document.getElementById('hmacStrictSource');
    var nonceSourceEl = document.getElementById('hmacNonceSource');
    var policyResetBtn = document.getElementById('hmacPolicyResetBtn');
    var CAN_EDIT_POLICY = {{ can_access_control|default(false) ? 'true' : 'false' }};

    function setPolicyUi(policy) {
        if (!policy) return;
        if (strictCb) strictCb.checked = !!policy.strict;
        if (nonceCb) nonceCb.checked = !!policy.nonce_required;
        if (strictSourceEl) {
            strictSourceEl.textContent = '(' + (policy.strict_source === 'database' ? 'supervision' : '.env')
                + ' : ' + (policy.env_strict ? 'true' : 'false') + ')';
        }
        if (nonceSourceEl) {
            nonceSourceEl.textContent = '(' + (policy.nonce_source === 'database' ? 'supervision' : '.env')
                + ' : ' + (policy.env_nonce_required ? 'true' : 'false') + ')';
        }
    }

    function postPolicy(body) {
        return fetch(API + '/toggle-policy', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrfToken()
            },
            body: JSON.stringify(body)
        }).then(function (r) { return r.json(); });
    }

    function bindPolicyToggle(el, field) {
        if (!el || !CAN_EDIT_POLICY) return;
        el.addEventListener('change', function () {
            var want = el.checked;
            var payload = {};
            payload[field] = want;
            if (field === 'strict' && want && !confirm('Activer le mode strict ? Les firmwares sans HMAC recevront 401.')) {
                el.checked = !want;
                return;
            }
            postPolicy(payload)
                .then(function (data) {
                    if (data && data.success && data.policy) {
                        setPolicyUi(data.policy);
                    } else {
                        el.checked = !want;
                        alert((data && data.error) ? data.error : 'Échec de la bascule.');
                    }
                })
                .catch(function () {
                    el.checked = !want;
                    alert('Erreur réseau.');
                });
        });
    }

    bindPolicyToggle(strictCb, 'strict');
    bindPolicyToggle(nonceCb, 'nonce_required');

    if (policyResetBtn && CAN_EDIT_POLICY) {
        policyResetBtn.addEventListener('click', function () {
            if (!confirm('Supprimer les overrides supervision et revenir aux valeurs .env ?')) return;
            fetch(API + '/reset-policy', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken()
                },
                body: JSON.stringify({ target: 'all' })
            })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data && data.success && data.policy) {
                        setPolicyUi(data.policy);
                    } else {
                        alert((data && data.error) ? data.error : 'Échec.');
                    }
                })
                .catch(function () { alert('Erreur réseau.'); });
        });
    }

    function setStatus(enabled) {
        if (statusEl) statusEl.textContent = enabled ? 'Actif' : 'Inactif';
        if (cb) cb.checked = enabled;
    }

    function renderPreview(entries) {
        if (!previewEl) return;
        if (!entries || entries.length === 0) {
            previewEl.textContent = 'Aucune entrée récente.';
            return;
        }
        var lines = entries.slice(-8).map(function (e) { return e.line || e.raw || ''; });
        previewEl.textContent = lines.join('\n');
    }

    function loadPreview() {
        fetch(API + '/entries?limit=20', { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data && data.success) {
                    setStatus(!!data.enabled);
                    renderPreview(data.entries || []);
                    if (data.policy) setPolicyUi(data.policy);
                }
            })
            .catch(function () {
                if (previewEl) previewEl.textContent = 'Aperçu indisponible.';
            });
    }

    if (cb) {
        cb.addEventListener('change', function () {
            var want = cb.checked;
            fetch(API + '/toggle', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken()
                },
                body: JSON.stringify({ enabled: want })
            })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data && data.success) {
                        setStatus(!!data.enabled);
                    } else {
                        cb.checked = !want;
                        alert((data && data.error) ? data.error : 'Échec de la bascule.');
                    }
                })
                .catch(function () {
                    cb.checked = !want;
                    alert('Erreur réseau.');
                });
        });
    }

    loadPreview();
    setInterval(loadPreview, 30000);
})();

(function () {
    var BASE = '{{ base_path|default('') }}';
    var API = BASE + '/admin/api/operational-settings';
    var CAN_EDIT = {{ can_access_control|default(false) ? 'true' : 'false' }};
    var root = document.getElementById('opSettingsContent');
    var saveBtn = document.getElementById('opSettingsSaveBtn');
    var resetBtn = document.getElementById('opSettingsResetAllBtn');
    var resultEl = document.getElementById('opSettingsResult');
    var pending = {};

    function showResult(msg, ok) {
        if (!resultEl) return;
        resultEl.style.display = 'block';
        resultEl.className = 'cache-result ' + (ok ? 'success' : 'error');
        resultEl.textContent = msg;
    }

    function fieldId(key) { return 'op_' + key; }

    function renderField(s) {
        var key = s.env_key;
        var type = s.type;
        var val = s.effective;
        var src = s.source === 'database' ? 'supervision' : '.env';
        var html = '<div class="op-field">';
        html += '<div class="op-field-header">';
        html += '<code class="op-env-key">' + escapeHtml(key) + '</code>';
        html += '<span class="op-label">' + escapeHtml(s.label) + '</span>';
        if (s.hint) html += '<span class="op-desc">— ' + escapeHtml(s.hint) + '</span>';
        html += '<span class="op-src">(' + src + ')</span>';
        html += '</div><div class="op-field-control">';
        var disabled = CAN_EDIT ? '' : ' disabled';
        if (type === 'bool') {
            html += '<label class="page-nav-toggle"><input type="checkbox" data-key="' + key + '" id="' + fieldId(key) + '"' + (val ? ' checked' : '') + disabled + '><span class="page-nav-slider"></span></label>';
        } else if (type === 'enum' && s.options) {
            html += '<select data-key="' + key + '" id="' + fieldId(key) + '"' + disabled + ' style="max-width:220px;padding:4px;">';
            s.options.forEach(function (o) {
                html += '<option value="' + o + '"' + (String(val).toLowerCase() === String(o).toLowerCase() ? ' selected' : '') + '>' + o + '</option>';
            });
            html += '</select>';
        } else if (type === 'optional_int' || type === 'optional_float') {
            var ph = 'vide = désactivé';
            var v = (val === null || val === undefined) ? '' : val;
            html += '<input type="number" step="' + (type === 'optional_float' ? 'any' : '1') + '" data-key="' + key + '" id="' + fieldId(key) + '" value="' + escapeAttr(v) + '" placeholder="' + ph + '"' + disabled;
            if (s.min != null) html += ' min="' + s.min + '"';
            if (s.max != null) html += ' max="' + s.max + '"';
            html += ' style="max-width:140px;padding:4px;">';
            if (s.unit) html += ' <span style="font-size:12px;color:#666;">' + escapeHtml(s.unit) + '</span>';
        } else if (type === 'string') {
            html += '<input type="text" data-key="' + key + '" id="' + fieldId(key) + '" value="' + escapeAttr(val || '') + '"' + disabled + ' style="width:100%;max-width:480px;padding:4px;">';
        } else {
            html += '<input type="number" step="' + (type === 'float' ? 'any' : '1') + '" data-key="' + key + '" id="' + fieldId(key) + '" value="' + escapeAttr(val) + '"' + disabled;
            if (s.min != null) html += ' min="' + s.min + '"';
            if (s.max != null) html += ' max="' + s.max + '"';
            html += ' style="max-width:140px;padding:4px;">';
            if (s.unit) html += ' <span style="font-size:12px;color:#666;">' + escapeHtml(s.unit) + '</span>';
        }
        html += '</div></div>';
        return html;
    }

    function escapeHtml(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function escapeAttr(s) { return escapeHtml(s).replace(/"/g, '&quot;'); }

    function renderPanel(data) {
        if (!root || !data || !data.settings) return;
        var groups = data.groups || {};
        var byGroup = {};
        data.settings.forEach(function (s) {
            if (!byGroup[s.group]) byGroup[s.group] = [];
            byGroup[s.group].push(s);
        });
        var html = '';
        Object.keys(groups).forEach(function (gid) {
            var items = byGroup[gid] || [];
            if (!items.length) return;
            html += '<details class="op-group" style="margin:10px 0;background:#f8f9fa;border-radius:8px;padding:8px 12px;" open>';
            html += '<summary style="cursor:pointer;font-weight:700;color:#008B74;">' + escapeHtml(groups[gid]) + ' (' + items.length + ')</summary>';
            html += '<div style="margin-top:8px;">';
            items.forEach(function (s) { html += renderField(s); });
            if (CAN_EDIT) {
                html += '<button type="button" class="btn-cache op-reset-group" data-group="' + gid + '" style="margin-top:8px;font-size:12px;background:#6c757d;">Réinitialiser ce groupe (.env)</button>';
            }
            html += '</div></details>';
        });
        root.innerHTML = html || '<em>Aucun réglage.</em>';
        root.querySelectorAll('.op-reset-group').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var g = btn.getAttribute('data-group');
                if (!g || !confirm('Réinitialiser le groupe « ' + g + ' » ?')) return;
                fetch(API + '/reset', {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken() },
                    body: JSON.stringify({ group: g })
                }).then(function (r) { return r.json(); }).then(function (d) {
                    if (d && d.success) { load(); showResult('Groupe réinitialisé.', true); }
                    else showResult((d && d.error) || 'Échec', false);
                }).catch(function () { showResult('Erreur réseau', false); });
            });
        });
    }

    function collectChanges() {
        var out = {};
        if (!root) return out;
        root.querySelectorAll('[data-key]').forEach(function (el) {
            var key = el.getAttribute('data-key');
            if (!key) return;
            if (el.type === 'checkbox') out[key] = el.checked;
            else out[key] = el.value;
        });
        return out;
    }

    function load() {
        fetch(API, { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d && d.success && d.data) renderPanel(d.data);
                else if (root) root.innerHTML = '<em>Erreur de chargement.</em>';
            })
            .catch(function () { if (root) root.innerHTML = '<em>Erreur réseau.</em>'; });
    }

    if (saveBtn && CAN_EDIT) {
        saveBtn.addEventListener('click', function () {
            var settings = collectChanges();
            saveBtn.disabled = true;
            fetch(API, {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken() },
                body: JSON.stringify({ settings: settings })
            }).then(function (r) { return r.json(); }).then(function (d) {
                if (d && d.success) {
                    renderPanel(d.data);
                    showResult('Réglages enregistrés.', true);
                } else {
                    showResult((d && d.error) || 'Échec', false);
                }
            }).catch(function () { showResult('Erreur réseau', false); })
              .finally(function () { saveBtn.disabled = false; });
        });
    }

    if (resetBtn && CAN_EDIT) {
        resetBtn.addEventListener('click', function () {
            if (!confirm('Supprimer tous les overrides supervision et revenir au .env ?')) return;
            fetch(API + '/reset', {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken() },
                body: JSON.stringify({})
            }).then(function (r) { return r.json(); }).then(function (d) {
                if (d && d.success) { load(); showResult('Tous les réglages réinitialisés.', true); }
                else showResult((d && d.error) || 'Échec', false);
            }).catch(function () { showResult('Erreur réseau', false); });
        });
    }

    load();
})();
</script>
{% endblock %}

# Environnement et timezone
ENV=prod
APP_TIMEZONE=Europe/Paris
AUTH_METHOD=session
# AUTH_METHOD : session | token | both | none

# Base de données
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS="your_database_password"
API_KEY=your_api_key_here

# Poissonglouton (firmware firmwires/poissonglouton/include/secrets.h → PGL_API_KEY)
# Si vide : fallback sur API_KEY pour POST /pgl/post-data et /pgl/heartbeat.
PGL_API_KEY=your_pgl_api_key_here

# HMAC-SHA256 — authentification moderne pour POST /post-data et /heartbeat
# Utilisée par : FFP5CS (PostDataController, HeartbeatController), N3PP et MSP
# depuis l'audit 2026-05 (LegacyHeartbeatHandler + HmacAuthTrait).
# Si vide : fallback sur API_KEY uniquement (compat firmwares legacy).
# Doit être identique à API_SIG_SECRET dans credentials.h des firmwares.
# FFP5CS v13.80+ signe X-Sig-Timestamp/X-Sig-Nonce/X-Sig-Hmac sur
# <timestamp>\n<nonce>\n<body_brut>. Les champs POST timestamp/signature legacy
# restent acceptes pour compatibilite.
API_SIG_SECRET=your_hmac_secret_here
SIG_VALID_WINDOW=300
# HMAC_STRICT_MODE=true   : refuse l'absence de HMAC (au lieu de fallback API_KEY).
#                           Activer apres migration de TOUS les firmwares vers HMAC.
HMAC_STRICT_MODE=false
# HMAC_NONCE_REQUIRED=true : exige post_id et utilise message HMAC <timestamp>|<post_id>.
#                            Le firmware doit signer avec ce meme format.
HMAC_NONCE_REQUIRED=false

# === Notifications e-mail ===
# Mode de verbosité GLOBAL (repli si non configuré sur la page contrôle de l'appareil)
#   none      = aucun envoi (maintenance / absence)
#   important = P1 critiques + P2 alertes               (recommandé)
#   partial   = + P3 infos (confirmations d'action)
#   full      = + P4 diagnostic (rapports, démarrage, tests = tout)
NOTIF_MODE=important
# Catégories GLOBALES à couper finement (liste séparée par des virgules), parmi :
#   hydraulic, energy, environment, feeding, availability, lifecycle, camera, system
# Surcharge par famille via les pages de contrôle (aquaponie, serre, météo, galeries).
NOTIF_DISABLED_CATEGORIES=
# Destinataire des notifications + expéditeur
NOTIF_EMAIL_RECIPIENT=your_notification_email@example.com
MAIL_FROM="Your Name <your_email@example.com>"
LOG_FILE_PATH=cronlog.txt

# --- Transport e-mail (symfony/mailer) ---
# Si AUCUN paramètre SMTP n'est défini ci-dessous, le serveur retombe automatiquement
# sur la fonction PHP mail() (utile en dev / CI / hébergement mutualisé avec MTA local).
# Option A — DSN complet (prioritaire). Voir https://symfony.com/doc/current/mailer.html
#   smtp://user:pass@smtp.example.com:587
#   smtps://user:pass@smtp.example.com:465   (TLS implicite)
# SMTP_DSN=
# Option B — paramètres séparés (DSN reconstruit automatiquement si SMTP_HOST est défini).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_ENCRYPTION=tls          # tls | ssl | smtps (force smtps://, sinon smtp://)

# Seuils d'alerte CRON (EauAquarium = distance capteur→surface en mm ; eau basse si distance élevée)
AQUA_LOW_LEVEL_THRESHOLD=180
# Réserve basse (EauReserve en mm) : alerte si distance > seuil ; vide ou absent = désactivé (opt-in)
# RESERVE_LOW_LEVEL_THRESHOLD=
TIDE_STDDEV_THRESHOLD=1
# Intervalle entre deux passes de tâches horaires CRON (online, réservoir) — défaut 3600 s
CRON_HOURLY_INTERVAL_SECONDS=3600
# Délai max (s) sans heartbeat avant d'alerter qu'un appareil est silencieux
# (supervision toutes familles : FFP3 / N3PP / MSP1) — défaut 3600 s.
HEARTBEAT_OFFLINE_THRESHOLD_SECONDS=3600

# Numéros GPIO (Raspberry Pi)
GPIO_POMPE_AQUA=16
GPIO_POMPE_TANK=18
GPIO_RESET_MODE=110

# Seuils de nettoyage (valeurs aberrantes)
# Niveaux d'eau (EauAquarium, EauReserve, EauPotager) : valeurs en mm (comme en BDD)
CLEAN_MIN_TEMP_EAU=3
CLEAN_MAX_TEMP_EAU=50
CLEAN_MIN_TEMP_AIR=3
CLEAN_MIN_HUMIDITE=3
CLEAN_MIN_EAU_AQUARIUM=40
CLEAN_MAX_EAU_AQUARIUM=700
CLEAN_MIN_EAU_RESERVE=15
CLEAN_MAX_EAU_RESERVE=1000

# Token admin pour vider le cache (générer un token aléatoire fort)
ADMIN_CACHE_TOKEN=your_secure_random_token_here

# === Authentification admin (pages /dashboard, /supervision, /admin/*) ===
# Generer le hash : php tools/generate_password_hash.php
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD_HASH=$2y$12$generate_with_tools/generate_password_hash.php
# Token alternatif pour API admin (eviter en URL : preferer header X-Admin-Token / cookie)
ADMIN_TOKEN=generate_a_strong_random_token

# === OTA ===
# Si true, requiert X-Api-Key/X-OTA-Key/api_key pour acceder a /ota/*.
# Defaut false pour compat firmwares deployes (l'integrite reste verifiee par MD5 cote firmware).
OTA_REQUIRE_AUTH=false

# === Rate limiting upload galerie (ESP32-CAM) ===
# Intervalle minimum entre deux uploads par IP (secondes). 0 = desactive.
GALLERY_UPLOAD_RATE_LIMIT_SECONDS=10

# === Headers de securite ===
# Forcer HSTS meme si scheme HTTP detecte (utile derriere reverse proxy mutualise).
SECURITY_FORCE_HSTS=true
# Content-Security-Policy : override la valeur par defaut conservatrice (laisse vide pour utiliser le defaut).
# Le defaut autorise :
#  - les iframes Google Sheets (frame-src https://docs.google.com) des analyses chimiques (aquaponie / MSP1) ;
#  - la feuille de style Google Fonts (style-src https://fonts.googleapis.com) et ses polices (font-src https://fonts.gstatic.com).
# Si vous surchargez cette valeur, pensez a conserver `frame-src https://docs.google.com`,
# `style-src ... https://fonts.googleapis.com` et `font-src ... https://fonts.gstatic.com`.
SECURITY_CSP=

# Dossiers upload galeries photo (ESP32-CAM)
GALLERY_MSP1_DIR=uploads/msp1
GALLERY_N3PP_DIR=uploads/n3pp
GALLERY_FFP3_DIR=uploads/ffp3

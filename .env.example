# Environnement et timezone
# ENV (environnement par défaut ; les routes forcent le leur via EnvironmentMiddleware) :
#   prod | test | test3 | s3 | s3test | n3pp_test | msp_test | energie_test
ENV=prod
APP_TIMEZONE=Europe/Paris
AUTH_METHOD=session
# AUTH_METHOD : session | token | both | none

# Base de données
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS="your_database_password"
API_KEY=your_api_key_here

# Poissonglouton (firmware firmwires/poissonglouton/include/secrets.h → PGL_API_KEY)
# Si vide : fallback sur API_KEY pour POST /pgl/post-data et /pgl/heartbeat.
PGL_API_KEY=your_pgl_api_key_here

# Poissonglouton — secret HMAC dédié (optionnel). Si défini, /pgl/post-data et
# /pgl/heartbeat valident la signature HMAC-SHA256 avec ce secret ; sinon repli
# sur API_SIG_SECRET, puis sur api_key legacy si aucun secret n'est configuré.
# Doit être identique à PGL_API_SIG_SECRET côté firmware
# (firmwires/poissonglouton/include/secrets.h). Laisser vide pour rester en
# api_key legacy. Contrat identique à N3PP/MSP (timestamp+signature ou X-Sig-*).
PGL_API_SIG_SECRET=

# HMAC-SHA256 — authentification moderne pour POST /post-data et /heartbeat
# Utilisée par : FFP5CS (PostDataController, HeartbeatController), N3PP et MSP
# depuis l'audit 2026-05 (LegacyHeartbeatHandler + HmacAuthTrait).
# Si vide : fallback sur API_KEY uniquement (compat firmwares legacy).
# Doit être identique au secret partagé côté firmware :
#   - FFP5CS : Secrets::API_SIG_SECRET dans firmwires/ffp5cs/include/secrets_config.h
#     (+ #define SECRETS_INCLUDE_API_SIG_SECRET 1)
#   - n3pp / msp / ESP32-CAM : API_SIG_SECRET dans firmwires/credentials.h
#     (laisser "" pour rester sur api_key legacy)
# FFP5CS v13.80+ signe X-Sig-Timestamp/X-Sig-Nonce/X-Sig-Hmac sur
# <timestamp>\n<nonce>\n<body_brut>. Les champs POST timestamp/signature legacy
# restent acceptes pour compatibilite.
API_SIG_SECRET=your_hmac_secret_here
SIG_VALID_WINDOW=300
# HMAC_STRICT_MODE=true   : refuse l'absence de HMAC (au lieu de fallback API_KEY).
#                           Activer apres migration de TOUS les firmwares vers HMAC.
#                           Bascule aussi depuis /supervision (priorite BDD > .env).
HMAC_STRICT_MODE=false
# HMAC_NONCE_REQUIRED=true : exige post_id et utilise message HMAC <timestamp>|<post_id>.
#                            Le firmware doit signer avec ce meme format.
#                            Bascule aussi depuis /supervision (priorite BDD > .env).
HMAC_NONCE_REQUIRED=false
# Journal audit HMAC (tentatives OK/KO) — activable aussi via /supervision
HMAC_AUDIT_LOG=false

# Galeries CAM (uploadphotosserver) — HMAC X-Sig-* optionnel avec fallback api_key.
# false (défaut) : signature absente ou invalide (horloge hors fenêtre, etc.) → auth clé API.
# true : signature présente mais invalide → 401 (comportement A4 strict).
GALLERY_HMAC_STRICT=false
# La plupart des réglages opérationnels ci-dessous sont aussi pilotables depuis
# /supervision (priorité BDD > .env, sans modifier le fichier .env).
# HMAC_AUDIT_LOG_PATH=var/log/hmac-audit.log

# === Notifications e-mail ===
# Mode de verbosité GLOBAL (repli si non configuré sur la page contrôle de l'appareil)
#   none      = aucun envoi (maintenance / absence)
#   important = P1 critiques + P2 alertes               (recommandé)
#   partial   = + P3 infos (confirmations d'action)
#   full      = + P4 diagnostic (rapports, démarrage, tests = tout)
NOTIF_MODE=important
# Catégories GLOBALES à couper finement (liste séparée par des virgules), parmi :
#   hydraulic, energy, environment, feeding, availability, lifecycle, camera, system
# Surcharge par famille via les pages de contrôle (aquaponie, serre, météo, galeries).
NOTIF_DISABLED_CATEGORIES=
# Destinataire des notifications + expéditeur
NOTIF_EMAIL_RECIPIENT=your_notification_email@example.com
MAIL_FROM="Your Name <your_email@example.com>"
LOG_FILE_PATH=cronlog.txt
# LOG_LEVEL=DEBUG              # DEBUG | INFO | WARNING | ERROR (défaut DEBUG)
# LOG_MASK_IP=true             # Masque les IP dans cronlog (défaut true, RGPD)
# LOG_ROTATE_DAYS=14             # Rotation quotidienne Monolog (0 = désactivé)

# --- Transport e-mail (symfony/mailer) ---
# Si AUCUN paramètre SMTP n'est défini ci-dessous, le serveur retombe automatiquement
# sur la fonction PHP mail() (utile en dev / CI / hébergement mutualisé avec MTA local).
# Option A — DSN complet (prioritaire). Voir https://symfony.com/doc/current/mailer.html
#   smtp://user:pass@smtp.example.com:587
#   smtps://user:pass@smtp.example.com:465   (TLS implicite)
# SMTP_DSN=
# Option B — paramètres séparés (DSN reconstruit automatiquement si SMTP_HOST est défini).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_ENCRYPTION=tls          # tls | ssl | smtps (force smtps://, sinon smtp://)

# Seuils d'alerte CRON (EauAquarium = distance capteur→surface en mm ; eau basse si distance élevée)
AQUA_LOW_LEVEL_THRESHOLD=180
# Réserve basse (EauReserve en mm) : alerte si distance > seuil ; vide ou absent = désactivé (opt-in)
# RESERVE_LOW_LEVEL_THRESHOLD=
TIDE_STDDEV_THRESHOLD=1
# Disjoncteur marées : coupures pompe max sur 24 h glissantes (0 = sans limite)
TIDE_MAX_PUMP_CUTS_PER_DAY=6
# Alerte capteur FFP3 « absent » (mesures consécutives sans EauAquarium) / « figé » (même valeur)
SENSOR_ABSENT_MIN_READINGS=6
SENSOR_FROZEN_MIN_READINGS=12
SENSOR_FROZEN_MIN_SECONDS=7200
# Alertes météo MSP1 (opt-in : vide ou absent = désactivé) — dérivées du POST station météo
# Gel : alerte si TempAirExt < seuil (°C), ré-armement à seuil +2 °C
# MSP_FROST_ALERT_THRESHOLD_C=1
# Canicule : alerte si TempAirExt > seuil (°C), ré-armement à seuil -2 °C
# MSP_HEAT_ALERT_THRESHOLD_C=35
# Pluie : capteur analogique (4095 = sec, plus bas = mouillé) ; alerte si valeur < seuil
# MSP_RAIN_WET_THRESHOLD=3000
# Intervalle entre deux passes de tâches horaires CRON (online, réservoir) — défaut 3600 s
CRON_HOURLY_INTERVAL_SECONDS=3600
# Délai max (s) sans heartbeat avant d'alerter qu'un appareil est silencieux
# (supervision toutes familles : FFP3 / N3PP / MSP1) — défaut 3600 s.
# PLANCHER : le seuil dérivé du temps de veille (FreqWakeUp, facteur nuit) ne peut que
# l'allonger. Et une mesure récente en base interdit l'alerte, quel que soit le heartbeat.
HEARTBEAT_OFFLINE_THRESHOLD_SECONDS=3600

# Numéros GPIO (Raspberry Pi)
GPIO_POMPE_AQUA=16
GPIO_POMPE_TANK=18
GPIO_RESET_MODE=110

# Seuils de nettoyage (valeurs aberrantes)
# Niveaux d'eau (EauAquarium, EauReserve, EauPotager) : valeurs en mm (comme en BDD)
CLEAN_MIN_TEMP_EAU=3
CLEAN_MAX_TEMP_EAU=50
CLEAN_MIN_TEMP_AIR=3
CLEAN_MIN_HUMIDITE=3
CLEAN_MIN_EAU_AQUARIUM=40
CLEAN_MAX_EAU_AQUARIUM=700
CLEAN_MIN_EAU_RESERVE=15
CLEAN_MAX_EAU_RESERVE=1000

# Token admin pour vider le cache (générer un token aléatoire fort)
ADMIN_CACHE_TOKEN=your_secure_random_token_here

# === Authentification admin (pages /dashboard, /supervision, /admin/*) ===
# Generer le hash : php tools/generate_password_hash.php
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD_HASH=$2y$12$generate_with_tools/generate_password_hash.php
# Token alternatif pour API admin (eviter en URL : preferer header X-Admin-Token / cookie)
ADMIN_TOKEN=generate_a_strong_random_token

# === OTA ===
# Si true, requiert X-Api-Key/X-OTA-Key/api_key pour acceder a /ota/*.
# Defaut false pour compat firmwares deployes (l'integrite reste verifiee par MD5 cote firmware).
OTA_REQUIRE_AUTH=false

# === Rate limiting upload galerie (ESP32-CAM) ===
# Intervalle minimum entre deux uploads par IP (secondes). 0 = desactive.
GALLERY_UPLOAD_RATE_LIMIT_SECONDS=10
# Fenêtre « en ligne » pour la sync galerie (secondes, défaut 1500)
# GALLERY_SYNC_ONLINE_WINDOW_SECONDS=1500

# === Normalisation photos galerie (timelapse) — pilotable aussi via Supervision ===
# Copies douces dans uploads/{slug}/.normalized/ (originaux intacts), plus récentes d'abord,
# lissées dans le temps ; photos de nuit laissées telles quelles. Batch borné à ~25 s.
GALLERY_NORMALIZE_ENABLED=true
GALLERY_NORMALIZE_INTERVAL_SECONDS=600
GALLERY_NORMALIZE_MAX_PER_RUN=20
GALLERY_NORMALIZE_STRENGTH=0.35
GALLERY_NORMALIZE_JPEG_QUALITY=90

# === Rate limiting endpoints firmware (optionnel, défaut désactivé) ===
# FIRMWARE_RATE_LIMIT_MAX=0
# FIRMWARE_RATE_LIMIT_WINDOW=60

# === Proxys de confiance (rate limiting) ===
# Liste CSV d'IP ou de plages CIDR (IPv4/IPv6) des reverse-proxys légitimes
# placés devant l'application. L'en-tête X-Forwarded-For n'est pris en compte
# pour identifier l'IP cliente QUE si REMOTE_ADDR figure dans cette liste ;
# sinon X-Forwarded-For est ignoré (il est trivialement falsifiable et
# permettrait de contourner la limitation de débit — cf. S1). Vide par défaut
# (aucun proxy de confiance → on se fie à REMOTE_ADDR).
# Exemple : TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8,::1
TRUSTED_PROXIES=
# Filtrage graphiques FFP3 : exclure fallback DHT 20°C/50% (données conservées en BDD)
# STATS_EXCLUDE_DHT_FALLBACK=false

# === Protection GET état sorties firmware (optionnel) ===
# FIRMWARE_STATE_REQUIRE_KEY=false

# === Config distante n3pp/msp : clés plates (compatibilité flotte déployée) ===
# Les firmwares n3pp/msp lisent la config serveur sous forme de clés PLATES à la racine
# de GET /{module}/api/outputs/state. Avant la v6.25.0 ces clés n'étaient pas envoyées :
# la flotte tournait sur sa config locale. Les renvoyer fait adopter d'un coup la config
# stockée en BDD — risqué sur des modules non reflashables (état pompe miroir réappliqué,
# SeuilPontDiv/veille infinie, FreqWakeUp).
#   off   = clés plates NON envoyées (contrat d'avant v6.25.0) — DÉFAUT, recommandé tant
#           que la flotte n'est pas flashée
#   safe  = clés envoyées mais nettoyées (GPIO d'état miroir retirés, valeurs hors plage
#           omises → le firmware garde sa valeur locale)
#   full  = comportement v6.25.0 (aucun filtrage)
# Voir docs/COMPAT_FLOTTE_DEPLOYEE.md
# FIRMWARE_FLAT_STATE_MODE=off

# === Headers de securite ===
# Forcer HSTS meme si scheme HTTP detecte (utile derriere reverse proxy mutualise).
SECURITY_FORCE_HSTS=true
# Content-Security-Policy : override la valeur par defaut conservatrice (laisse vide pour utiliser le defaut).
# Le defaut autorise :
#  - les iframes Google Sheets (frame-src https://docs.google.com) des analyses chimiques (aquaponie / MSP1) ;
#  - la feuille de style Google Fonts (style-src https://fonts.googleapis.com) et ses polices (font-src https://fonts.gstatic.com).
# Si vous surchargez cette valeur, pensez a conserver `frame-src https://docs.google.com`,
# `style-src ... https://fonts.googleapis.com` et `font-src ... https://fonts.gstatic.com`.
SECURITY_CSP=

# Dossiers upload galeries photo (ESP32-CAM)
GALLERY_MSP1_DIR=uploads/msp1
GALLERY_N3PP_DIR=uploads/n3pp
GALLERY_FFP3_DIR=uploads/ffp3

# === Connecteur MCP (Claude) + serveur OAuth embarqué — docs/MCP.md ===
# ⚠️ Le .htaccess transmet désormais `Authorization` à PHP : `Authorization: Bearer <ADMIN_TOKEN>`
# devient opérant sur tout le site → ADMIN_TOKEN fort (32 octets aléatoires) ou vide.
# Désactivé par défaut : aucune route /mcp, /oauth/*, /.well-known/oauth-* n'est servie.
# Prérequis : jouer migrations/2026_11_mcp_oauth.sql.
MCP_ENABLED=false
# URL publique EXACTE du serveur, sans slash final (la ressource OAuth sera <base>/mcp).
MCP_PUBLIC_BASE_URL=https://iot.olution.info
# Durées de vie (secondes) : jeton d'accès (1 h), refresh (30 j), code d'autorisation (60 s).
MCP_ACCESS_TOKEN_TTL=3600
MCP_REFRESH_TOKEN_TTL=2592000
MCP_AUTH_CODE_TTL=60
# Environnements LISIBLES par les outils (s3 = production aquamobile).
MCP_ALLOWED_ENVS=prod,s3
# Pilotage (iot_plan_output_change / iot_apply_plan) : désactivé par défaut, réservé aux
# comptes operator/admin. Les cibles sont des couples famille:env, JUGÉS SUR LA TABLE
# RÉELLEMENT ÉCRITE : le défaut ne contient que des tables de test
# (ffp3Outputs2/3/S3Test, n3ppOutputsTest, msp1OutputsTest). Attention : ffp3:n3pp_test
# écrirait dans ffp3Outputs (PRODUCTION) — il serait refusé même listé.
MCP_CONTROL_ENABLED=false
MCP_CONTROL_ALLOWED_TARGETS=ffp3:test,ffp3:test3,ffp3:s3test,n3pp:n3pp_test,msp1:msp_test
# ⛔ DANGER : autorise une cible listée qui vise une table de PRODUCTION (installation réelle,
# êtres vivants). Ne lève AUCUN garde-fou biologique. Laisser à false (docs/MCP_PILOTAGE.md).
MCP_CONTROL_ALLOW_PRODUCTION=false
# true (défaut) = seul plan→apply ; false = iot_set_output direct (admin).
MCP_CONTROL_REQUIRE_PLAN=true
# true (défaut) = garde-fous biologiques actifs (pompe, chauffage, nourrissage).
MCP_CONTROL_BIO_SAFEGUARDS=true
MCP_CONTROL_HEATING_MIN=18
MCP_CONTROL_HEATING_MAX=28
# Durée max (min) d'arrêt pompe avec rétablissement auto (0 = interdit).
MCP_CONTROL_PUMP_STOP_MAX_MINUTES=0
# Reset distant, OTA, suppression photos (admin + confirmation par code).
MCP_DEVICE_ACTIONS_ENABLED=false
# SQL libre admin (iot_sql) ; DDL/GRANT séparément.
MCP_SQL_ENABLED=false
MCP_SQL_DDL_ENABLED=false
MCP_SQL_MAX_AFFECTED_ROWS=100
MCP_SQL_MAX_STATEMENT_SECONDS=10
MCP_SQL_MAX_ROWS=200
# Admin voit noms/e-mails (jamais les secrets).
MCP_PRIVACY_BYPASS=false
# Catégories dispensées de code (CSV) ou `all` ; `unlock` jamais dispensable.
MCP_CONFIRM_SKIP=
# Fenêtre de déverrouillage après iot_confirm_unlock (0 = désactivé).
MCP_CONFIRM_UNLOCK_MINUTES=0
# Nourrissages manuels MCP autorisés par 24 h et par environnement (0 à 6).
MCP_FEED_DAILY_MAX=2
# Redirections OAuth supplémentaires exactes (CSV), ex. MCP Inspector.
# Déjà intégrés : Claude, Cursor (web + legacy cursor://), ChatGPT, Gemini Enterprise,
# loopback http://localhost|127.0.0.1/… (port libre, Cursor :8787 inclus).
MCP_EXTRA_REDIRECT_URIS=
# Origines navigateur supplémentaires (CSV). Déjà : Claude, ChatGPT, Cursor, base publique.
MCP_ALLOWED_ORIGINS=
# Hôtes CIMD. Défaut Claude + ChatGPT + Cursor. `*` = tout hôte public (DÉCONSEILLÉ).
MCP_CIMD_ALLOWED_HOSTS=claude.ai,claude.com,chatgpt.com,cursor.com,www.cursor.com
# Client confidentiel statique (Gemini Enterprise). Les deux doivent être renseignés.
# MCP_OAUTH_CONFIDENTIAL_CLIENT_ID=gemini-n3-iot
# MCP_OAUTH_CONFIDENTIAL_CLIENT_SECRET=
# Enregistrement dynamique de clients (RFC 7591) — clients publics uniquement.
MCP_DCR_ENABLED=true
# Secret de la clé HMAC liant les jetons MCP au mot de passe (credential_epoch). Vide =
# API_SIG_SECRET ; les deux vides = clé fixe de repli (avertissement journalisé).
# ⚠️ Le changer révoque TOUTES les connexions MCP (reconnexion depuis Claude). Générer :
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
MCP_CREDENTIAL_SECRET=
# Limitation de débit de POST /mcp par IP.
MCP_RATE_LIMIT_MAX=300
MCP_RATE_LIMIT_WINDOW=60
# Optionnel (recommandé) : utilisateur SQL n'ayant QUE le privilège SELECT, utilisé par les
# outils de lecture (défense en profondeur). Vide = connexion principale (toujours en
# transaction READ ONLY annulée).
DB_MCP_USER=
DB_MCP_PASS=

# --- Exploitation du connecteur (docs/MCP.md §§ 8-11) ---
# Mémoire (iot_remember / iot_recall / iot_forget) : note « à revérifier » au-delà de N jours.
MCP_MEMORY_STALE_DAYS=90
MCP_MEMORY_MAX_CHARS=2000
MCP_MEMORY_MAX_NOTES=500
# GET /health/report.json : jeton de l'en-tête X-Health-Token. Vide = endpoint 404.
# Indépendant de MCP_ENABLED. Distinct de tout autre secret ; c'est aussi le secret de dépôt
# IOT_HEALTH_TOKEN du workflow .github/workflows/health-check.yml.
MCP_HEALTH_TOKEN=
# Rapport de santé régulier par le CRON (stocké dans mcp_health_reports).
MCP_HEALTH_REPORT_ENABLED=false
MCP_HEALTH_REPORT_INTERVAL_SECONDS=86400
# Heure locale du rapport quotidien (vide = dès que l'intervalle est écoulé).
MCP_HEALTH_REPORT_HOUR=7
# alert = e-mail si orange/rouge (défaut) | daily = chaque rapport | never
MCP_HEALTH_REPORT_EMAIL=alert
MCP_HEALTH_REPORT_RETENTION_DAYS=90
# Hôte dont le certificat TLS est surveillé (défaut : hôte de MCP_PUBLIC_BASE_URL).
MCP_HEALTH_TLS_HOST=
# Racines lisibles par iot_list_files / iot_read_file / iot_grep_files (admin, lecture seule).
# Vide = défauts (journaux, var/, journal d'erreurs PHP, config/, docs/, migrations/, .htaccess,
# run-cron.php). Ex. : defaults,erreurs=/home4/oliviera/logs
MCP_FILE_ROOTS=
MCP_FILE_MAX_BYTES=65536
